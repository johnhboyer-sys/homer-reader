{"za/kunqos": [{"key": "za/kunqos", "head": "Ζάκυνθος", "i": "(ὑλήεις, ὑλήεσσα ).", "rows": [{"lv": 1, "n": "", "z": "The mod. Zante. An island forming part of the realm of Odysseus", "au": ["Il. 2.634"]}, {"lv": 1, "n": "", "z": "In Od. associated with Doulichium, Same and Ithaca", "au": ["Od. 1.246", "Od. 9.24", "Od. 16.123", "Od. 16.250", "Od. 19.131"]}]}], "zeu/s": [{"key": "zeu/s", "head": "Ζεύς", "i": "", "rows": [{"lv": 1, "n": "", "z": "Genit.", "ex": [{"g": "Ζηνός", "c": "408"}], "au": ["Il. 11.795", "Il. 12.235", "Il. 13.449", "etc. :", "Od. 1.27", "Od. 2.68", "Od. 4.74", "etc."]}, {"lv": 1, "n": "", "z": "Dat.", "ex": [{"g": "Ζηνί", "c": "Od. 4.49"}], "au": ["Il. 4.1", "Il. 7.443", "etc.:", "Od. 4.78", "Od. 9.552"]}, {"lv": 1, "n": "", "z": "Acc.", "ex": [{"g": "Ζῆνα", "c": "Od. 9.756"}, {"g": "Ζῆν", "c": "Od. 24.206"}], "au": ["Il. 8.22", "Il. 14.157", "etc.:", "Od. 20.339", "Od. 24.472", "Il. 14.265", "Il. 24.331"]}, {"lv": 1, "n": "", "z": "Voc.", "ex": [{"g": "Ζεῦ", "c": "Il. 24.503"}], "au": ["Il. 2.371", "Il. 3.298", "Il. 5.421", "etc.:", "Od. 1.62", "Od. 4.341", "Od. 5.7", "Od. 7.331", "etc."]}, {"lv": 1, "n": "", "z": "Genit.", "ex": [{"g": "Διός", "c": "Od. 7.5"}], "au": ["Il. 2.26", "Il. 3.107", "Il. 4.128", "etc.:", "Od. 1.10", "Od. 2.296", "Od. 3.42", "Od. 4.27", "etc."]}, {"lv": 1, "n": "", "z": "Dat.", "ex": [{"g": "Διί", "c": "Od. 4.419"}], "au": ["Il. 2.102", "Il. 3.104", "Il. 4.23", "etc.:", "Od. 4.472", "Od. 7.164", "Od. 8.432", "etc."]}, {"lv": 1, "n": "", "z": "Acc.", "ex": [{"g": "Δία", "c": "Od. 8.394"}, {"g": "Διόθεν [&amp;gt;-θεν], from Zeus", "c": "Il. 24.194"}], "au": ["Il. 2.2", "Il. 5.419", "etc. :", "Od. 14.389", "Od. 14.406", "Od. 20.75", "Il. 24.561"]}, {"lv": 1, "n": "", "z": "By his power or will", "au": ["Il. 15.489"]}, {"lv": 1, "n": "", "z": "(ἀθάνατος, αἰγίοχος , ἄναξ, ἀργικέραυνος , ἄριστος, ἀστεροπητής , ἐριβρεμέτης, ἐρίγδουπος , ἐρισθενής, εὐρύοπα , Ἰδαῖος, ἱκετήσιος , καταχθόνιος, κελαινεφής , κρείων, κύδιστος , μέγας, μέγιστος, Ἴδηθεν (Δωδώνης) μεδέων, μητίετα, αἰθέρι ( τηλόθι) ναίων, νεφεληγερέτα, ξείνιος, ξένιος, Ὀλύμπιος, πανομφαῖος, πατήρ, π. ἀνδρῶν τε θεῶν τε , στεροπηγερέτα, τελεσφόρος , τερπικέραυνος, ὕπατος , ὕ. κρειόντων, ὑπερμενής , ὑψιβρεμέτης, ὑψίζυγος , ὑψόθ&#x27; ἐών.) Patronymic Κρονίδης, Κρονίων. The supreme god, son of Cronus and Rhea, brother of Poseidon, Hades, Hera and Demeter, and husband (and brother) of Hera. Father (1) by Hera of Ares, Hebe and Hephaestus; (2) by Leto of Apollo and Artemis; (3) by Dione of Aphrodite; (4) by Semele of Dionysus; (5) by Maia of Hermes; (6) by Demeter of Persephoneia; (7) by Europa (daughter of Phoenix-2) of Minos and Rhadamanthys; (8) by Leda of Helen; (9) by Alcmene of Heracles; (10) by Laodameia of Sarpedon; (11) by Danae of Perseus-1; (12) by Antiope of Amphion-2 and Zethus; (13) by Dia of Peirithous; and (14) by unnamed mothers of Athene , Dardanus-1, Aeacus and Tantalus. Father also of Ate", "au": ["Il. 19.91"]}, {"lv": 1, "n": "", "z": "of the river Xanthus-1", "au": ["Il. 14.434"]}, {"lv": 1, "n": "", "z": "of the Muses", "au": ["Il. 2.491", "Il. 2.598", "Od. 8.488"]}, {"lv": 1, "n": "", "z": "of nymphs", "au": ["Il. 6.420", "Od. 6.105", "Od. 9.154", "Od. 13.356", "Od. 17.240"]}, {"lv": 1, "n": "", "z": "of", "ex": [{"g": "Λιταί", "c": "Od. 17.502"}]}, {"lv": 1, "n": "", "z": "Protector of heralds. See under κῆρυξ in Lex. And of strangers, beggars and suppliants", "au": ["Od. 6.207", "Od. 9.270", "etc."]}, {"lv": 1, "n": "", "z": "See also <a class=\"cunliffe-xref\" href=\"#\" data-key=\"cei/nios\">ξείνιος</a> 1, ξένιος 2 in Lex. His scales. See <a class=\"cunliffe-xref\" href=\"#\" data-key=\"ta/lanton\">τάλαντον</a> 1 in Lex. His thunderbolts", "au": ["Il. 8.133", "Il. 21.198", "etc.:", "Od. 5.128", "Od. 12.415", "etc."]}, {"lv": 1, "n": "", "z": "Sender of rain", "au": ["Il. 12.25", "etc.:", "Od. 9.111", "etc."]}, {"lv": 1, "n": "", "z": "Of snow", "au": ["Il. 10.5", "Il. 12.279", "Il. 19.357"]}, {"lv": 1, "n": "", "z": "Of winds", "au": ["Il. 12.252", "Il. 13.795", "etc. :", "Od. 9.67", "Od. 15.297", "etc."]}, {"lv": 1, "n": "", "z": "And of the rainbow", "au": ["Il. 11.27", "Il. 17.547"]}, {"lv": 1, "n": "", "z": "By lot (<a class=\"cunliffe-cite\" href=\"#\" data-work=\"iliad\" data-book=\"15\" data-line=\"187\">Il. 15.187</a>, 192) got the heavens and the upper air as his realm (but he is called καταχθόνιος 457). The attempt of Hera, Athene and Poseidon to put him in bonds", "au": ["Il. 1.399"]}, {"lv": 1, "n": "", "z": "Thetis goes to him on behalf of Achilles", "au": ["Il. 1.493"]}, {"lv": 1, "n": "", "z": "his promise to her", "au": ["Il. 1.518"]}, {"lv": 1, "n": "", "z": "sends Oneirus to beguile Agamemnon", "au": ["Il. 2.8"]}, {"lv": 1, "n": "", "z": "sends Athene to induce the Trojans to break the truce", "au": ["Il. 4.70"]}, {"lv": 1, "n": "", "z": "with threats forbids the assembled gods to help either side", "au": ["Il. 8.1"]}, {"lv": 1, "n": "", "z": "sends a thunderbolt which falls before the chariot of Diomedes", "au": ["Il. 8.133"]}, {"lv": 1, "n": "", "z": "sends an omen to comfort Agamemnon", "au": ["Il. 8.247"]}, {"lv": 1, "n": "", "z": "sends Iris to turn back Hera and Athene", "au": ["Il. 8.399"]}, {"lv": 1, "n": "", "z": "sends Eris to encourage the Greeks", "au": ["Il. 11.3"]}, {"lv": 1, "n": "", "z": "sends Iris to Hector with advice", "au": ["Il. 11.185"]}, {"lv": 1, "n": "", "z": "beguiled and lulled to sleep by Hera", "au": ["Il. 14.292"]}, {"lv": 1, "n": "", "z": "his rage when he awakes", "au": ["Il. 15.4"]}, {"lv": 1, "n": "", "z": "summons Iris and Apollo", "au": ["Il. 15.54"]}, {"lv": 1, "n": "", "z": "sends her to bid Poseidon retire from the fight", "au": ["Il. 15.158"]}, {"lv": 1, "n": "", "z": "him to aid Hector", "au": ["Il. 15.221"]}, {"lv": 1, "n": "", "z": "debates with himself as to Sarpedon&#x27;s fate", "au": ["Il. 16.433"]}, {"lv": 1, "n": "", "z": "resolves on his death", "au": ["Il. 16.458"]}, {"lv": 1, "n": "", "z": "charges Apollo with his funeral rites", "au": ["Il. 16.667"]}, {"lv": 1, "n": "", "z": "Hera tricked him in the matter of the birth of Heracles", "au": ["Il. 19.95"]}, {"lv": 1, "n": "", "z": "his rage thereat", "au": ["Il. 19.125"]}, {"lv": 1, "n": "", "z": "sends Athene to comfort Achilles", "au": ["Il. 19.342"]}, {"lv": 1, "n": "", "z": "summons an assembly of the gods", "au": ["Il. 20.4"]}, {"lv": 1, "n": "", "z": "allows the gods to take sides in the fight", "au": ["Il. 20.20"]}, {"lv": 1, "n": "", "z": "pities Hector&#x27;s plight", "au": ["Il. 22.168"]}, {"lv": 1, "n": "", "z": "but allows Athene to go to the assistance of Achilles", "au": ["Il. 22.183"]}, {"lv": 1, "n": "", "z": "sends Thetis to Achilles to induce him to give up Hector&#x27;s corpse", "au": ["Il. 24.104"]}, {"lv": 1, "n": "", "z": "Iris to Priam to bid him go to the ships and ransom the corpse", "au": ["Il. 24.144"]}, {"lv": 1, "n": "", "z": "sends Hermes to aid", "au": ["Il. 17.334", "etc. :"]}, {"lv": 1, "n": "", "z": "speaks of Aegisthus to the assembled gods", "au": ["Od. 1.31"]}, {"lv": 1, "n": "", "z": "sends an eagle as a good omen to Telemachus", "au": ["Od. 2.146"]}, {"lv": 1, "n": "", "z": "sends Hermes to bid Calypso let Odysseus go", "au": ["Od. 5.29", "Od. 7.261"]}, {"lv": 1, "n": "", "z": "thunders as a good sign to Odysseus", "au": ["Od. 20.103"]}, {"lv": 1, "n": "", "z": "gives his voice for peace between Odysseus and his people", "au": ["Od. 24.478"]}, {"lv": 1, "n": "", "z": "sends a thunderbolt to stop the fighting", "au": ["Od. 24.539", "etc."]}]}], "zah/s": [{"key": "zah/s", "head": "ζαής", "i": "[ζα- + ἠ-, ἄημι.]", "rows": [{"lv": 1, "n": "", "z": "Acc.", "ex": [{"g": "ζαῆν", "c": "Od. 12.313"}]}, {"lv": 1, "n": "", "z": "Blowing strongly, furious, blustering", "au": ["Il. 12.157", "Od. 5.368", "Od. 12.313"]}]}], "zugo/n": [{"key": "zugo/n", "head": "ζυγόν", "i": "-οῦ, τό [cf. L. jugum, Eng. yoke.] Ablative ζυγόφι(ν) <a class=\"cunliffe-cite\" href=\"#\" data-work=\"iliad\" da