 [{"g": "ῥυτῆρα βιοῦ καὶ ὀϊστῶν", "c": "Od. 21.173"}], "au": ["Od. 18.262"]}, {"lv": 1, "n": "2", "z": "In pl., the reins of a chariot : [ἵπποι] ἐν ῥυτῆρσι τάνυσθεν (pulled in the governance of, pulled at, the reins)", "au": ["Il. 16.475"]}]}, {"key": "r(uth/r", "head": "ῥυτήρ2", "i": "-ῆρος, ὁ [ῥύομαι, ἐρύω2.]", "rows": [{"lv": 1, "n": "", "z": "A keeper or guard", "ex": [{"g": "σταθμῶν ῥυτῆρα", "c": "Od. 17.187"}], "au": ["Od. 17.223"]}]}], "r(usta/zw": [{"key": "r(usta/zw", "head": "ῥυστάζω", "i": "[frequentative fr. ἐ-ρύω1.]", "rows": [{"lv": 1, "n": "", "z": "3 sing. pa."}, {"lv": 1, "n": "", "z": "iterative", "ex": [{"g": "ῥυστάζεσκε", "c": "Il. 24.755"}]}, {"lv": 1, "n": "", "z": "To drag, haul", "au": ["Il. 24.755"]}, {"lv": 1, "n": "", "z": "To haul or pull about, maltreat", "ex": [{"g": "δμῳάς", "c": "Od. 16.109"}], "au": ["Od. 20.319"]}]}], "r(ino/s": [{"key": "r(ino/s", "head": "ῥινός", "i": "-οῦ, ἡ, also ῥινόν, τό <a class=\"cunliffe-cite\" href=\"#\" data-work=\"iliad\" data-book=\"10\" data-line=\"155\">Il. 10.155</a> : <a class=\"cunliffe-cite\" href=\"#\" data-work=\"odyssey\" data-book=\"5\" data-line=\"281\">Od. 5.281</a> (ϝρινός, ϝρινόν).", "rows": [{"lv": 1, "n": "1", "z": "The stripped-off skin of a beast, a hide", "ex": [{"g": "ἕρπον ῥινοί", "c": "Od. 12.395"}], "au": ["Il. 7.474"]}, {"lv": 1, "n": "2", "z": "A prepared hide. Used for sleeping or sitting upon", "ex": [{"g": "ὑπὸ δʼ ἔστρωτο ῥινὸν βοός", "c": "Il. 10.155"}, {"g": "ἥμενοι ἐν ῥινοῖσι βοῶν", "c": "Od. 1.108"}]}, {"lv": 1, "n": "", "z": "For wearing", "ex": [{"g": "ἕσσατο ῥινὸν λύκοιο", "c": "Il. 10.334"}]}, {"lv": 1, "n": "3", "z": "A layer of leather forming part of a shield", "au": ["Il. 7.248", "Il. 13.406", "Il. 13.804"]}, {"lv": 1, "n": "4", "z": "Leather", "ex": [{"g": "κυνέην ῥινοῦ", "c": "Il. 10.262"}, {"g": "δοῦπος . . .ῥινοῦ τε βοῶν τε", "c": "Il. 16.636", "e": "of leather and the shields thereof, i.e. of the leather shields"}], "au": ["Il. 20.276", "Od. 12.423"]}, {"lv": 1, "n": "5", "z": "A shield", "ex": [{"g": "σύν ῥʼ ἔβαλον ῥινούς", "c": "Il. 4.447"}, {"g": "ῥινοῖσι βοῶν φράξαντες ἐπάλξεις", "c": "Il. 12.263", "e": "of ox-leather"}], "au": ["Il. 8.61", "Il. 5.308", "Od. 5.281"]}, {"lv": 1, "n": "6", "z": "The skin of a man", "ex": [{"g": "περὶ ῥινοὶ μινύθουσιν", "c": "Od. 12.46", "e": "their skins"}], "au": ["Od. 14.134", "Od. 22.278"]}, {"lv": 1, "n": "", "z": "So in pl.", "ex": [{"g": "ἔνθα κʼ ἀπὸ ῥινοὺς δρύφθη", "c": "Od. 5.426", "e": "would have had his skin stripped off"}], "au": ["Od. 5.435"]}]}], "r(i/s": [{"key": "r(i/s", "head": "ῥίς", "i": "ῥινός, ἡ (an initial consonant app. lost).", "rows": [{"lv": 1, "n": "1", "z": "The nose", "ex": [{"g": "ἀμβροσίνη ὑπὸ ῥῖνα θῆκεν", "c": "Od. 4.445"}], "au": ["Il. 5.291", "Il. 13.616", "Od. 18.86"]}, {"lv": 1, "n": "2", "z": "So in pl., the nose (as containing the two nostrils)", "ex": [{"g": "ἀπʼ οὔατα ῥῖνάς τʼ ἀμήσαντες", "c": "Od. 21.301"}], "au": ["Il. 14.467", "Il. 16.503", "Il. 23.395", "Od. 22.475"]}, {"lv": 1, "n": "", "z": "With special reference to the nostrils", "ex": [{"g": "αἷμʼ ἀνὰ στόμα καὶ κατὰ ῥῖνας πρῆσεν", "c": "Il. 16.349"}], "au": ["Il. 19.39", "Il. 23.777", "Od. 5.456", "Od. 22.18", "Od. 24.318"]}]}], "r(oh/": [{"key": "r(oh/", "head": "ῥοή", "i": "-ῆς, ἡ [ῥέω.]", "rows": [{"lv": 1, "n": "", "z": "In pl., the streams or waters (of a river)", "ex": [{"g": "μαιάνδρου ῥοάς", "c": "Il. 2.869"}], "au": ["Il. 3.5", "Il. 4.91", "Il. 5.774", "Il. 6.4", "Il. 8.560", "Il. 11.732", "Il. 16.669", "Il. 16.679", "Il. 16.719", "Il. 18.240", "Il. 19.1", "Od. 6.216", "Od. 9.450", "Od. 10.529", "Od. 22.197", "Od. 24.11"]}, {"lv": 1, "n": "", "z": "Of a stream of water poured over something", "ex": [{"g": "ἔνιψʼ ὕδατος ῥοῇσιν", "c": "Il. 16.229"}]}]}], "r(ige/w": [{"key": "r(ige/w", "head": "ῥιγέω", "i": "(ϝριγέω). [ῥῖγος.]", "rows": [{"lv": 1, "n": "1", "z": "To be physically affected by fear as if by cold, shudder with fear, dread or apprehension", "ex": [{"g": "ῥίγησεν Ἀγαμέμνων", "c": "Il. 4.148"}], "au": ["Il. 4.150", "Il. 4.279", "Il. 5.596", "Il. 11.345", "Il. 11.254", "Il. 12.208", "Il. 12.331", "Il. 15.34", "Il. 15.436", "Il. 15.466", "Il. 16.119"]}, {"lv": 1, "n": "", "z": "Sim.", "ex": [{"g": "αἰεί μοι θυμὸς ἐρρίγει μὴ . . .", "c": "Od. 23.216", "e": "was in constant terror lest . . ."}]}, {"lv": 1, "n": "2", "z": "To shudder at, dread, shrink from", "ex": [{"g": "πόλεμον", "c": "Il. 5.351"}, {"g": "οὐκ ἔρριγα μάχην", "c": "Il. 17.175", "e": "it is not my wont to shrink from the fight"}]}, {"lv": 1, "n": "3", "z": "To shrink from doing something. With infin.", "ex": [{"g": "ὄφρα τις ἐρρίγῃσι ξεινοδόκον κακὰ ῥέξαι", "c": "Il. 3.353"}, {"g": "τούτῳ ἔρριγʼ ἀντιβολῆσαι", "c": "Il. 7.114", "e": "does not care to meet him"}]}, {"lv": 1, "n": "4", "z": "To be physically affected by a sudden summons or announcement, be fluttered or thrown into agitation", "ex": [{"g": "ὣς φάτο, ῥίγησεν δʼ ὁ γέρων", "c": "Il. 3.259"}], "au": ["Od. 5.116", "Od. 5.171"]}], "f": [["3 sing. aor.", "ἐρρίγησε"], ["", "ῥίγησε"], ["3 pl.", "ἐρρίγησαν"], ["", "Pf. ἔρριγα"], ["3 sing.", "ἔρριγε"], ["3 sing. subj.", "ἐρρίγῃσι"], ["3 sing. plupf.", "ἐρρίγει"], ["", "(ἀπορριγέω)"]], "au": ["Il. 15.466", "Il. 3.259", "Il. 4.148", "Il. 11.254", "Il. 15.34", "436", "Il. 16.119", "etc", "Od. 5.116", "171", "Il. 12.208", "Il. 17.175", "Il. 7.114", "Il. 3.353", "Od. 23.216"]}], "r(iph/": [{"key": "r(iph/", "head": "ῥιπή", "i": "-ῆς, ἡ [ῥίπτω.]", "rows": [{"lv": 1, "n": "1", "z": "The rush or rapid or impetuous flight of a missile", "ex": [{"g": "λᾶος ὑπὸ ῥιπῆς", "c": "Il. 12.462"}], "au": ["Od. 8.192"]}, {"lv": 1, "n": "", "z": "The range or carry of a missile", "ex": [{"g": "ὅσση αἰγανέης ῥ. τέτυκται", "c": "Il. 16.589"}]}, {"lv": 1, "n": "2", "z": "The rush of wind", "au": ["Il. 15.171", "Il. 19.358"]}, {"lv": 1, "n": "", "z": "Of fire", "au": ["Il. 21.12"]}, {"lv": 1, "n": "3", "z": "The rush or furious onset of a warrior", "ex": [{"g": "οἵ κʼ ὄλωνται ἀνδρὸς ἑνὸς ῥιπῇ", "c": "Il. 8.355"}]}]}], "r(izo/w": [{"key": "r(izo/w", "head": "†ῥιζόω", "i": "[ῥίζα.]", "rows": [{"lv": 1, "n": "", "z": "3 sing. aor.", "ex": [{"g": "ἐρρίζωσε", "c": "Od. 13.163"}]}, {"lv": 1, "n": "", "z": "3 sing. pf. pass.", "ex": [{"g": "ἐρρίζωται", "c": "Od. 7.122"}]}, {"lv": 1, "n": "", "z": "To furnish with roots", "ex": [{"g": "ἔνθα οἱ ἀλωὴ ἐρρίζωται", "c": "Od. 7.122", "e": "there grows his vineyard with its trees"}]}, {"lv": 1, "n": "", "z": "Fig.", "ex": [{"g": "νῆʼ ἐρρίζωσεν ἔνερθεν", "c": "Od. 13.163", "e": "fixed immovably"}]}]}], "r(igedano/s": [{"key": "r(igedano/s", "head": "ῥιγεδανός", "i": "-ή [ῥῖγος.]", "rows": [{"lv": 1, "n": "", "z": "Horrible, a thing to shudder at", "ex": [{"g": "Ἑλένης", "c": "Il. 19.325"}]}]}], "r(hto/s": [{"key": "r(hto/s", "head": "ῥητός", "i": "[ῥη-, εἴρω2.]", "rows": [{"lv": 1, "n": "", "z": "Stated, specified, agreed upon", "ex": [{"g": "μισθῷ ἔπι ῥητῷ", "c": "Il. 21.445"}]}]}], "r(oi=zos": [{"key": "r(oi=zos", "head": "ῥοῖζος", "i": "-ου, ἡ.", "rows": [{"lv": 1, "n": "", "z": "Whistling", "ex": [{"g": "πολλῇ ῥοίζῳ πρὸς ὄρος τρέπε μῆλα", "c": "Od. 9.315"}]}, {"lv": 1, "n": "", "z": "The whizzing of missiles in flight", "ex": [{"g": "ὀϊστῶν ῥοῖζον", "c": "Il. 16.361"}]}]}], "r(a/bdos": [{"key": "r(a/bdos", "head": "ῥάβδος", "i": "-ου, ἡ (an initial consonant app. lost).", "rows": [{"lv": 1, "n": "1", "z": "A rod or wand. a A fishing-rod", "au": ["Od. 12.251"]}, {"lv": 2, "n": "b", "z": "A magic wand. Of that of Hermes", "au": ["Il. 24.343", "Od. 5.47", "Od. 24.2"]}, {"lv": 1, "n": "", "z": "Of that of Circe", "au": ["Od. 10.238", "Od. 10.293", "Od. 10.319", "Od. 10.389"]}, {"lv": 1, "n": "", "z": "Such a wand used by Athene in effecting transformations of Odysseus", "au": ["Od. 13.429", "Od. 16.172", "Od. 16.456"]}, {"lv": 1, "n": "2", "z": "App. to be taken as= ῥαφή", "ex": [{"g": "βοείας ῥάψε χρυσείῃς ῥάβδοισιν", "c": "Il. 12.297", "e": "i.e. with wire"}]}]}], "r(hkto/s": [{"key": "r(hkto/s", "head": "ῥηκτός", "i": "[ῥηκ-, ῥήγνυμι.]", "rows": [{"lv": 1, "n": "", "z": "That may be rent or torn : ἀνδρί, ὃς χαλκῷ ῥηκτὸς [εἴη]", "au": ["Il. 13.323"]}]}], "r(inoto/ros": [{"key": "r(inoto/ros", "head": "ῥινοτόρος", "i": "[ῥινός + τορέω.]", "rows": [{"lv": 1, "n": "", "z": "Piercer of shields. Epithet of Ares", "au": ["Il. 21.392"]}]}], "r(hch/nwr": [{"key": "r(hch/nwr", "head": "ῥηξήνωρ", "i": "-ορος [ῥηξ-, ῥήγνυμι + ἀνήρ.]", "rows": [{"lv": 1, "n": "", "z": "That breaks the ranks of the foe (cf. ῥήγνυμι 5). Epithet of Achilles", "au": ["Il. 7.228", "Il. 13.324", "Il. 16.146", "Il. 16.575", "Od. 4.5"]}]}, {"key": "r(hch/nwr", "head": "Ῥηξήνωρ", "i": "(ἀντίθεος).", "rows": [{"lv": 1, "n": "", "z": "Son of Nausithous, brother of Alcinous, and father of Arete. No male heir", "au": ["Od. 7.63", "Od. 7.146"]}]}], "r(wxmo/s": [{"key": "r(wxmo/s", "head": "ῥωχμός", "i": "ὁ [ῥήγνυμι.]", "rows": [{"lv": 1, "n": "", "z": "A break or sudden dip (in the ground)", "ex": [{"g": "ῥωχμὸς ἔην γαίης", "c": "Il. 23.420"}]}]}], "r(ei=a": [{"key": "r(ei=a", "head": "ῥεῖα", "i": "ῥέα (ϝρέα, ϝρεῖα) (ῥέα in Iliad only. A monosyllable in <a class=\"cunliffe-cite\" href=\"#\" data-work=\"iliad\" data-book=\"12\" data-line=\"381\">Il. 12.381</a>, <a class=\"cunliffe-cite\" href=\"#\" data-work=\"iliad\" data-book=\"13\" data-line=\"144\">Il. 13.144</a>, <a class=\"cunliffe-cite\" href=\"#\" data-work=\"iliad\" data-book=\"17\" data-line=\"461\">Il. 17.461</a>, <a class=\"cunliffe-cite\" href=\"#\" data-work=\"iliad\" data-book=\"20\" data-line=\"101\">Il. 20.101</a>, 263).", "rows": [{"lv": 1, "n": "1", "z": "Easily, with ease, without effort or difficulty, readily", "ex": [{"g": "ῥέα πάλλεν", "c": "Il. 5.304"}, {"g": "ὅπως ἵπποι ῥεῖα διέλθοιεν", "c": "Il. 10.492", "e": "without giving the driver trouble, without shying"}], "au": ["Il. 2.475", "Il. 3.381", "Il. 8.179", "Il. 11.802", "Il. 12.381", "Il. 13.90"]}, {"lv": 1, "n": "", "z": "(with effortless stride),", "au": ["Il. 13.144"]}, {"lv": 1, "n": "", "z