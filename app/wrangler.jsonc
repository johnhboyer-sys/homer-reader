{
  // The site as a Cloudflare Worker serving the built files as static assets,
  // the way greek-plays runs greekdrama.johnhboyer.com and aristotle-reader
  // runs aristotle.johnhboyer.com (Cloudflare now runs Pages as Workers static
  // assets). No Worker script. The corpus data is not here: it lives in the R2
  // bucket `homer-reader-data`, and the build bakes its address in through
  // PUBLIC_DATA_ROOT; the post-build step writes dist/.assetsignore so
  // dist/data stays out of the upload. Recipe and cutover: docs/cloudflare.md.
  // Preview: homer-reader.johnhboyer.workers.dev. No custom domain yet: John
  // attaches homer.johnhboyer.com at cutover, and a route here then records it.
  "name": "homer-reader",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
