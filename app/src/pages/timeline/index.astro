---
// Day-by-day timeline of the Iliad and Odyssey — the first apparatus feature
// under the new sourcing policy (copyrighted scholarship citable + attributed
// short quotes OK, John 2026-07-18; see docs/research/chronology-{iliad,
// odyssey}.md and apparatus/bibliography.json). SSR-only, no client JS.
//
// Data flow: readFileSync the raw apparatus files directly (same posture as
// places/index.astro and maps/index.astro) — the day-strip STRUCTURE (which
// days are dramatized, which are compressed spans, book boundaries) is
// derived at build time from the emitted scenes' apparatus.scenes[].dayNumber
// via the shared pure helper (@shared/lib/timeline), so a pipeline re-emit
// that shifts the calendar reflows this page automatically. The CONTENT
// layered onto that structure — the four Iliad framing spans' poem-quotes,
// the Odyssey Day-34 "decade" inset, Zieliński's Law annotation, and the
// Sources section — is curated here, sourced 1:1 from docs/research/
// chronology-{iliad,odyssey}.md; no Greek is quoted here beyond what that
// research lane verified verbatim (Homeric accuracy is non-negotiable).
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import {
  buildDayStrip,
  buildVoyageStrip,
  parseDayRange,
  totalDays,
  type BookInput,
  type DayStripEntry,
  type VoyageStationInput,
  type VoyageStripEntry,
} from '@shared/lib/timeline';
import '@shared/styles/global.css';
import '../../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ── Bibliography ────────────────────────────────────────────────────────────
type BiblioType = 'book' | 'article' | 'web';
interface BiblioEntry {
  id: string;
  type: BiblioType;
  chicago: string;
  url?: string;
  pd: boolean;
  notes?: string;
}
const biblioFile = JSON.parse(readFileSync('../apparatus/bibliography.json', 'utf-8')) as {
  status: 'draft' | 'reviewed';
  entries: BiblioEntry[];
};
const bib = new Map(biblioFile.entries.map((e) => [e.id, e]));
const isDraft = biblioFile.status === 'draft';

// ── Scenes -> day strip ─────────────────────────────────────────────────────
type Work = 'iliad' | 'odyssey';
function loadBooks(work: Work): BookInput[] {
  const books: BookInput[] = [];
  for (let i = 1; i <= 24; i++) {
    const n = String(i).padStart(2, '0');
    const raw = JSON.parse(readFileSync(`../build/dist/${work}/book-${n}.json`, 'utf-8'));
    const app = raw.apparatus ?? {};
    const scenes = (app.scenes ?? []) as { lines: number[]; dayNumber: number | null; summary?: string }[];
    books.push({ book: i, dayRange: parseDayRange(app.day ?? null), scenes });
  }
  return books;
}
const iliadStrip = buildDayStrip(loadBooks('iliad'));
const odysseyStrip = buildDayStrip(loadBooks('odyssey'));
const iliadTotalDays = totalDays(iliadStrip);
const odysseyTotalDays = totalDays(odysseyStrip);

// ── Voyage strip (Troy -> Ithaca, the ten wandering years) ─────────────────
interface VoyageChronologyFile {
  status: 'draft' | 'reviewed';
  totalAssertions: {
    warStart: { cite: string; greek: string; gloss: string };
    twentiethYear: { cite: string; greek: string; gloss: string }[];
  };
  stations: VoyageStationInput[];
}
const voyageFile = JSON.parse(readFileSync('../apparatus/voyage-chronology.json', 'utf-8')) as VoyageChronologyFile;
const voyageStrip = buildVoyageStrip(voyageFile.stations);
const voyageTotalYears = (voyageStrip.totalStatedDays / 365).toFixed(1);
// Year-scale grid sizing: a stated span's fr-weight is the SQUARE ROOT of
// its day-equivalent, not the raw day count. Raw linear weighting was tried
// first and rejected: with a 1-day span and a 2555-day span (Calypso) on the
// same track, linear fr sizing produces a ~50,000px-wide strip where every
// short span collapses to its floor width and only Calypso is visible at
// all -- honest in principle, unusable in practice, and no more legible
// about "dominance" than a square-root scale is. Sqrt compression keeps
// Calypso's stay and Circe's year the two unmistakably widest columns (still
// ~5-10x their nearest rivals) while keeping the whole strip scrollable in a
// normal viewport. An unstated gap gets a small fixed track, never a
// fabricated width.
function voyageGridColumns(entries: VoyageStripEntry[]): string {
  return entries.map((e) => (e.kind === 'stated' ? `minmax(2.75rem, ${Math.max(Math.sqrt(e.days), 1).toFixed(2)}fr)` : 'minmax(1.25rem, .12fr)')).join(' ');
}
function formatVoyageDuration(e: VoyageStripEntry): string {
  if (!e.duration) return '';
  const unit = e.duration.value === 1 ? e.duration.unit.replace(/s$/, '') : e.duration.unit;
  return `${e.duration.value} ${unit}`;
}
// Short abbreviation for the strip cell itself (full duration + label live in
// the legend below) -- mirrors the day strip's terse cell-num/"Nd" pattern.
const VOYAGE_UNIT_ABBR: Record<string, string> = { day: 'd', days: 'd', night: 'n', month: 'mo', months: 'mo', year: 'yr', years: 'yr' };
function voyageShortLabel(e: VoyageStripEntry): string {
  if (!e.duration) return '';
  return `${e.duration.value}${VOYAGE_UNIT_ABBR[e.duration.unit]}`;
}

// Book-boundary markers: which book number(s) "start" at a given column. A
// book that contributes no new day/span entry (its content shares an already-
// established day, e.g. Il. 11-18 all fall on Day 25) attaches to the LAST
// column its nearest non-empty predecessor owns, so a run of such books
// collapses into one marker ("11-18") rather than vanishing silently.
function bookMarkers(strip: ReturnType<typeof buildDayStrip>): Map<number, number[]> {
  const markers = new Map<number, number[]>();
  let lastOwned = -1;
  for (const br of strip.bookRanges) {
    const nonEmpty = br.endIndex > br.startIndex;
    const idx = nonEmpty ? br.startIndex : lastOwned;
    if (idx >= 0) {
      if (!markers.has(idx)) markers.set(idx, []);
      markers.get(idx)!.push(br.book);
    }
    if (nonEmpty) lastOwned = br.endIndex - 1;
  }
  return markers;
}
// A book label owns every column up to the next book's label, so it has the
// room of its whole run of days and never runs into its neighbour.
function markerEnd(markers: Map<number, number[]>, i: number, count: number): number {
  const next = [...markers.keys()].filter((k) => k > i).sort((a, b) => a - b)[0];
  return (next ?? count) + 1;
}
function formatBookGroup(nums: number[]): string {
  return nums.length === 1 ? String(nums[0]) : `${nums[0]}–${nums[nums.length - 1]}`;
}

// ── Deep links ───────────────────────────────────────────────────────────────
const locHref = (work: Work, book: number, line: number) => `${base}/${work}/book/${book}?loc=${book}.${line}`;

// ── Curated span notes (poem-quoted, sourced from the research docs) ────────
// Keyed by `${fromDay}-${toDay ?? 'end'}`. Only Greek verified VERBATIM in
// docs/research/chronology-*.md is quoted; everything else is an honest
// editorial gloss, not a translator quote.
interface SpanNote { label: string; greek?: string; gloss: string; cite: string }
const ILIAD_SPAN_NOTES: Record<string, SpanNote> = {
  '1-10': {
    label: 'Nine days of plague',
    greek: 'ἐννῆμαρ … τῇ δεκάτῃ',
    gloss: 'Apollo’s arrows range through the camp for nine days; on the tenth, Achilles calls the host to assembly.',
    cite: 'Il. 1.53–54',
  },
  '10-21': {
    label: 'Twelve-day divine absence',
    greek: 'ἀλλ᾽ ὅτε δή ῥ᾽ ἐκ τοῖο δυωδεκάτη γένετ᾽ ἠώς',
    gloss: 'The gods return from feasting among the Aethiopians on the twelfth dawn, and Thetis makes her plea to Zeus.',
    cite: 'Il. 1.493–494',
  },
  '28-40': {
    label: 'Twelve-day maltreatment of Hector',
    greek: 'ἀλλ᾽ ὅτε δή ῥ᾽ ἐκ τοῖο δυωδεκάτη γένετ᾽ ἠώς',
    gloss: 'The same twelfth-dawn formula recurs: Achilles drags Hector’s body around Patroclus’s tomb each night for twelve days, until Apollo protests. A further nine-day quarrel among the gods runs inside this span.',
    cite: 'Il. 24.31 (= 1.493); cf. 24.107',
  },
  '41-end': {
    label: 'The truce: nine days, then the burial',
    greek: 'τῇ δὲ δυωδεκάτῃ πολεμίξομεν εἴ περ ἀνάγκη',
    gloss: 'Priam’s terms: nine days of mourning, burial and feast on the tenth, a mound on the eleventh, battle again on the twelfth if it must be. The poem narrates the nine days of wood-gathering and the cremation on the tenth, but ends before reaching its own stated twelfth-day deadline — the compression is the poet’s own.',
    cite: 'Il. 24.667 (deadline, quoted); cf. 24.664–667, 781, 784–787',
  },
};
const ODYSSEY_SPAN_NOTES: Record<string, SpanNote> = {
  '7-11': {
    label: 'Building the raft',
    gloss: 'Calypso gives Odysseus an axe and shows him timber; he builds his raft over four days.',
    cite: 'Od. 5.228–262',
  },
  '11-29': {
    label: 'Seventeen days at sea',
    gloss: 'Odysseus sails alone, steering by the stars, until Poseidon spots him on the eighteenth day and raises the storm.',
    cite: 'Od. 5.263–281 (cf. 5.278–279)',
  },
  '29-32': {
    label: 'Two nights adrift',
    gloss: 'The raft destroyed, Odysseus is tossed at sea for two nights and days; on the third day he sights land and swims ashore.',
    cite: 'Od. 5.313–388',
  },
};

// ── Odyssey Day 34 "decade" inset (the Apologoi, told as analepsis) ─────────
// Anchors are the actual scenes.json lines for each episode (data-derived),
// except the two duration statements, whose citations are the research
// lane's verified 10.469-474 / 7.253-260.
interface InsetStep { label: string; greek?: string; cite: string; work: Work; book: number; line: number; note?: string }
const ODYSSEY_INSET: InsetStep[] = [
  { label: 'The Cyclops’ cave', cite: 'Od. 9.105ff.', work: 'odyssey', book: 9, line: 105 },
  { label: 'Circe: a year’s stay', greek: 'ἐνιαυτός', cite: 'Od. 10.469–474', work: 'odyssey', book: 10, line: 469 },
  { label: 'The house of Hades', cite: 'Od. 11.1ff.', work: 'odyssey', book: 11, line: 1 },
  { label: 'Thrinacia: the cattle of the Sun', cite: 'Od. 12.260ff.', work: 'odyssey', book: 12, line: 260 },
  {
    label: 'Calypso: seven years',
    cite: 'Od. 7.253–260',
    work: 'odyssey', book: 7, line: 253,
    note: 'Recounted by Odysseus to Arete on Day 33, the evening before the Apologoi — not part of the Day-34 telling itself, but the same chronological decade.',
  },
  {
    label: 'Ashore on Scheria',
    cite: 'Od. 5.313–493',
    work: 'odyssey', book: 5, line: 436,
    note: 'Dramatized directly in Book 5 (Days 29–33), not part of the Day-34 retelling — the frame the Apologoi eventually catches up to.',
  },
];

const pageTitle = 'Timeline — The Homer Reader';
const metaDescription = 'A day-by-day timeline of the Iliad and Odyssey, with the poems’ own compressed spans and scholarly sourcing.';
const canonical = Astro.site ? new URL(`${base}/timeline/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };

function gridColumns(entries: DayStripEntry[]): string {
  // A compressed span is a fixed narrow band (its label runs up the band); a
  // dramatized day takes an equal share of the rest, never under 3.25rem.
  return entries.map((e) => (e.kind === 'span' ? '2.5rem' : 'minmax(3.25rem, 1fr)')).join(' ');
}
function spanKey(e: DayStripEntry & { kind: 'span' }): string {
  return `${e.fromDay ?? 'start'}-${e.toDay ?? 'end'}`;
}
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    /* Page frame, title block and section heads are the shared reference-page
       pattern (styles/edition-pages.css). What is local is the strip itself.
       --tl is the poem's own colour from the token block, so the two
       calendars are told apart at a glance. */
    .timeline-body .tl-iliad { --tl: var(--iliad); }
    .timeline-body .tl-odyssey { --tl: var(--odyssey); }
    .timeline-body .pg-h2 { text-wrap: balance; }
    .timeline-body .pg-h2::before { content: ""; display: inline-block; width: 0.75rem; height: 0.75rem; margin-right: 0.75rem; border-radius: 50%; background: var(--tl, var(--text)); vertical-align: 0.14em; }
    .sources-section .pg-h2::before { display: none; }

    .day-strip-scroll, .voyage-strip-scroll { overflow-x: auto; overflow-y: hidden; margin-top: var(--space-5); padding-bottom: 0.625rem; scrollbar-width: thin; }
    .day-strip { display: grid; grid-template-rows: auto 6.5rem; column-gap: 3px; width: 100%; min-width: min-content; }
    .book-marker {
      grid-row: 1;
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      padding: 0 0 0.5rem 0.4375rem;
      border-left: 2px solid var(--tl);
      font: 600 0.9375rem/1.1 var(--font-ui);
      font-variant-numeric: tabular-nums;
      color: var(--text);
    }
    .book-marker .bk-word { display: block; margin-bottom: 0.1875rem; font-size: 0.75rem; font-weight: 500; color: var(--text-mid); }
    .day-cell, .span-cell { grid-row: 2; display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--text); border-radius: var(--radius-1) var(--radius-1) 0 0; }
    .day-cell {
      justify-content: center;
      gap: 0.375rem;
      background: color-mix(in srgb, var(--tl) 13%, var(--col-bg));
      border: 1px solid color-mix(in srgb, var(--tl) 34%, var(--border));
      border-bottom: 3px solid var(--tl);
    }
    .day-cell:hover, .day-cell:focus-visible { background: color-mix(in srgb, var(--tl) 26%, var(--col-bg)); }
    .day-cell .cell-num { font: 400 1.625rem/1 var(--font-display); font-variant-numeric: lining-nums tabular-nums; }
    .day-cell .cell-label { font: 500 0.75rem/1 var(--font-ui); color: var(--text-mid); }
    .day-cell[data-highlight="true"] { background: var(--tl); border-color: var(--tl); color: var(--page-bg); }
    .day-cell[data-highlight="true"] .cell-label { color: var(--page-bg); font-weight: 600; }
    .day-cell[data-highlight="true"]:hover { filter: brightness(1.08); }

    /* A compressed span: a narrow hatched band, its label run up the band so
       it has the band's whole height and never spills out of it. */
    .span-cell, .voyage-gap {
      justify-content: space-between;
      padding: 0.4375rem 0;
      border: 1px dashed var(--rule-strong);
      border-bottom-width: 3px;
      background:
        repeating-linear-gradient(135deg, color-mix(in srgb, var(--text) 14%, transparent) 0 1.5px, transparent 1.5px 7px),
        var(--page-bg);
    }
    .span-cell .cell-num { padding: 0.125rem 0.1875rem; border-radius: 2px; background: var(--page-bg); font: 600 0.875rem/1 var(--font-ui); font-variant-numeric: tabular-nums; }
    .span-cell .cell-label { padding: 0.25rem 0.125rem; border-radius: 2px; background: var(--page-bg); writing-mode: vertical-rl; transform: rotate(180deg); font: 500 0.75rem/1 var(--font-ui); color: var(--text-mid); }
    .span-cell:hover, .span-cell:focus-visible, .voyage-gap:hover, .voyage-gap:focus-visible { border-color: var(--accent); }

    /* The spans and the voyage stations, written out: duration in the left
       column, the passage in the right. */
    .span-legend, .voyage-legend { margin: var(--space-5) 0 0; padding: 0; list-style: none; max-width: 62rem; }
    .span-legend li, .voyage-legend li {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr);
      column-gap: var(--space-5);
      padding: var(--space-4) 0;
      border-top: 1px solid var(--border);
      scroll-margin-top: var(--pg-anchor);
    }
    .span-legend li:target, .voyage-legend li:target { background: var(--target-bg); box-shadow: 0 0 0 0.75rem var(--target-bg); }
    .span-legend-head, .voyage-legend-head { display: contents; }
    .span-legend li > p, .voyage-legend li > p { grid-column: 2; }
    .span-days, .voyage-dur { grid-column: 1; grid-row: 1 / span 4; align-self: start; display: flex; align-items: center; gap: 0.5rem; padding-top: 0.3125rem; font: 600 var(--step--1)/1.3 var(--font-ui); font-variant-numeric: tabular-nums; color: var(--text); }
    .span-days::before, .voyage-dur::before {
      content: "";
      flex: none;
      width: 0.875rem;
      height: 0.875rem;
      border-radius: 2px;
      box-sizing: border-box;
      border: 1px dashed var(--rule-strong);
      background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--text) 22%, transparent) 0 1.5px, transparent 1.5px 5px);
    }
    .voyage-dur:not([data-unstated])::before { border: 1px solid color-mix(in srgb, var(--tl) 34%, var(--border)); border-bottom: 2px solid var(--tl); background: color-mix(in srgb, var(--tl) 13%, var(--col-bg)); }
    .voyage-dur[data-unstated="true"] { color: var(--text-mid); }
    .span-label, .voyage-label { grid-column: 2; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.25; letter-spacing: -0.005em; color: var(--text); }
    .span-greek, .voyage-greek { margin-top: 0.25rem; font-family: var(--font-greek); font-size: 1.0625rem; line-height: 1.45; color: var(--text-mid); }
    .span-gloss, .voyage-note { margin-top: 0.25rem; font-size: 1.0625rem; line-height: 1.55; color: var(--text); text-wrap: pretty; }
    .span-cite, .voyage-cite { margin-top: 0.375rem; font: 500 var(--step--1)/1.5 var(--font-ui); font-variant-numeric: tabular-nums; color: var(--text-mid); }
    .span-cite a, .voyage-cite a { font-weight: 600; }

    .zielinski-note { max-width: 46rem; margin-top: var(--space-4); font-size: 1rem; line-height: 1.55; color: var(--text-mid); text-wrap: pretty; }

    .day34-block { margin-top: var(--space-6); padding: var(--space-5) var(--space-5) var(--space-5); border: 1px solid var(--border); border-top: 3px solid var(--tl); border-radius: var(--radius-2); background: var(--col-bg); scroll-margin-top: var(--pg-anchor); }
    .day34-block h3 { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.01em; }
    .day34-quote { max-width: 50rem; margin-top: var(--space-3); font-size: var(--step-1); line-height: 1.45; color: var(--text); text-wrap: pretty; }
    .day34-quote cite { font: 500 var(--step--1)/1.4 var(--font-ui); font-style: normal; color: var(--text-mid); }
    .day34-inset-label { margin-top: var(--space-5); font: 600 var(--step--1)/1.3 var(--font-ui); color: var(--text-mid); }
    .day34-inset { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.375rem; margin-top: 0.625rem; padding: 0; list-style: none; }
    .day34-inset li { display: flex; align-items: center; }
    .day34-inset a.inset-step { display: inline-block; padding: 0.5rem 0.875rem; border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--page-bg); font: 600 var(--step--1)/1.3 var(--font-ui); color: var(--text); text-decoration: none; }
    .day34-inset a.inset-step:hover, .day34-inset a.inset-step:focus-visible { border-color: var(--accent); color: var(--accent); }
    .day34-inset a.inset-step [lang="grc"] { font-family: var(--font-greek); font-weight: 400; font-size: 1.0625em; }
    .day34-inset .inset-arrow { color: var(--text-mid); font: 400 1rem/1 var(--font-ui); }
    .day34-inset-notes { max-width: 56rem; margin-top: var(--space-4); font-size: 1rem; line-height: 1.55; color: var(--text-mid); }
    .day34-inset-notes p + p { margin-top: 0.375rem; }
    .day34-inset-notes strong { color: var(--text); }
    .day34-crosslink { margin-top: var(--space-4); font-size: 1rem; color: var(--text-mid); }

    .voyage-intro { max-width: 46rem; }
    .voyage-strip { display: grid; grid-auto-flow: column; grid-template-rows: 5rem; column-gap: 3px; width: 100%; min-width: min-content; }
    .voyage-cell, .voyage-gap { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; text-decoration: none; color: var(--text); border-radius: var(--radius-1) var(--radius-1) 0 0; }
    .voyage-cell { padding-bottom: 0.5rem; background: color-mix(in srgb, var(--tl) 13%, var(--col-bg)); border: 1px solid color-mix(in srgb, var(--tl) 34%, var(--border)); border-bottom: 3px solid var(--tl); }
    .voyage-cell:hover, .voyage-cell:focus-visible { background: color-mix(in srgb, var(--tl) 26%, var(--col-bg)); }
    .voyage-cell .voyage-num { font: 600 0.9375rem/1 var(--font-ui); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .voyage-gap .voyage-num { padding: 0 1px; background: var(--page-bg); font: 500 0.75rem/1 var(--font-ui); color: var(--text-mid); }
    .voyage-honesty { max-width: 50rem; margin-top: var(--space-6); padding: var(--space-4) var(--space-5); border: 1px solid var(--border); border-left: 3px solid var(--tl); border-radius: var(--radius-2); background: var(--col-bg); font-size: 1.0625rem; line-height: 1.6; color: var(--text-mid); text-wrap: pretty; }
    .voyage-honesty strong { color: var(--text); }
    .voyage-honesty [lang="grc"] { font-family: var(--font-greek); }

    .quoted-sources { list-style: none; margin: var(--space-5) 0 var(--space-6); padding: 0; max-width: 56rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--space-5) var(--space-6); }
    .quoted-sources li { padding-top: var(--space-4); border-top: 2px solid var(--text); }
    .quoted-sources blockquote { margin: 0 0 0.625rem; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.25; letter-spacing: -0.01em; color: var(--text); text-wrap: balance; }
    .quoted-sources cite { font: 500 var(--step--1)/1.5 var(--font-ui); font-style: normal; color: var(--text-mid); }
    .biblio-list { list-style: none; margin: 0; padding: 0; max-width: 62rem; }
    .biblio-list li { padding: var(--space-3) 0; border-top: 1px solid var(--border); font-size: 1.0625rem; line-height: 1.55; scroll-margin-top: var(--pg-anchor); text-wrap: pretty; }
    .biblio-list li:target { background: var(--target-bg); box-shadow: 0 0 0 0.75rem var(--target-bg); }
    .pd-tag { margin-left: 0.5em; padding: 0.1em 0.4em; border: 1px solid var(--rule-strong); border-radius: 3px; font: 600 var(--step--2)/1 var(--font-ui); letter-spacing: 0.07em; color: var(--text-mid); vertical-align: 0.12em; }
    .biblio-note { margin-top: 0.25rem; font: 400 0.875rem/1.5 var(--font-ui); color: var(--text-mid); }

    @media (max-width: 760px) {
      .span-legend li, .voyage-legend li { grid-template-columns: minmax(0, 1fr); }
      .span-days, .voyage-dur { grid-row: auto; padding: 0 0 0.375rem; }
      .span-label, .voyage-label, .span-legend li > p, .voyage-legend li > p { grid-column: 1; }
      .day34-block { padding: var(--space-4); }
      .day34-inset .inset-arrow { display: none; }
      .day-strip-scroll, .voyage-strip-scroll { margin-right: calc(var(--pg-pad) * -1); padding-right: var(--pg-pad); }
    }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Timeline" />
  <main class="pg timeline-body">
    <header class="pg-head">
    <p class="pg-eyebrow">Atlas</p>
    <h1 class="pg-title">Timeline {isDraft && <span class="draft-badge" title="AI-drafted apparatus, pending review">Draft</span>}</h1>
    <p class="pg-intro timeline-intro">
      A day-by-day chronology of the Iliad and Odyssey, derived from each book’s scene apparatus.
      Summarized spans — stretches the poem itself compresses into a handful of lines — draw
      narrower and hatched, with their day-count labeled; dramatized days draw full width.
    </p>
    <p class="pg-aside timeline-honesty">
      Day-counts vary in the scholarship — this timeline follows the traditional reading of {iliadTotalDays} Iliad
      days (also cited as 50, 52, or 54 by inclusive/exclusive counting of the summarized spans) and a
      Day 1–{odysseyTotalDays} Odyssey calendar, one day ahead of Delebecque’s reported Day-33 telling; treat
      totals as citable convention, not settled consensus.
    </p>
    </header>

    <nav class="pg-bar" aria-label="Sections of this page">
      <div class="pg-jump">
        <a href="#iliad">Iliad</a>
        <a href="#odyssey">Odyssey</a>
        <a href="#voyage">The voyage</a>
        <a href="#sources">Sources</a>
      </div>
    </nav>

    {(['iliad', 'odyssey'] as Work[]).map((work) => {
      const strip = work === 'iliad' ? iliadStrip : odysseyStrip;
      const notes = work === 'iliad' ? ILIAD_SPAN_NOTES : ODYSSEY_SPAN_NOTES;
      const total = work === 'iliad' ? iliadTotalDays : odysseyTotalDays;
      const markers = bookMarkers(strip);
      const spanEntries = strip.entries.filter((e): e is DayStripEntry & { kind: 'span' } => e.kind === 'span');
      return (
        <section class={`pg-section work-section tl-${work}${work === 'iliad' ? ' is-first' : ''}`} id={work}>
          <h2 class="pg-h2">{work === 'iliad' ? 'Iliad' : 'Odyssey'} <span class="pg-h2-meta work-days-total">{total} days</span></h2>
          <div class="day-strip-scroll">
            <div class="day-strip" style={`grid-template-columns: ${gridColumns(strip.entries)};`}>
              {strip.entries.map((entry, i) => {
                const marker = markers.get(i);
                return (
                  <>
                    {marker && <div class="book-marker" style={`grid-column: ${i + 1} / ${markerEnd(markers, i, strip.entries.length)};`}><span class="bk-word">Bk </span>{formatBookGroup(marker)}</div>}
                    {entry.kind === 'day' ? (
                      <a
                        class="day-cell"
                        style={`grid-column: ${i + 1};`}
                        href={locHref(work, entry.book, entry.line)}
                        data-highlight={work === 'odyssey' && entry.dayNumber === 34 ? 'true' : undefined}
                        aria-label={`Day ${entry.dayNumber} — ${work === 'iliad' ? 'Iliad' : 'Odyssey'} ${entry.book}.${entry.line}${work === 'odyssey' && entry.dayNumber === 34 ? ', the telling of the Apologoi' : ''}`}
                      >
                        <span class="cell-num">{entry.dayNumber}</span>
                        <span class="cell-label">day</span>
                      </a>
                    ) : (
                      <a
                        class="span-cell"
                        style={`grid-column: ${i + 1};`}
                        href={`#span-${work}-${spanKey(entry)}`}
                        aria-label={`Compressed span: ${entry.spanDays} day${entry.spanDays === 1 ? '' : 's'}${notes[spanKey(entry)] ? `, ${notes[spanKey(entry)].label}` : ''} — see Compressed spans below`}
                      >
                        <span class="cell-num">{entry.spanDays}d</span>
                        <span class="cell-label">compressed</span>
                      </a>
                    )}
                  </>
                );
              })}
            </div>
          </div>

          {work === 'odyssey' && (
            <p class="zielinski-note">
              Days 1–6 (the Telemachy, Books 1–4) and Book 5’s second divine council may narrate
              overlapping, not strictly sequential, time — ancient epic tends to tell simultaneous events one
              after another rather than in parallel (<a href={`#${'zielinski-1901'}`}>Zieliński’s Law</a>).
            </p>
          )}

          {work === 'odyssey' && (
            <div class="day34-block" id="day-34-telling">
              <h3>Day 34 — the telling</h3>
              <p class="day34-quote">
                “Morning of the 34th day of the action of the poem”… “the dawn of the 35th day.”
                {' '}<cite>— Monro, on Od. 13.18 and 13.93 (<a href="#monro-odyssey">Sources</a>)</cite>
              </p>
              <p class="day34-quote">
                “The date is given with a precision most unusual in epic poetry.”
                {' '}<cite>— Gilbert Murray, 1924 (<a href="#murray-1924">Sources</a>)</cite>
              </p>
              <p class="day34-inset-label">Told on Day 34 — the decade recounted at the Phaeacian feast</p>
              <ol class="day34-inset">
                {ODYSSEY_INSET.map((step, i) => (
                  <>
                    <li>
                      <a class="inset-step" href={locHref(step.work, step.book, step.line)}>
                        {step.label}{step.greek && <> — <span lang="grc">{step.greek}</span></>} ({step.cite})
                      </a>
                    </li>
                    {i < ODYSSEY_INSET.length - 1 && <span class="inset-arrow" aria-hidden="true">→</span>}
                  </>
                ))}
              </ol>
              <div class="day34-inset-notes">
                {ODYSSEY_INSET.filter((s) => s.note).map((s) => <p><strong>{s.label}:</strong> {s.note}</p>)}
              </div>
              <p class="day34-crosslink">
                This decade, as told in one evening — see <a href="#voyage">the voyage strip</a> below.
              </p>
            </div>
          )}

          {spanEntries.length > 0 && (
            <ol class="span-legend">
              {spanEntries.map((entry) => {
                const key = spanKey(entry);
                const note = notes[key];
                return (
                  <li id={`span-${work}-${key}`}>
                    <div class="span-legend-head">
                      <span class="span-days">{entry.spanDays} day{entry.spanDays === 1 ? '' : 's'} compressed</span>
                      <span class="span-label">{note?.label ?? 'Summarized narration'}</span>
                    </div>
                    {note?.greek && <p class="span-greek" lang="grc">{note.greek}</p>}
                    <p class="span-gloss">{note?.gloss ?? entry.summary ?? 'The poem passes over this interval in a line or two.'}</p>
                    <p class="span-cite">
                      {note?.cite ?? `${work === 'iliad' ? 'Il.' : 'Od.'} ${entry.book}.${entry.line}`}
                      {' — '}
                      <a href={locHref(work, entry.book, entry.line)}>jump to the passage</a>
                    </p>
                  </li>
                );
              })}
            </ol>
          )}
        </section>
      );
    })}

    <section class="pg-section voyage-section tl-odyssey" id="voyage" aria-labelledby="voyage-heading">
      <h2 class="pg-h2" id="voyage-heading">The voyage — Troy to Ithaca (approximate) {isDraft && <span class="draft-badge" title="AI-drafted apparatus, pending review">Draft</span>}</h2>
      <p class="pg-lede voyage-intro">
        Where the day strips above dramatize the poem’s narrative present, this strip approximates the
        decade the Odyssey compresses into that present: the ten years’ wandering from the fall of Troy to
        the beach at Ithaca. Stretches the poem numbers — nine days here, a month there, Circe’s year,
        Calypso’s seven — draw wide, sized to their stated length; stretches it never numbers draw as
        narrow hatched gaps. Each station is labeled and deep-linked to its first line in the reader.
      </p>
      <div class="voyage-strip-scroll">
        <div class="voyage-strip" style={`grid-template-columns: ${voyageGridColumns(voyageStrip.entries)};`}>
          {voyageStrip.entries.map((entry, i) => {
            // stationId isn't unique across entries (Ogygia yields two: the
            // nine-day arrival and the seven-year stay), so the anchor uses
            // the array index to avoid a duplicate id with the legend below.
            const ref = entry.refs[0];
            const href = ref ? locHref(ref.work as Work, ref.book, ref.lines[0]) : undefined;
            const anchor = `#voyage-${entry.stationId}-${i}`;
            return entry.kind === 'stated' ? (
              <a
                class="voyage-cell"
                href={href ?? anchor}
                aria-label={`${entry.label}: ${formatVoyageDuration(entry)}${entry.duration?.greek ? `, ${entry.duration.greek}` : ''} — see the voyage legend below`}
              >
                <span class="voyage-num">{voyageShortLabel(entry)}</span>
              </a>
            ) : (
              <a
                class="voyage-gap"
                href={href ?? anchor}
                aria-label={`${entry.label}: no duration stated by the poem — see the voyage legend below`}
              >
                <span class="voyage-num">—</span>
              </a>
            );
          })}
        </div>
      </div>

      <ol class="voyage-legend">
        {voyageStrip.entries.map((entry, i) => {
          const ref = entry.refs[0];
          const href = ref ? locHref(ref.work as Work, ref.book, ref.lines[0]) : undefined;
          return (
            <li id={`voyage-${entry.stationId}-${i}`}>
              <div class="voyage-legend-head">
                <span class="voyage-dur" data-unstated={entry.kind === 'unstated' ? 'true' : undefined}>
                  {entry.kind === 'stated' ? formatVoyageDuration(entry) : 'unstated'}
                </span>
                <span class="voyage-label">{entry.label}</span>
              </div>
              {entry.duration?.greek && (
                <p class="voyage-greek" lang="grc">{entry.duration.greek} — {formatVoyageDuration(entry)}, {entry.duration.cite}</p>
              )}
              {entry.duration?.approximate && (
                <p class="voyage-note">No counting-word in the Greek here — this span is read off the poem’s narrative framing, not a stated numeral.</p>
              )}
              <p class="voyage-note">{entry.note}</p>
              {href && <p class="voyage-cite"><a href={href}>jump to the passage ({ref!.work === 'odyssey' ? 'Od.' : 'Il.'} {ref!.book}.{ref!.lines[0]})</a></p>}
            </li>
          );
        })}
      </ol>

      <p class="voyage-honesty">
        <strong>An honesty note.</strong> These stated spans — the nine-day storms, Aeolus’s month,
        Thrinacia’s month, the raft’s four days building and seventeen sailing and two nights adrift, one
        night’s crossing to Ithaca, Circe’s year, and Calypso’s seven — already sum to about {voyageTotalYears} years,
        not the full ten the poem implies for the wandering. The poem itself never itemizes a ten-year
        total for the return: it simply asserts, four times, that Odysseus comes home in the twentieth
        year overall — counting, by tradition, the ten years of the war at Troy plus this decade of
        wandering ({voyageFile.totalAssertions.twentiethYear.map((t, i) => (
          <>{i > 0 && '; '}<span lang="grc">{t.greek}</span> — {t.cite}</>
        ))}) — while leaving the remaining months of this table entirely unstated, drawn here as the
        hatched gaps above. The strip’s year-scale layout is a display convention built to make that
        arithmetic visible, not a claim to have solved it.
      </p>
    </section>

    <section class="pg-section sources-section" id="sources" aria-labelledby="sources-heading">
      <h2 class="pg-h2" id="sources-heading">Sources</h2>
      <ul class="quoted-sources">
        <li>
          <blockquote>“Morning of the 34th day of the action of the poem… the dawn of the 35th day.”</blockquote>
          <cite>David B. Monro, note to Od. 13.18 and 13.93, in <a href="#monro-odyssey">Homer's Odyssey, Books XIII–XXIV</a> (1901).</cite>
        </li>
        <li>
          <blockquote>“The date is given with a precision most unusual in epic poetry.”</blockquote>
          <cite>Gilbert Murray, <a href="#murray-1924">The Rise of the Greek Epic</a>, 3rd ed. (1924).</cite>
        </li>
      </ul>
      <ol class="biblio-list">
        {biblioFile.entries.map((entry) => (
          <li id={entry.id}>
            {entry.type === 'web' && entry.url ? (
              <a href={entry.url} target="_blank" rel="noopener">{entry.chicago}</a>
            ) : (
              <span>{entry.chicago}</span>
            )}
            {entry.type !== 'web' && entry.url && <> {' '}<a href={entry.url} target="_blank" rel="noopener">Full text ↗</a></>}
            {entry.pd && <span class="pd-tag">PD</span>}
            {entry.notes && <p class="biblio-note">{entry.notes}</p>}
          </li>
        ))}
      </ol>
    </section>
  </main>
</body>
</html>
