---
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import Pwa from '../../components/Pwa.astro';
import RepetitionsIndex from '../../components/RepetitionsIndex.svelte';
import { jsonLdSafe } from '../../lib/jsonld';
import type { Repetition } from '@shared/lib/data';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repetitions = JSON.parse(readFileSync('../build/dist/repetitions.json', 'utf-8')) as Repetition[];
// Keep the first paint small. The island fetches the complete, authoritative
// list only when a reader starts a text search; refs beyond five never need to
// be serialized into the initial HTML because the ledger visibly caps them.
const initialEntries = repetitions.slice(0, 300).map(entry => ({
  ...entry,
  // One live citation per leading result keeps the static document compact;
  // searching hydrates the complete index, where each result exposes five.
  refs: entry.refs.slice(0, 1),
  crossEpic: new Set(entry.refs.map(ref => ref.work)).size > 1,
}));
const pageTitle = 'Repetitions — The Homer Reader';
const metaDescription = 'The most frequent repeated Greek lines and phrases across the Iliad and Odyssey, computed from the corpus.';
const canonical = Astro.site ? new URL(`${base}/repetitions/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    body { overflow-x: hidden; max-width: 100%; }
    .repetitions-body { max-width: 940px; margin: 0 auto; padding: 2rem 1rem 4.5rem; color: var(--text); }
    h1 { font-family: var(--font-display); font-size: 1.95rem; font-weight: 400; line-height: 1.15; margin-bottom: .55rem; }
    .repetitions-intro { max-width: 47rem; color: var(--text-mid); font-size: .98rem; line-height: 1.62; }
    .computed-note { margin-top: 3rem; padding-top: .9rem; border-top: 1px solid var(--border); color: var(--text-mid); font-family: var(--font-ui); font-size: .73rem; }
    @media (max-width: 480px) { h1 { font-size: 1.6rem; } }
  </style>
  <Pwa />
</head>
<body>
  <header class="simple-header">
    <div class="header-title"><a class="home-link" href={`${base}/`}>Homer</a><span class="title-sep">›</span><span class="header-static">Repetitions</span></div>
    <nav class="header-actions" aria-label="Navigation"><a href={`${base}/`} class="search-link">All works</a><a href={`${base}/search`} class="search-link">Search</a><ThemeToggle /></nav>
  </header>
  <main class="repetitions-body">
    <h1>Repeated lines &amp; phrases</h1>
    <p class="repetitions-intro">The three hundred most frequent repetitions in the two poems, with the full corpus ready when you search. The small Il+Od marker identifies phrases that occur in both epics.</p>
    <RepetitionsIndex client:load initialEntries={initialEntries} base={base} />
    <footer class="computed-note">Computed automatically from the corpus by n-gram analysis; counts are exact.</footer>
  </main>
</body>
</html>
