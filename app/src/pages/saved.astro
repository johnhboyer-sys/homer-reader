---
// The searches kept in this browser by Save search on the results (ported
// from aristotle-reader's saved.astro, in this site's frame and theme). The
// list itself is SavedSearches.svelte; its styles are the block below, under
// .saved, on Homer's tokens (global.css).
import SavedSearches from '@shared/components/SavedSearches.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Pwa from '../components/Pwa.astro';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit greek={false} />
  <title>Saved searches · The Homer Reader</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Pwa />
</head>
<body>
  <SiteHeader section="Search" />
  <main class="saved">
    <h1>Saved searches</h1>
    <SavedSearches client:load />
  </main>
</body>
</html>

<style is:global>
  .saved {
    width: 100%;
    /* Same column and title size as the other reference pages. */
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(2rem, 4.2vw, 3.5rem) var(--space-5) 72px;
    font-family: var(--font-ui);
    color: var(--text);
  }
  .saved h1 { margin: 0 0 18px 0; font: 400 clamp(2.5rem, 4.6vw, 3.75rem)/1.02 var(--font-display); letter-spacing: -0.02em; color: var(--text); }
  .saved .saved-page { max-width: 760px; }
  .saved .sv-label { margin: 0; font: 500 1rem/1.4 var(--font-ui); color: var(--text-mid); }
  .saved .sv-tools { display: flex; flex-wrap: wrap; gap: 0 28px; margin-top: 10px; }
  .saved .sv-status { margin: 6px 0 0; font: 500 1rem/1.4 var(--font-ui); color: var(--text); }
  .saved .sv-status:empty { margin: 0; }
  .saved .sv-empty { margin: 18px 0 0; padding-top: 18px; border-top: 2px solid var(--text); font: 400 1.125rem/1.5 var(--font-english); color: var(--text-mid); }
  /* Every action reads as the search rail's links do: ink, an accent rule under it. */
  .saved .sv-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: 600 0.9375rem/1.2 var(--font-ui);
    color: var(--text);
    text-decoration: underline 2px var(--accent);
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .saved .sv-btn:hover:not(:disabled) { color: var(--accent); }
  .saved .sv-btn:disabled { color: var(--text-mid); text-decoration-color: var(--border); cursor: default; }
  .saved .sv-btn:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .saved .sv-list { margin: 18px 0 0; padding: 0; list-style: none; border-top: 2px solid var(--text); }
  .saved .sv-item { padding: 20px 0 10px; border-bottom: 1px solid var(--border); }
  .saved .sv-name { margin: 0; font: 400 1.5rem/1.3 var(--font-english); color: var(--text); overflow-wrap: anywhere; }
  .saved .sv-date { margin: 6px 0 0; font: 500 0.875rem/1.3 var(--font-ui); color: var(--text-mid); }
  .saved .sv-note { margin: 10px 0 0; font: 400 1.125rem/1.55 var(--font-english); color: var(--text); white-space: pre-wrap; }
  .saved .sv-actions { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 6px; }
  .saved .sv-edit { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 4px; }
  .saved .sv-input {
    flex: 1 1 100%;
    min-height: 44px;
    padding: 8px 10px;
    border: 1px solid var(--text);
    border-radius: 0;
    background: var(--input-bg);
    font: 400 1.125rem/1.4 var(--font-english);
    color: var(--text);
  }
  .saved .sv-input:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .saved .sv-item > .sv-input { margin-top: 10px; }
  @media (max-width: 960px) {
    .saved { padding: 28px 16px 48px; }
    .saved h1 { font-size: clamp(2.25rem, 10.5vw, 2.75rem); }
  }
</style>
