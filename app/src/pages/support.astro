---
// A shareable on-site support/donation page. Giving itself goes through the
// Stripe Payment Link (SUPPORT_URL); this page gives that appeal a real URL on
// our own domain with a branded Open Graph card (public/og-support.png).
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Pwa from '../components/Pwa.astro';
import { SUPPORT_URL } from '../lib/support';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Support the Homer Reader';
const metaDescription =
  'Help keep the Homer Reader free and open — an ad-free parallel ' +
  'Greek–English edition of the Iliad and the Odyssey, with click-to-parse ' +
  'morphology, dictionary entries, and exact vulgate line citation.';
const canonical = Astro.site
  ? new URL(`${base}/support/`, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-support.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Homer Reader' },
  potentialAction: {
    '@type': 'DonateAction',
    target: SUPPORT_URL,
  },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Homer Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    /* Title block is the shared reference-page pattern
       (styles/edition-pages.css); below it the case on the left and the gift
       card on the right. */
    .sp-eyebrow { display: flex; align-items: baseline; gap: 0.625rem; }
    .sp-eyebrow .gk { font-family: var(--font-greek); font-size: 1.125rem; font-weight: 400; color: var(--text-mid); }
    .sp-lede { color: var(--text); max-width: 46rem; }
    .sp-main { display: grid; grid-template-columns: minmax(0, 42rem) minmax(0, 24rem); gap: var(--space-7); align-items: start; padding-top: var(--space-5); border-top: 2px solid var(--text); }
    .sp-case p { font-size: var(--step-1); line-height: 1.6; color: var(--text); text-wrap: pretty; }
    .sp-list { list-style: none; padding: 0; margin: var(--space-5) 0 0; }
    .sp-list li { position: relative; padding: var(--space-3) 0 var(--space-3) 2rem; border-top: 1px solid var(--border); font-size: 1.125rem; line-height: 1.5; color: var(--text); }
    .sp-list li::before { content: "χ"; position: absolute; left: 0.125rem; top: 0.6rem; font-family: var(--font-greek); font-size: 1.25rem; color: var(--accent); }
    .sp-gift { padding: var(--space-5); }
    .sp-cta .btn-donate { display: flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.5rem; border-radius: var(--radius-pill); font-size: 1rem; letter-spacing: 0; }
    .sp-note { margin-top: var(--space-4); font: 400 0.9375rem/1.55 var(--font-ui); color: var(--text-mid); }
    @media (max-width: 900px) { .sp-main { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); } }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Support" />

  <main class="pg sp-body">
    <header class="pg-head">
    <p class="pg-eyebrow sp-eyebrow">Support <span class="gk">χάρις</span></p>
    <h1 class="pg-title">Support the Homer Reader</h1>
    <p class="pg-intro sp-lede">
      The Homer Reader is an ad-free parallel Greek–English edition of
      the Iliad and the Odyssey — with click-to-parse morphology, dictionary
      entries, and exact vulgate line citation. It is free to read and always will be.
    </p>
    </header>
    <div class="sp-main">
      <div class="sp-case">
        <p>
          It is built and maintained by one person, and runs on no advertising and no
          paywall. A contribution helps defray development costs and keeps the reader
          free and open for students, teachers, and readers everywhere.
        </p>
        <ul class="sp-list">
          <li>Hosting and the tools that keep the site fast and ad-free.</li>
          <li>Aligning more public-domain translations to the Greek, line by line.</li>
          <li>Adding works, glossaries, and reading aids across the corpus.</li>
        </ul>
      </div>
      <aside class="pg-card sp-gift">
        <div class="sp-cta">
          <a class="btn-donate" href={SUPPORT_URL} target="_blank" rel="noopener">Make a gift</a>
        </div>
        <p class="sp-note">
          Gifts are processed securely by Stripe — you choose the amount. Thank you
          for keeping the reader free. <span class="gk" style="font-family:var(--font-greek);color:var(--text);">χάρις</span>.
        </p>
      </aside>
    </div>
  </main>
</body>
</html>
