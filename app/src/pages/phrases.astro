---
import Phrases from '@shared/components/Phrases.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Pwa from '../components/Pwa.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phraseDescription =
  'Browse every word-sequence that recurs across the Iliad and the Odyssey' +
  ' — as printed, in any form of the words, or in the English translation —' +
  ' with every occurrence linked to its place in the poem.';
const canonical = Astro.site ? new URL(`${base}/phrases/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Phrases in Homer',
  description: phraseDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Homer Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>Phrases in Homer</title>
  <meta name="description" content={phraseDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Phrases in Homer" />
  <meta property="og:description" content={phraseDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Phrases in Homer" />
  <meta name="twitter:description" content={phraseDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Pwa />
</head>
<body>
  <SiteHeader section="Phrases" />
  <p class="phrases-distinction">
    <a href={`${base}/formulas/`}>Formulas</a> lists the fixed epithet-formulas
    the apparatus identifies by dictionary form; this page lists every
    word-sequence that simply recurs, however spelled and wherever it falls in
    the verse.
  </p>
  <Phrases client:load />
</body>
</html>

<style>
  .phrases-distinction {
    max-width: 46rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 0;
    color: var(--text-mid);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .phrases-distinction a {
    color: var(--accent);
  }
</style>
