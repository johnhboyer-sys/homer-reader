---
// The Greek Lexicon index at /lemma — a crawlable directory of every built lemma
// page, sorted alphabetically by transliteration. Doubles as the DefinedTermSet
// landing and an internal-link hub so the per-lemma pages get discovered.
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Crumbs from '../../components/Crumbs.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import { greekFold } from '@shared/lib/search';
import '@shared/styles/global.css';
import '../../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Read the popup manifest (lsjKey -> {slug, head, count}) for the full built set.
const manifest: Record<string, { slug: string; head: string; count: number }> = JSON.parse(
  readFileSync('public/data/lemmata.json', 'utf-8'),
);
// `fold` folds the polytonic head to Beta-Code letters (accent-stripped) so the
// client filter can match it against either Greek or Beta Code input with the
// same greekFold — see the inline script below. A switch re-sorts the list by
// occurrence count on the client (?sort=count); the built HTML stays alphabetical.
const entries = Object.values(manifest)
  .map((e) => ({ ...e, fold: greekFold(e.head) }))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const pageTitle = "Lexicon of Homer's Greek — Word Frequency & Concordance";
const metaDescription =
  `A growing lexicon of Homer's Greek vocabulary: ${entries.length} key terms with` +
  ` LSJ definitions, corpus-wide frequency counts, and every occurrence linked to the` +
  ` parallel Greek–English text with vulgate line citation.`;
const canonical = Astro.site ? new URL(`${base}/lemma/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: "Lexicon of Homer's Greek",
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  hasDefinedTerm: entries.slice(0, 100).map((e) => ({
    '@type': 'DefinedTerm', name: e.head, inLanguage: 'grc',
    ...(canonical ? { url: new URL(`${base}/lemma/${e.slug}/`, Astro.site!).href } : {}),
  })),
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Homer Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    /* Title block and sticky filter row are the shared reference-page pattern
       (styles/edition-pages.css). */
    .lxi-filter { flex-wrap: wrap; }
    .lxi-filter .pg-find { flex: 1 1 18rem; max-width: 30rem; }
    .lxi-filter input::placeholder { font-size: 0.875rem; }
    .lxi-sort { flex: none; display: inline-flex; padding: 0.1875rem; border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--col-bg); }
    .lxi-sort button { min-height: 2rem; padding: 0 0.875rem; border: 0; border-radius: var(--radius-pill); background: none; color: var(--text-mid); font: 600 var(--step--1)/1 var(--font-ui); cursor: pointer; white-space: nowrap; }
    .lxi-sort button:hover { color: var(--accent); }
    .lxi-sort button[aria-pressed="true"] { background: var(--text); color: var(--page-bg); }
    .lxi-sort button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .lxi-empty { padding: var(--space-6) 0; font-size: 1.0625rem; color: var(--text-mid); }
    .lxi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr)); gap: 0 var(--space-5); list-style: none; padding: 0; margin: var(--space-4) 0 0; }
    .lxi-grid a { display: flex; justify-content: space-between; gap: 0.75rem; align-items: baseline; min-height: 2.75rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--text); }
    .lxi-grid a:hover { border-bottom-color: var(--accent); }
    .lxi-grid a:hover .lxi-gk { color: var(--accent); }
    .lxi-gk { font-family: var(--font-greek); font-size: 1.3125rem; line-height: 1.3; }
    .lxi-n { font: 500 var(--step--1)/1 var(--font-ui); font-variant-numeric: tabular-nums; color: var(--text-mid); }
    @media (max-width: 760px) {
      .lxi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-4); }
      .lxi-filter .pg-find { flex-basis: 100%; max-width: none; }
    }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Greek Lexicon" />
  <main class="pg lxi-body">
    <header class="pg-head">
    <Crumbs />
    <h1 class="pg-title lxi-h1">Lexicon of Homer's Greek</h1>
    <p class="pg-intro lxi-lede">
      {entries.length} key terms from Homer's vocabulary — each with its LSJ definition,
      how often it appears across the corpus, and every occurrence linked to the parallel
      Greek–English text. A concordance you can read.
    </p>
    </header>
    <div class="pg-bar lxi-filter">
      <span class="pg-find">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input
          type="search"
          id="lxi-input"
          placeholder="Filter — type Greek (οὐσ) or Beta Code (ous)…"
          autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
          aria-label="Filter the lexicon by Greek or Beta Code"
        />
      </span>
      <span class="lxi-sort" role="group" aria-label="Sort the lexicon">
        <button type="button" data-sort="alpha" aria-pressed="true">A–Ω</button>
        <button type="button" data-sort="count" aria-pressed="false">By count</button>
      </span>
      <span class="pg-count lxi-count" id="lxi-count" aria-live="polite"></span>
    </div>
    <ul class="lxi-grid" id="lxi-grid">
      {entries.map((e) => (
        <li data-fold={e.fold} data-count={e.count}>
          <a href={`${base}/lemma/${e.slug}/`}>
            <span class="lxi-gk">{e.head}</span>
            <span class="lxi-n">{e.count.toLocaleString()}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="lxi-empty" id="lxi-empty" hidden>No entries match. Try the dictionary form (e.g. <span style="font-family:var(--font-greek)">οὐσία</span>, not an inflected form).</p>
  </main>

  <script>
    // Client filter: fold both the built-in `data-fold` (already Beta-folded from
    // the polytonic head at build) and the user's query with the SAME greekFold,
    // so typing polytonic Greek OR Beta Code both match. Prefix match, like a
    // dictionary lookup.
    const GREEK_BETA: Record<string, string> = {
      α:'a',β:'b',γ:'g',δ:'d',ε:'e',ζ:'z',η:'h',θ:'q',ι:'i',κ:'k',
      λ:'l',μ:'m',ν:'n',ξ:'c',ο:'o',π:'p',ρ:'r',σ:'s',ς:'s',τ:'t',
      υ:'u',φ:'f',χ:'x',ψ:'y',ω:'w',ϝ:'v',
    };
    const fold = (s: string) => {
      let out = '';
      for (const ch of s.normalize('NFD')) {
        const lower = ch.toLowerCase();
        if (GREEK_BETA[lower]) out += GREEK_BETA[lower];
        else if (lower >= 'a' && lower <= 'z') out += lower;
      }
      return out;
    };
    const input = document.getElementById('lxi-input') as HTMLInputElement | null;
    const grid = document.getElementById('lxi-grid');
    const countEl = document.getElementById('lxi-count');
    const emptyEl = document.getElementById('lxi-empty');
    if (input && grid) {
      const items = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
      const total = items.length;
      const apply = () => {
        const q = fold(input.value.trim());
        let shown = 0;
        for (const li of items) {
          const hit = !q || (li.dataset.fold ?? '').startsWith(q);
          li.hidden = !hit;
          if (hit) shown++;
        }
        if (countEl) countEl.textContent = q ? `${shown} of ${total}` : '';
        if (emptyEl) emptyEl.hidden = shown !== 0;
      };
      input.addEventListener('input', apply);
    }

    // Sort switch. The built order is alphabetical; the count order breaks ties
    // alphabetically (Array.prototype.sort is stable).
    if (grid) {
      const alpha = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
      const byCount = alpha
        .slice()
        .sort((a, b) => Number(b.dataset.count ?? 0) - Number(a.dataset.count ?? 0));
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lxi-sort [data-sort]'));
      const setSort = (mode: string, push: boolean) => {
        grid.append(...(mode === 'count' ? byCount : alpha));
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.sort === mode));
        if (push) {
          const url = new URL(location.href);
          if (mode === 'count') url.searchParams.set('sort', 'count');
          else url.searchParams.delete('sort');
          history.replaceState(null, '', url);
        }
      };
      for (const b of buttons) b.addEventListener('click', () => setSort(b.dataset.sort ?? 'alpha', true));
      if (new URLSearchParams(location.search).get('sort') === 'count') setSort('count', false);
    }
  </script>
</body>
</html>
