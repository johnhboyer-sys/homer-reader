---
// Iliad half of /formulas/ (see /formulas/odyssey/ and the /formulas/ index).
// Split out of a single combined page (2026-07-17) because server-rendering
// English glosses under every formula occurrence — required so the page
// stays readable with JS disabled — pushed the combined page well past its
// ~400KB budget; each work now gets its own page under that budget, with
// /formulas/ reduced to a lightweight index linking to both. See
// FormulaLedger.astro for the shared row template.
import { readFileSync } from 'node:fs';
import ThemeInit from '../../../components/ThemeInit.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import Pwa from '../../../components/Pwa.astro';
import FormulaLedger from '../../../components/FormulaLedger.astro';
import { jsonLdSafe } from '../../../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface FormulaRef { book: number; line: number; }
interface Formula { text: string; lemmaKeys: string[]; count: number; refs: FormulaRef[]; }
interface EntityFormulas { entity: string; formulas: Formula[]; }
interface Character { id: string; name: string; greek?: string; }

const charactersFile: { characters: Character[] } = JSON.parse(readFileSync('../apparatus/characters.json', 'utf-8'));
const characters = new Map(charactersFile.characters.map(character => [character.id, character]));
const entries = JSON.parse(readFileSync('../build/dist/iliad/epithets.json', 'utf-8')) as EntityFormulas[];
const glossesFile: { status: 'draft' | 'reviewed'; glosses: Record<string, string> } = JSON.parse(readFileSync('../apparatus/formula-glosses.json', 'utf-8'));
const isDraft = glossesFile.status === 'draft';
const pageTitle = 'Iliad formulas — The Homer Reader';
const metaDescription = 'A computed index of the repeated epithets and formulas attached to named figures in the Iliad, with English glosses.';
const canonical = Astro.site ? new URL(`${base}/formulas/iliad/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
const characterName = (id: string) => characters.get(id)?.name ?? id;
const characterGreek = (id: string) => characters.get(id)?.greek;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    .formula-body { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem 4.5rem; color: var(--text); }
    h1 { font-family: var(--font-display); font-size: 1.95rem; font-weight: 400; line-height: 1.15; margin-bottom: .55rem; }
    .formula-intro { max-width: 45rem; color: var(--text-mid); font-size: .98rem; line-height: 1.62; }
    .formula-intro a { color: var(--accent); }
    .computed-note { margin-top: 3rem; padding-top: .9rem; border-top: 1px solid var(--border); color: var(--text-mid); font-family: var(--font-ui); font-size: .73rem; }
    @media (max-width: 480px) { h1 { font-size: 1.6rem; } }
  </style>
  <Pwa />
</head>
<body>
  <header class="simple-header">
    <div class="header-title"><a class="home-link" href={`${base}/`}>Homer</a><span class="title-sep">›</span><a href={`${base}/formulas/`} class="header-static">Formulas</a><span class="title-sep">›</span><span class="header-static">Iliad</span></div>
    <nav class="header-actions" aria-label="Navigation"><a href={`${base}/`} class="search-link">All works</a><a href={`${base}/search`} class="search-link">Search</a><ThemeToggle /></nav>
  </header>
  <main class="formula-body">
    <h1>Iliad epithets &amp; formulas {isDraft && <span class="draft-badge" title="AI-drafted English glosses, pending review">Draft</span>}</h1>
    <p class="formula-intro">Repeated phrases attached to named figures in the Iliad. Each Greek formula carries an English gloss and citations that open the corresponding verse in the reader. See also <a href={`${base}/formulas/odyssey/`}>Odyssey formulas</a>.</p>
    <FormulaLedger work="iliad" label="Iliad" entries={entries} glosses={glossesFile.glosses} characterName={characterName} characterGreek={characterGreek} base={base} />
    <footer class="computed-note">Computed automatically from the corpus by n-gram analysis; counts are exact.{isDraft && ' English glosses are draft translations, pending review.'}</footer>
  </main>
</body>
</html>
