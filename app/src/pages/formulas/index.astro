---
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface FormulaRef { book: number; line: number; }
interface Formula { text: string; lemmaKeys: string[]; count: number; refs: FormulaRef[]; }
interface EntityFormulas { entity: string; formulas: Formula[]; }
interface Character { id: string; name: string; greek?: string; }

const charactersFile: { characters: Character[] } = JSON.parse(readFileSync('../apparatus/characters.json', 'utf-8'));
const characters = new Map(charactersFile.characters.map(character => [character.id, character]));
const iliad = JSON.parse(readFileSync('../build/dist/iliad/epithets.json', 'utf-8')) as EntityFormulas[];
const odyssey = JSON.parse(readFileSync('../build/dist/odyssey/epithets.json', 'utf-8')) as EntityFormulas[];
const pageTitle = 'Formulas — The Homer Reader';
const metaDescription = 'A computed index of the repeated epithets and formulas attached to named figures in the Iliad and Odyssey.';
const canonical = Astro.site ? new URL(`${base}/formulas/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
const readerHref = (work: 'iliad' | 'odyssey', ref: FormulaRef) => `${base}/${work}/book/${ref.book}/?loc=${ref.book}.${ref.line}`;
const characterName = (id: string) => characters.get(id)?.name ?? id;
const characterGreek = (id: string) => characters.get(id)?.greek;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    .formula-body { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem 4.5rem; color: var(--text); }
    h1 { font-family: var(--font-display); font-size: 1.95rem; font-weight: 400; line-height: 1.15; margin-bottom: .55rem; }
    .formula-intro { max-width: 45rem; color: var(--text-mid); font-size: .98rem; line-height: 1.62; }
    .formula-ledger { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.75rem; margin-top: 2rem; }
    .work-ledger { min-width: 0; }
    .work-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: .55rem 0; border-top: 2px solid var(--rule-strong); border-bottom: 1px solid var(--border); }
    .work-heading h2 { font-family: var(--font-display); font-size: 1.45rem; font-weight: 400; }
    .work-heading span { font-family: var(--font-ui); font-size: .67rem; font-variant-caps: small-caps; letter-spacing: .08em; color: var(--text-mid); white-space: nowrap; }
    .entity-block { padding-top: 1.25rem; }
    .entity-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: .35rem .55rem; padding-bottom: .35rem; border-bottom: 1px solid var(--border); }
    .entity-heading h3 { font-family: var(--font-ui); font-size: .86rem; font-weight: 600; }
    .entity-greek { font-family: var(--font-greek); color: var(--text-mid); font-size: .9rem; }
    .formula-scroll { overflow-x: auto; padding-bottom: .35rem; }
    .formula-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .formula-list { list-style: none; margin: 0; min-width: 29rem; }
    .formula-list > li { display: grid; grid-template-columns: minmax(14rem, 1fr) auto; column-gap: .75rem; padding: .45rem 0; border-bottom: 1px solid var(--border); }
    .formula-list > li > span:first-child { font-family: var(--font-greek); font-size: 1rem; line-height: 1.45; overflow-wrap: anywhere; }
    .formula-list > li > span:nth-child(2) { font-family: var(--font-ui); font-size: .68rem; color: var(--text-mid); white-space: nowrap; align-self: baseline; }
    .formula-list > li > span:nth-child(3) { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .15rem .5rem; margin-top: .18rem; font-family: var(--font-ui); font-size: .67rem; line-height: 1.45; }
    .formula-list > li > span:nth-child(3) a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; white-space: nowrap; }
    .formula-list > li > span:nth-child(3) a:hover { border-bottom-color: var(--accent); }
    .formula-list > li > span:nth-child(3) a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .formula-list > li > span:nth-child(3) > span { color: var(--text-mid); white-space: nowrap; }
    .computed-note { margin-top: 3rem; padding-top: .9rem; border-top: 1px solid var(--border); color: var(--text-mid); font-family: var(--font-ui); font-size: .73rem; }
    @media (max-width: 760px) { .formula-ledger { grid-template-columns: 1fr; gap: 2.25rem; } }
    @media (max-width: 480px) { h1 { font-size: 1.6rem; } }
  </style>
  <Pwa />
</head>
<body>
  <header class="simple-header">
    <div class="header-title"><a class="home-link" href={`${base}/`}>Homer</a><span class="title-sep">›</span><span class="header-static">Formulas</span></div>
    <nav class="header-actions" aria-label="Navigation"><a href={`${base}/`} class="search-link">All works</a><a href={`${base}/search`} class="search-link">Search</a><ThemeToggle /></nav>
  </header>
  <main class="formula-body">
    <h1>Epithets &amp; formulas</h1>
    <p class="formula-intro">Repeated phrases attached to named figures, set as two parallel ledgers for the two poems. Each citation opens the corresponding verse in the reader.</p>
    <div class="formula-ledger">
      {([{ work: 'iliad', label: 'Iliad', entries: iliad }, { work: 'odyssey', label: 'Odyssey', entries: odyssey }] as const).map(({ work, label, entries }) => (
        <section class="work-ledger" aria-labelledby={`${work}-heading`}>
          <div class="work-heading"><h2 id={`${work}-heading`}>{label}</h2><span>{entries.length} named figures</span></div>
          {entries.map((entry) => (
            <div class="entity-block" role="group" aria-labelledby={`${work}-${entry.entity}`}>
              <div class="entity-heading"><h3 id={`${work}-${entry.entity}`}>{characterName(entry.entity)}</h3>{characterGreek(entry.entity) && <span class="entity-greek" lang="grc">{characterGreek(entry.entity)}</span>}</div>
              <div class="formula-scroll" tabindex="0" role="group" aria-label={`${characterName(entry.entity)} formulas, scrollable on narrow screens`}>
                <ol class="formula-list">
                  {entry.formulas.map((formula) => (
                    <li>
                      <span lang="grc">{formula.text}</span><span>{formula.count}×</span>
                      <span>
                        {formula.refs.slice(0, 4).map((ref) => <a href={readerHref(work, ref)}>{ref.book}.{ref.line}</a>)}
                        {formula.refs.length > 4 && <span>+{formula.refs.length - 4} more</span>}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          ))}
        </section>
      ))}
    </div>
    <footer class="computed-note">Computed automatically from the corpus by n-gram analysis; counts are exact.</footer>
  </main>
</body>
</html>
