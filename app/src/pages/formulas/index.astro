---
// Lightweight index for /formulas/ — links to the per-work ledgers at
// /formulas/iliad/ and /formulas/odyssey/. Split out (2026-07-17) because
// server-rendering English glosses under every formula occurrence (required
// for the no-JS SSR gate) pushed the combined single-page ledger well past
// its ~400KB budget; see FormulaLedger.astro and the two per-work pages for
// the actual content.
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Crumbs from '../../components/Crumbs.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import '@shared/styles/global.css';
import '../../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface FormulaRef { book: number; line: number; }
interface Formula { text: string; lemmaKeys: string[]; count: number; refs: FormulaRef[]; }
interface EntityFormulas { entity: string; formulas: Formula[]; }

const iliad = JSON.parse(readFileSync('../build/dist/iliad/epithets.json', 'utf-8')) as EntityFormulas[];
const odyssey = JSON.parse(readFileSync('../build/dist/odyssey/epithets.json', 'utf-8')) as EntityFormulas[];
const iliadFormulaCount = iliad.reduce((n, e) => n + e.formulas.length, 0);
const odysseyFormulaCount = odyssey.reduce((n, e) => n + e.formulas.length, 0);
const glossesFile: { status: 'draft' | 'reviewed' } = JSON.parse(readFileSync('../apparatus/formula-glosses.json', 'utf-8'));
const isDraft = glossesFile.status === 'draft';
const pageTitle = 'Formulas — The Homer Reader';
const metaDescription = 'A computed index of the repeated epithets and formulas attached to named figures in the Iliad and Odyssey.';
const canonical = Astro.site ? new URL(`${base}/formulas/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    /* Layout is the shared reference-page pattern (styles/edition-pages.css):
       title block, then the two poems as a pair of doors. */
    @media (min-width: 761px) { .idx-poems .pg-poem { min-height: 17rem; } }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Formulas" />
  <main class="pg formula-body">
    <header class="pg-head">
    <Crumbs />
    <h1 class="pg-title">Epithets &amp; formulas {isDraft && <span class="draft-badge" title="AI-drafted English glosses, pending review">Draft</span>}</h1>
    <p class="pg-intro formula-intro">Repeated phrases attached to named figures, set as two parallel ledgers for the two poems. Each Greek formula carries an English gloss and citations that open the corresponding verse in the reader.</p>
    </header>
    <div class="pg-poems idx-poems">
      <a class="pg-poem is-iliad formula-index-card" href={`${base}/formulas/iliad/`}>
        <span class="pg-poem-greek" lang="grc" aria-hidden="true">ΙΛΙΑΣ</span>
        <h2 class="pg-poem-title">Iliad</h2>
        <p class="pg-poem-meta">{iliad.length} named figures &middot; {iliadFormulaCount} formulas</p>
        <span class="pg-poem-art" aria-hidden="true" style={`--art:url('${base}/art/hero/iliad-480.webp');--art-2x:url('${base}/art/hero/iliad-sm.webp')`}></span>
      </a>
      <a class="pg-poem is-odyssey formula-index-card" href={`${base}/formulas/odyssey/`}>
        <span class="pg-poem-greek" lang="grc" aria-hidden="true">ΟΔΥΣΣΕΙΑ</span>
        <h2 class="pg-poem-title">Odyssey</h2>
        <p class="pg-poem-meta">{odyssey.length} named figures &middot; {odysseyFormulaCount} formulas</p>
        <span class="pg-poem-art" aria-hidden="true" style={`--art:url('${base}/art/hero/odyssey-480.webp');--art-2x:url('${base}/art/hero/odyssey-sm.webp')`}></span>
      </a>
    </div>
    <footer class="pg-note computed-note">Formula counts are computed automatically from the corpus by n-gram analysis; counts are exact.{isDraft && ' English glosses are draft translations, pending review.'}</footer>
  </main>
</body>
</html>
