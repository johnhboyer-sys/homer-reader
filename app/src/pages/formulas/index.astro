---
// Lightweight index for /formulas/ — links to the per-work ledgers at
// /formulas/iliad/ and /formulas/odyssey/. Split out (2026-07-17) because
// server-rendering English glosses under every formula occurrence (required
// for the no-JS SSR gate) pushed the combined single-page ledger well past
// its ~400KB budget; see FormulaLedger.astro and the two per-work pages for
// the actual content.
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface FormulaRef { book: number; line: number; }
interface Formula { text: string; lemmaKeys: string[]; count: number; refs: FormulaRef[]; }
interface EntityFormulas { entity: string; formulas: Formula[]; }

const iliad = JSON.parse(readFileSync('../build/dist/iliad/epithets.json', 'utf-8')) as EntityFormulas[];
const odyssey = JSON.parse(readFileSync('../build/dist/odyssey/epithets.json', 'utf-8')) as EntityFormulas[];
const iliadFormulaCount = iliad.reduce((n, e) => n + e.formulas.length, 0);
const odysseyFormulaCount = odyssey.reduce((n, e) => n + e.formulas.length, 0);
const glossesFile: { status: 'draft' | 'reviewed' } = JSON.parse(readFileSync('../apparatus/formula-glosses.json', 'utf-8'));
const isDraft = glossesFile.status === 'draft';
const pageTitle = 'Formulas — The Homer Reader';
const metaDescription = 'A computed index of the repeated epithets and formulas attached to named figures in the Iliad and Odyssey.';
const canonical = Astro.site ? new URL(`${base}/formulas/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    .formula-body { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem 4.5rem; color: var(--text); }
    h1 { font-family: var(--font-display); font-size: 1.95rem; font-weight: 400; line-height: 1.15; margin-bottom: .55rem; }
    .formula-intro { max-width: 45rem; color: var(--text-mid); font-size: .98rem; line-height: 1.62; }
    .formula-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; margin-top: 2rem; max-width: 45rem; }
    .formula-index-card { display: block; padding: 1.4rem 1.5rem; border: 1px solid var(--border); border-top: 2px solid var(--rule-strong); text-decoration: none; color: inherit; }
    .formula-index-card:hover { border-color: var(--accent); }
    .formula-index-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .formula-index-card h2 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; margin-bottom: .35rem; }
    .formula-index-card p { font-family: var(--font-ui); font-size: .78rem; color: var(--text-mid); }
    .computed-note { margin-top: 3rem; padding-top: .9rem; border-top: 1px solid var(--border); color: var(--text-mid); font-family: var(--font-ui); font-size: .73rem; }
    @media (max-width: 560px) { .formula-index { grid-template-columns: 1fr; } }
    @media (max-width: 480px) { h1 { font-size: 1.6rem; } }
  </style>
  <Pwa />
</head>
<body>
  <header class="simple-header">
    <div class="header-title"><a class="home-link" href={`${base}/`}>Homer</a><span class="title-sep">›</span><span class="header-static">Formulas</span></div>
    <nav class="header-actions" aria-label="Navigation"><a href={`${base}/`} class="search-link">All works</a><a href={`${base}/search`} class="search-link">Search</a><ThemeToggle /></nav>
  </header>
  <main class="formula-body">
    <h1>Epithets &amp; formulas {isDraft && <span class="draft-badge" title="AI-drafted English glosses, pending review">Draft</span>}</h1>
    <p class="formula-intro">Repeated phrases attached to named figures, set as two parallel ledgers for the two poems. Each Greek formula carries an English gloss and citations that open the corresponding verse in the reader.</p>
    <div class="formula-index">
      <a class="formula-index-card" href={`${base}/formulas/iliad/`}>
        <h2>Iliad</h2>
        <p>{iliad.length} named figures &middot; {iliadFormulaCount} formulas</p>
      </a>
      <a class="formula-index-card" href={`${base}/formulas/odyssey/`}>
        <h2>Odyssey</h2>
        <p>{odyssey.length} named figures &middot; {odysseyFormulaCount} formulas</p>
      </a>
    </div>
    <footer class="computed-note">Formula counts are computed automatically from the corpus by n-gram analysis; counts are exact.{isDraft && ' English glosses are draft translations, pending review.'}</footer>
  </main>
</body>
</html>
