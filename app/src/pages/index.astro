---
// The homepage: a monumental two-epic front door (docs/mocks-homepage-v1.5.html,
// John: "better for now"; docs/DESIGN.md "Homepage hero — v1.5 state"). No
// catalog cards — the corpus is exactly two works (SHELVES = one "The Epics"
// shelf, per shared/lib/works.ts), so a shelf/card browser was always a
// redundant middle step between the reader and a two-item list. This page IS
// the front door: a hero panel per epic, three "ways in", and a factual
// apparatus band.
import { readFileSync } from 'node:fs';
import { getWork, workPath, workLanding } from '@shared/lib/works';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Pwa from '../components/Pwa.astro';
import DoorCards from '../components/DoorCards.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read Homer’s Iliad and Odyssey with the original Greek and a facing' +
  ' English translation, side by side — with click-to-parse morphology,' +
  ' dictionary lookup, vulgate line citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;

const iliadWork = getWork('iliad');
const odysseyWork = getWork('odyssey');
const worksForLd = [iliadWork, odysseyWork].filter((w): w is NonNullable<typeof w> => Boolean(w));

const structuredData = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'The Homer Reader',
        alternateName: 'Homer in Greek & English',
        url: new URL(`${base}/`, Astro.site).href,
        description: homeDescription,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'The Iliad and the Odyssey',
        numberOfItems: worksForLd.length,
        itemListElement: worksForLd.map((w, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: w.title,
          url: new URL(`${base}${workLanding(w.id)}/`, Astro.site).href,
        })),
      },
    ]
  : null;

// ── Hero epigraphs + apparatus band, read straight off each book's own data
// (not hardcoded copy) so they can never drift from the corpus: the Greek
// line-1 text and the Book 1 scene/day apparatus. Minimal local shape — this
// page only ever reads book-01.json for the two epics, so it doesn't need the
// reader's full BookData/normalizeBookData machinery.
interface HomeBook {
  segments: { greek: { n: number; text: string }[] }[];
  apparatus?: {
    draft?: boolean;
    day?: string;
    scenes?: { lines: [number, number]; summary: string; location?: string }[];
  };
}
const iliadBook1: HomeBook = JSON.parse(readFileSync('public/data/iliad/book-01.json', 'utf-8'));
const odysseyBook1: HomeBook = JSON.parse(readFileSync('public/data/odyssey/book-01.json', 'utf-8'));
const iliadGreekLine1 = iliadBook1.segments[0].greek[0].text;
const odysseyGreekLine1 = odysseyBook1.segments[0].greek[0].text;

const scene1 = iliadBook1.apparatus?.scenes?.[0];
const sceneRef = scene1 ? `1.${scene1.lines[0]}–${scene1.lines[1]}` : '';
const sceneLabel = scene1?.location ? scene1.location[0].toUpperCase() + scene1.location.slice(1) : '';
const sceneSummary = scene1?.summary ?? '';
const sceneDraft = iliadBook1.apparatus?.draft === true;

const [dayStart, dayTotal] = (iliadBook1.apparatus?.day ?? '').split('-');
const dayLabel = dayStart && dayTotal ? `Day ${dayStart} of ${dayTotal}` : '';

// ── Routes. Every href below resolves to a real, working page in this build.
const iliadBook1Href = `${base}${workPath('iliad', 1)}`;
const odysseyBook1Href = `${base}${workPath('odyssey', 1)}`;
const odyssey9ReadingHref = `${base}${workPath('odyssey', 9)}?mode=reading`;
// `tour=parse` arms the one-time 5-step parse-popup walkthrough
const iliadScholarHref = `${base}${workPath('iliad', 1)}?mode=scholar&tour=parse`;
const startHref = `${base}/start/`;
const aboutHref = `${base}/about`;
const iliadLandingHref = `${base}${workLanding('iliad')}`;
const odysseyLandingHref = `${base}${workLanding('odyssey')}`;
const searchHref = `${base}/search`;
const genealogiesHref = `${base}/genealogies/`;
const mapsHref = `${base}/maps/`;
const timelineHref = `${base}/timeline/`;
const charactersHref = `${base}/characters/`;
const placesHref = `${base}/places/`;
const vocabularyHref = `${base}/vocabulary/`;
const formulasHref = `${base}/formulas/`;
const repetitionsHref = `${base}/repetitions/`;
const attributionHref = `${base}/attribution`;
const supportHref = `${base}/support`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- TODO: register this property in Google Search Console and add its
       verification token here (a sibling reader's token was intentionally
       removed from this file — it belongs to a different GSC property). -->
  <ThemeInit />
  <title>The Homer Reader — The Iliad &amp; Odyssey in Greek &amp; English</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Homer Reader — The Iliad & Odyssey in Greek & English" />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="The Homer Reader — The Iliad & Odyssey in Greek & English" />
  <meta name="twitter:description" content={homeDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {structuredData && structuredData.map((sd) => (
    <script type="application/ld+json" set:html={jsonLdSafe(sd)} />
  ))}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Pwa />
</head>
<body>
  <CommandPalette client:load />
  <h1 class="sr-only">The Homer Reader — The Iliad &amp; Odyssey in Greek &amp; English</h1>

  <SiteHeader />

  <section class="hero" aria-label="The two epics">
    <a class="epic epic-iliad" href={iliadBook1Href} aria-label="Read the Iliad, beginning at Book 1">
      <div class="epic-text">
        <span class="epic-greek-sub" lang="grc">ΙΛΙΑΣ</span>
        <h2 class="epic-title">The Iliad</h2>
        <span class="epic-epigraph">
          <span class="gk" lang="grc">{iliadGreekLine1}</span>
          <span class="gloss">Sing, goddess, the wrath of Peleus&rsquo; son Achilles</span>
        </span>
        <span class="epic-argument">The wrath of Achilles, and what it costs the Greeks outside the walls of Troy.</span>
        <span class="epic-foot">
          <span class="epic-cta">Read Book 1 <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true"><path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="epic-kicker">24 books &middot; the war&rsquo;s tenth year</span>
        </span>
      </div>
      <!-- Flaxman's frieze sits under the text, in its own band: never behind a word. -->
      <span class="epic-art" aria-hidden="true" style={`--art:url('${base}/art/hero/iliad.webp')`}></span>
    </a>

    <a class="epic epic-odyssey" href={odysseyBook1Href} aria-label="Read the Odyssey, beginning at Book 1">
      <div class="epic-text">
        <span class="epic-greek-sub" lang="grc">ΟΔΥΣΣΕΙΑ</span>
        <h2 class="epic-title">The Odyssey</h2>
        <span class="epic-epigraph">
          <span class="gk" lang="grc">{odysseyGreekLine1}</span>
          <span class="gloss">Tell me, Muse, of the man of many turns, who wandered far</span>
        </span>
        <span class="epic-argument">The long way home &mdash; ten years, one man, and every disguise it took to survive it.</span>
        <span class="epic-foot">
          <span class="epic-cta">Read Book 1 <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true"><path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="epic-kicker">24 books &middot; ten years&rsquo; wandering</span>
        </span>
      </div>
      <span class="epic-art" aria-hidden="true" style={`--art:url('${base}/art/hero/odyssey.webp')`}></span>
    </a>
  </section>

  <main class="wrap">

    <DoorCards hrefs={[odyssey9ReadingHref, iliadScholarHref, mapsHref]} eyebrow="Three ways in" />

    <section class="apparatus-section" aria-label="What this edition adds">
      <p class="section-eyebrow">What the edition adds</p>
      <div class="apparatus-grid">
        <div class="app-item">
          <h3>Scene by scene</h3>
          <p>Every book broken into its scenes, with a one-line gloss for each.</p>
          {scene1 && (
            <div class="mini-scene-chip">
              <span class="ref">{sceneRef}{sceneLabel && ` · ${sceneLabel}`}</span>
              <p>{sceneSummary}</p>
              {sceneDraft && <span class="draft-badge">Draft</span>}
            </div>
          )}
        </div>
        <div class="app-item">
          <h3>The calendar</h3>
          <p>Every book keyed to its day in the poem&rsquo;s own reckoning of time.</p>
          {dayLabel && (
            <div class="mini-day-marker">
              <span class="pin" aria-hidden="true"></span>
              <span class="label">{dayLabel}</span>
            </div>
          )}
        </div>
        <div class="app-item">
          <h3>Maps, honestly marked</h3>
          <p>Every place plotted; identifications graded by how sure the tradition is.</p>
          <div class="mini-tier-legend">
            <span class="item"><span class="mark certain" aria-hidden="true"></span>certain</span>
            <span class="item"><span class="mark traditional" aria-hidden="true"></span>traditional</span>
            <span class="item"><span class="mark speculative" aria-hidden="true"></span>speculative</span>
            <span class="item"><span class="mark mythical" aria-hidden="true"></span>mythical</span>
          </div>
        </div>
        <div class="app-item">
          <h3>Two lexicons</h3>
          <p>LSJ and Cunliffe, from any Greek word, without leaving the page.</p>
          <div class="mini-lex-tabs">
            <span class="active">LSJ</span>
            <span>Cunliffe</span>
          </div>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <span>Greek text: Perseus (CC BY-SA)</span>
      <span class="footer-sep" aria-hidden="true">&middot;</span>
      <span>Translations: public domain (Murray, Butler, Pope)</span>
      <span class="footer-sep" aria-hidden="true">&middot;</span>
      <a href={attributionHref}>Texts &amp; Licences</a>
    </footer>
    <nav class="home-foot">
      <a href={startHref}>Start Here</a>
      <span aria-hidden="true">&middot;</span>
      <a href={aboutHref}>About</a>
      <span aria-hidden="true">&middot;</span>
      <a href={supportHref}>Support</a>
      <span aria-hidden="true">&middot;</span>
      <button id="feedback-btn">Request a Feature / Report an Error</button>
    </nav>
  </main>

  <!-- Feedback modal -->
  <div id="feedback-modal" role="dialog" aria-modal="true" aria-labelledby="fb-title" tabindex="-1">
    <div class="fb-box">
      <h2 id="fb-title">Request a Feature / Report an Error</h2>
      <div class="fb-type">
        <label><input type="radio" name="fb-type" value="feature" checked /> Feature request</label>
        <label><input type="radio" name="fb-type" value="bug" /> Bug / error report</label>
      </div>
      <textarea id="fb-message" placeholder="Describe the feature or error…"></textarea>
      <div class="fb-actions">
        <button class="fb-cancel" id="fb-cancel">Cancel</button>
        <button class="fb-submit" id="fb-submit">Send</button>
      </div>
    </div>
  </div>

  <style>
    /* ================= layout shell ================= */
    .wrap {
      max-width: 82rem;
      margin: 0 auto;
      padding: 0 var(--space-5);
    }

    /* ================= HERO =================
       Two panels, one per poem, dark in both themes: the Iliad lit from below
       by the watchfires on the plain (Il. 8.553-65), the Odyssey by a night
       sky over open water. The colour does that work on its own, as two
       soft gradients; nothing is drawn behind the words. Each panel is its
       text, then Flaxman's frieze in a band of its own underneath.
       --hero-* are local to the hero and do not change with the theme. */
    .hero {
      --hero-ink: #F6F0E4;
      --hero-ink-soft: #D5CABB;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #14101A;
    }
    .epic {
      position: relative;
      display: flex;
      flex-direction: column;
      min-width: 0;
      color: var(--hero-ink);
      text-decoration: none;
      overflow: hidden;
      isolation: isolate;
    }
    .epic-iliad {
      --hero-accent: #F0B28A;
      background:
        radial-gradient(120% 70% at 30% 118%, rgba(214, 106, 46, 0.62) 0%, rgba(160, 62, 30, 0.28) 38%, rgba(160, 62, 30, 0) 68%),
        linear-gradient(180deg, #1B1218 0%, #261419 52%, #32171A 100%);
    }
    .epic-odyssey {
      --hero-accent: #A9D6E8;
      background:
        radial-gradient(110% 75% at 78% -18%, rgba(74, 142, 176, 0.55) 0%, rgba(40, 96, 130, 0.25) 40%, rgba(40, 96, 130, 0) 70%),
        linear-gradient(180deg, #0F2434 0%, #0E2030 55%, #0B1826 100%);
      border-left: 1px solid rgba(246, 240, 228, 0.14);
    }
    .epic-text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: clamp(2rem, 3.6vw, 3.25rem) var(--space-5) 0 var(--hero-pad);
    }
    /* The Iliad's text starts on the header's left edge. */
    .epic { --hero-pad: clamp(1.5rem, 4.5vw, 4.5rem); }
    .epic-iliad { --hero-pad: max(var(--space-5), calc((100vw - 82rem) / 2 + var(--space-5))); }
    .epic-greek-sub {
      font-family: var(--font-greek);
      font-size: 0.9375rem;
      letter-spacing: 0.34em;
      color: var(--hero-accent);
    }
    .epic-title {
      margin: 0.5rem 0 0 -0.04em;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(3.25rem, 6vw, 5.75rem);
      line-height: 0.98;
      letter-spacing: -0.022em;
      color: var(--hero-ink);
    }
    .epic-epigraph { display: block; margin-top: clamp(1.25rem, 2.2vw, 2rem); }
    .epic-epigraph .gk {
      display: block;
      font-family: var(--font-greek);
      font-size: clamp(1.25rem, 1.6vw, 1.625rem);
      line-height: 1.3;
      color: var(--hero-ink);
      text-wrap: balance;
    }
    @media (min-width: 1200px) { .epic-epigraph .gk { white-space: nowrap; } }
    .epic-epigraph .gloss {
      display: block;
      margin-top: 0.4rem;
      font-family: var(--font-english);
      font-style: italic;
      font-size: 1.0625rem;
      line-height: 1.4;
      color: var(--hero-ink-soft);
    }
    .epic-argument {
      display: block;
      margin-top: 1.25rem;
      max-width: 30rem;
      font-family: var(--font-english);
      font-size: 1.125rem;
      line-height: 1.5;
      color: var(--hero-ink-soft);
    }
    .epic-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.25rem;
      margin-top: 1.75rem;
    }
    .epic-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      height: 2.875rem;
      padding: 0 1.375rem;
      border-radius: var(--radius-pill);
      background: var(--hero-ink);
      color: #1F1A17;
      font: 600 0.9375rem/1 var(--font-ui);
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .epic-cta svg { transition: transform 0.15s ease; }
    .epic:hover .epic-cta { background: #fff; }
    .epic:hover .epic-cta svg { transform: translateX(3px); }
    .epic-kicker {
      font: 500 0.8125rem/1.3 var(--font-ui);
      color: var(--hero-ink-soft);
    }
    .epic:focus-visible { outline: 3px solid var(--hero-accent); outline-offset: -3px; }
    .epic-art {
      display: block;
      flex: 1 0 auto;
      height: clamp(7.5rem, 12vw, 10.5rem);
      margin: clamp(1.25rem, 2vw, 1.75rem) var(--space-5) 0 var(--hero-pad);
      background: var(--hero-accent);
      opacity: 0.5;
      -webkit-mask: var(--art) left bottom / contain no-repeat;
      mask: var(--art) left bottom / contain no-repeat;
    }
    .epic-odyssey .epic-art { -webkit-mask-position: left bottom; mask-position: left bottom; }
    @media (prefers-reduced-motion: reduce) {
      .epic-cta, .epic-cta svg { transition: none; }
    }
    @media (max-width: 760px) {
      /* Both poems in the first screen of a phone: the argument and the
         frieze give way, the opening line stays. */
      .hero { grid-template-columns: 1fr; }
      .epic-odyssey { border-left: 0; border-top: 1px solid rgba(246, 240, 228, 0.14); }
      .epic-text { padding: 1.5rem var(--space-4) 1.5rem; }
      .epic-greek-sub { font-size: 0.75rem; }
      .epic-title { font-size: 2.75rem; margin-top: 0.25rem; }
      .epic-epigraph { margin-top: 0.75rem; }
      .epic-epigraph .gk { font-size: 1.1875rem; }
      .epic-epigraph .gloss { font-size: 0.9375rem; }
      .epic-argument, .epic-art { display: none; }
      .epic-foot { margin-top: 1rem; }
      .epic-cta { height: 2.75rem; }
    }

    /* ================= WHAT THE EDITION ADDS ================= */
    .section-eyebrow {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: var(--step-3);
      line-height: 1.1;
      letter-spacing: -0.015em;
      color: var(--text);
      margin: 0 0 var(--space-5);
    }
    .apparatus-section { padding: var(--space-6) 0 var(--space-7); border-top: 1px solid var(--border); }
    .apparatus-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
    @media (max-width: 900px) { .apparatus-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) { .apparatus-grid { grid-template-columns: 1fr; gap: var(--space-5); } }
    .app-item h3 {
      font: 600 0.9375rem/1.3 var(--font-ui);
      color: var(--text);
      margin: 0 0 0.375rem;
    }
    .app-item p {
      font-family: var(--font-english);
      font-size: 1.0625rem;
      line-height: 1.5;
      color: var(--text-mid);
      margin: 0;
    }
    .mini-scene-chip, .mini-day-marker, .mini-tier-legend, .mini-lex-tabs {
      margin-top: var(--space-4);
      padding: 0.75rem 0.875rem;
      background: var(--col-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-2);
    }
    .mini-scene-chip .ref {
      display: block;
      font: 600 0.75rem/1.3 var(--font-ui);
      color: var(--accent);
      font-variant-numeric: tabular-nums;
      margin-bottom: 0.25rem;
    }
    .mini-scene-chip p { font-size: 0.9375rem; line-height: 1.4; color: var(--text); }
    .mini-scene-chip .draft-badge { margin-top: 0.5rem; }
    .mini-day-marker { display: flex; align-items: center; gap: 0.625rem; }
    .mini-day-marker .pin {
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    .mini-day-marker span.label { font: 600 0.8125rem/1 var(--font-ui); color: var(--text); font-variant-numeric: tabular-nums; }
    .mini-tier-legend {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 0.75rem;
      font: 500 0.8125rem/1 var(--font-ui);
      color: var(--text-mid);
    }
    .mini-tier-legend .item { display: flex; align-items: center; gap: 0.5rem; }
    .mini-tier-legend .mark { width: 9px; height: 9px; flex: none; }
    .mini-tier-legend .mark.certain { border-radius: 50%; background: var(--text); }
    .mini-tier-legend .mark.traditional { border-radius: 50%; border: 1.5px solid var(--text); background: transparent; }
    .mini-tier-legend .mark.speculative { border-radius: 50%; border: 1.5px dashed var(--text-mid); background: transparent; }
    .mini-tier-legend .mark.mythical { border: 1.5px solid var(--text-mid); transform: rotate(45deg); width: 7px; height: 7px; }
    .mini-lex-tabs { display: flex; gap: 1.25rem; font: 600 0.8125rem/1 var(--font-ui); }
    .mini-lex-tabs span { color: var(--text-mid); padding-bottom: 0.375rem; border-bottom: 2px solid transparent; }
    .mini-lex-tabs span.active { color: var(--accent); border-bottom-color: var(--accent); }

    /* ================= FOOTER ================= */
    .home-foot {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.25rem 0.75rem;
      padding: 0 0 var(--space-7);
      font: 500 0.875rem/1.4 var(--font-ui);
      color: var(--text-light);
    }
    .home-foot a { color: var(--text-mid); text-decoration: none; padding: 0.5rem 0.25rem; }
    .home-foot a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; }
    .home-foot button {
      background: none; border: none; padding: 0.5rem 0.25rem; cursor: pointer;
      font: inherit; color: var(--text-mid);
    }
    .home-foot button:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; }
    /* Feedback modal (unchanged mechanism, kept from the prior homepage — no
       other page hosts a bug/feature-report entry point). */
    #feedback-modal {
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,.45); align-items: center; justify-content: center;
    }
    #feedback-modal.open { display: flex; }
    .fb-box {
      background: var(--page-bg); border: 1px solid var(--border);
      border-radius: 8px; padding: 1.75rem 2rem; width: min(440px, 90vw);
      font-family: var(--font-ui); box-shadow: 0 8px 32px rgba(0,0,0,.18);
    }
    .fb-box h2 {
      margin: 0 0 1.1rem; font-size: 1rem; font-weight: 600; color: var(--text);
    }
    .fb-type { display: flex; gap: 1.25rem; margin-bottom: 1rem; }
    .fb-type label { display: flex; align-items: center; gap: .4rem; cursor: pointer;
      font-size: .875rem; color: var(--text); }
    .fb-box textarea {
      width: 100%; box-sizing: border-box; min-height: 110px; resize: vertical;
      border: 1px solid var(--border); border-radius: 4px; padding: .6rem .75rem;
      font-family: var(--font-ui); font-size: .875rem;
      background: var(--page-bg); color: var(--text);
    }
    .fb-box textarea:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .fb-actions { display: flex; justify-content: flex-end; gap: .6rem; margin-top: .9rem; }
    .fb-cancel {
      background: none; border: 1px solid var(--border); border-radius: 4px;
      padding: .4rem .9rem; cursor: pointer; font: inherit; font-size: .85rem;
      color: var(--text-mid);
    }
    .fb-cancel:hover { border-color: var(--text-mid); }
    .fb-submit {
      background: var(--accent); color: var(--on-accent); border: none; border-radius: 4px;
      padding: .4rem 1rem; cursor: pointer; font: inherit; font-size: .85rem;
      font-weight: 600;
    }
    .fb-submit:hover { opacity: .88; }
    .fb-submit:disabled { opacity: .45; cursor: default; }
  </style>

  <script>
    const modal = document.getElementById('feedback-modal')!;
    const openBtn = document.getElementById('feedback-btn')!;
    const cancelBtn = document.getElementById('fb-cancel')!;
    const submitBtn = document.getElementById('fb-submit')!;
    const textarea = document.getElementById('fb-message') as HTMLTextAreaElement;
    let feedbackTrigger: HTMLElement | null = null;

    const open = (e?: Event) => {
      feedbackTrigger = e?.currentTarget instanceof HTMLElement ? e.currentTarget : null;
      modal.classList.add('open');
      textarea.value = '';
      textarea.focus();
    };
    const close = () => {
      modal.classList.remove('open');
      feedbackTrigger?.focus();
      feedbackTrigger = null;
    };

    openBtn.addEventListener('click', open);
    cancelBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('open')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const els = Array.from(modal.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )).filter((el) => !el.hasAttribute('disabled') && el.tabIndex !== -1);
      if (els.length === 0) {
        e.preventDefault();
        modal.focus();
        return;
      }
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    submitBtn.addEventListener('click', () => {
      const msg = textarea.value.trim();
      if (!msg) return;
      const type = (document.querySelector('input[name="fb-type"]:checked') as HTMLInputElement).value;
      const subject = type === 'feature'
        ? 'Homer Reader: Feature Request'
        : 'Homer Reader: Bug Report';
      window.location.href =
        `mailto:jhboyer@loyno.edu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(msg)}`;
      close();
    });
  </script>
</body>
</html>
