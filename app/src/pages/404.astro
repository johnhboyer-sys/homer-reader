---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Pwa from '../components/Pwa.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Page Not Found — Homer Reader';
const metaDescription =
  "The requested Homer Reader page could not be found. Return to the corpus or search the Iliad and the Odyssey.";
const canonical = Astro.site ? new URL(`${base}/404/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Homer Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="noindex,follow" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Pwa />
</head>
<body>
  <div class="theme-corner"><ThemeToggle /></div>
  <main class="not-found">
    <p class="eyebrow">Homer</p>
    <figure class="goatstag">
      <svg viewBox="0 0 200 200" role="img" aria-labelledby="wave-title"
           fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <title id="wave-title">A wandering course across the wine-dark sea</title>
        <rect x="20" y="20" width="160" height="160"/>
        <path d="M28,70 C55,55 65,85 92,70 S130,55 150,70 S180,85 172,70" opacity=".55"/>
        <path d="M28,110 C55,95 65,125 92,110 S130,95 150,110 S180,125 172,110" opacity=".55"/>
        <path d="M28,150 C55,135 65,165 92,150 S130,135 150,150 S180,165 172,150" opacity=".55"/>
      </svg>
      <figcaption><span lang="grc">νόστος</span> · homecoming (the <em>Odyssey</em>'s long way back)</figcaption>
    </figure>
    <h1><span lang="grc">Οὖτις</span> lives here.</h1>
    <p class="lede">"Who took your page?" the neighbors shouted. "Nobody!" we cried —
      and, exactly as it went for the Cyclops, no further help arrived
      (<a href={`${base}/odyssey/book/9?loc=9.366`}><em>Od.</em> 9.366ff.</a>).</p>
    <p class="lede">Ten years, one angry sea-god, and every crewman lost to a 404 of his own
      — and Odysseus still made it home. So can you.</p>
    <div class="actions">
      <a class="btn-primary" href={`${base}/`}>Back to the corpus</a>
      <a class="btn-secondary" href={`${base}/search`}>Search</a>
    </div>
  </main>

  <style>
    body { background: var(--page-bg); color: var(--text); margin: 0; }
    .theme-corner { position: fixed; top: 1rem; right: 1rem; z-index: 10; }
    .not-found {
      max-width: 44rem;
      margin: 0 auto;
      padding: clamp(3.5rem, 12vh, 8rem) 1.5rem 4rem;
      text-align: center;
    }
    .eyebrow { font: 600 var(--step--1)/1.3 var(--font-ui); color: var(--accent); margin: 0 0 var(--space-5); }
    h1 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(2.75rem, 8vw, 4.75rem);
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--text);
      margin: 0 0 var(--space-5);
    }
    h1 [lang="grc"] { font-family: var(--font-greek); letter-spacing: 0; }
    .lede {
      font-family: var(--font-english);
      color: var(--text-mid);
      font-size: var(--step-1);
      line-height: 1.55;
      margin: 0 0 var(--space-4);
      text-wrap: pretty;
    }
    .lede a { color: var(--accent); text-underline-offset: 0.2em; }
    /* The wave is the sea: it takes the Odyssey's colour from the token block. */
    .goatstag { margin: 0 0 var(--space-5); color: var(--odyssey); }
    .goatstag svg { width: clamp(150px, 30vw, 200px); height: auto; }
    .goatstag figcaption { font-family: var(--font-english); font-size: 1rem; color: var(--text-mid); margin-top: 0.75rem; }
    .goatstag figcaption [lang="grc"] { font-family: var(--font-greek); font-size: 1.125rem; color: var(--text); }
    .actions { display: flex; gap: 0.625rem; justify-content: center; flex-wrap: wrap; margin-top: var(--space-6); }
    .btn-primary, .btn-secondary {
      display: inline-flex;
      align-items: center;
      min-height: 2.875rem;
      padding: 0 1.375rem;
      border-radius: var(--radius-pill);
      font: 600 0.9375rem/1 var(--font-ui);
      text-decoration: none;
    }
    .btn-primary { background: var(--accent); border: 1px solid var(--accent); color: var(--on-accent); }
    .btn-primary:hover { filter: brightness(1.1); }
    .btn-secondary { border: 1px solid var(--rule-strong); color: var(--text); }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
    .btn-primary:focus-visible, .btn-secondary:focus-visible, .lede a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  </style>
</body>
</html>
