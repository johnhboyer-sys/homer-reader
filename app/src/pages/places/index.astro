---
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Crumbs from '../../components/Crumbs.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import '@shared/styles/global.css';
import '../../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Work = 'iliad' | 'odyssey';
type Certainty = 'certain' | 'traditional' | 'speculative' | 'mythical';

interface Mention {
  work: Work;
  book: number;
  lines: number[];
}

interface Place {
  id: string;
  name: string;
  greek: string;
  certainty: Certainty;
  tradition?: string;
  coords?: [number, number];
  pleiades?: string;
  maps: string[];
  note: string;
  mentions: Mention[];
}

type PlacesFile = { status?: 'draft' | 'reviewed'; places: Place[] } | Place[];

const placesFile = JSON.parse(readFileSync('../apparatus/places.json', 'utf-8')) as PlacesFile;
const places = (Array.isArray(placesFile) ? placesFile : placesFile.places)
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name, 'en'));
const isDraft = !Array.isArray(placesFile) && placesFile.status === 'draft';

// 274 places sorted alphabetically is a wall without a scan affordance — group
// by initial letter (same jump-nav idiom as /genealogies/'s .gen-jump) so the
// list is scannable and deep-linkable without JS.
type PlaceRow = { kind: 'letter'; letter: string } | { kind: 'place'; place: Place };
const placeRows: PlaceRow[] = [];
let lastLetter = '';
for (const place of places) {
  const letter = place.name.charAt(0).toUpperCase();
  if (letter !== lastLetter) {
    placeRows.push({ kind: 'letter', letter });
    lastLetter = letter;
  }
  placeRows.push({ kind: 'place', place });
}
const letters = placeRows
  .filter((row): row is { kind: 'letter'; letter: string } => row.kind === 'letter')
  .map((row) => row.letter);
const pageTitle = 'Places — The Homer Reader';
const metaDescription = 'A gazetteer of places in the Iliad and Odyssey, with Greek names, notes, and anchoring passages.';
const canonical = Astro.site ? new URL(`${base}/places/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
const workLabel = (work: Work) => work === 'iliad' ? 'Il.' : 'Od.';
const citationText = (mention: Mention) => {
  const firstLine = mention.lines[0];
  const lastLine = mention.lines[mention.lines.length - 1];
  return `${workLabel(mention.work)} ${mention.book}.${firstLine}${lastLine !== firstLine ? `–${lastLine}` : ''}`;
};
const citationHref = (mention: Mention) => `${base}/${mention.work}/book/${mention.book}?loc=${mention.book}.${mention.lines[0]}`;
const citationLabel = (mention: Mention) => `${mention.work === 'iliad' ? 'Iliad' : 'Odyssey'} ${mention.book}.${mention.lines[0]}${mention.lines[mention.lines.length - 1] !== mention.lines[0] ? ` to ${mention.lines[mention.lines.length - 1]}` : ''}`;
const certaintyTiers: Certainty[] = ['certain', 'traditional', 'speculative', 'mythical'];

// Two ways on from an entry, both to pages that exist: the map the place is
// drawn on (the /maps/ tab ids, MapsPage.svelte's TABS; the two plates take a
// focus), and a search of the Greek for the name in any form (a one-word
// name only: the search box reads several words as several terms).
const MAP_TAB: Record<string, string> = {
  ships: 'ships', troad: 'troad', 'troad-plain': 'plain', wanderings: 'wanderings', greece: 'greece', journeys: 'journeys',
};
const mapHref = (place: Place) => {
  const tab = place.maps.map((m) => MAP_TAB[m]).find(Boolean);
  if (!tab) return null;
  const focus = tab === 'plain' || tab === 'troad' ? `&focus=${encodeURIComponent(place.id)}` : '';
  return `${base}/maps/?map=${tab}${focus}`;
};
const searchHref = (place: Place) =>
  place.greek && !/\s/.test(place.greek.trim()) ? `${base}/search?g=${encodeURIComponent(place.greek.trim())}` : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    body { overflow-x: hidden; max-width: 100%; }
    /* The certainty legend doubles as the filter; on a phone it sits on its
       own line under the search field instead of jamming a heading. */
    .places-tools { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); padding-bottom: var(--space-5); }
    .places-tools h2 { font: 600 var(--step--1)/1 var(--font-ui); color: var(--text-mid); }
    .places-tools .pg-find { flex: 1 1 16rem; max-width: 22rem; }
    .places-legend { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
    .places-legend .pg-chip { text-transform: capitalize; }
    @media (max-width: 760px) {
      .places-tools .pg-find { flex-basis: 100%; max-width: none; }
      .places-legend { width: 100%; }
      .places-legend .pg-chips { gap: 0.375rem; }
      .places-legend .pg-chip { padding: 0 0.75rem; }
    }
  </style>
  <Pwa />
  <!-- The filter field needs script; without it the page is the full list. -->
  <noscript><style is:inline>.pg-js { display: none !important; }</style></noscript>
</head>
<body>
  <SiteHeader section="Places" />
  <main class="pg places-body">
    <header class="pg-head">
      <Crumbs />
      <h1 class="pg-title">Places {isDraft && <span class="draft-badge" title="AI-drafted English glosses, pending review">Draft</span>}</h1>
      <p class="pg-intro places-intro">A gazetteer for the Iliad and Odyssey. Each entry cites its anchoring passage(s); these curated citations are not an exhaustive concordance.</p>
    </header>
    <div class="places-tools">
      <label class="pg-find pg-js">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="6.8" cy="6.8" r="4.6"/><line x1="10.4" y1="10.4" x2="14" y2="14"/></svg>
        <input type="search" id="places-find" placeholder="Find a place" autocomplete="off" spellcheck="false" aria-label="Find a place by name" />
      </label>
      <aside class="places-legend" aria-labelledby="certainty-legend">
        <h2 id="certainty-legend">Certainty</h2>
        <ul class="pg-chips">
          {certaintyTiers.map((tier) => <li><button type="button" class="pg-chip" data-tier={tier} aria-pressed="false"><span class="pg-tier certainty-label" data-certainty={tier}>{tier}</span></button></li>)}
        </ul>
      </aside>
      <span class="pg-count" id="places-count" aria-live="polite"></span>
    </div>
    <nav class="pg-bar" aria-label="Jump to a letter">
      <div class="pg-jump places-jump">
        {letters.map((letter) => <a href={`#letter-${letter}`} data-letter={letter}>{letter}</a>)}
      </div>
    </nav>
    <ol class="pg-rows places-list" id="places-list">
      {placeRows.map((row) => row.kind === 'letter' ? (
        <li class="pg-letter place-letter" data-letter={row.letter}><h2 id={`letter-${row.letter}`}>{row.letter}</h2></li>
      ) : (
        <li class="pg-entry place-entry" id={`place-${row.place.id}`} data-name={row.place.name} data-tier={row.place.certainty} data-letter={row.place.name.charAt(0).toUpperCase()}>
          <div class="place-heading">
            <h3 class="pg-entry-name">{row.place.name}</h3>
            <span class="pg-entry-greek place-greek" lang="grc">{row.place.greek}</span>
            <p class="pg-entry-mark"><span class="pg-tier certainty-label" data-certainty={row.place.certainty}>{row.place.certainty}</span></p>
          </div>
          <div class="pg-entry-body">
            <p class="place-note">{row.place.note}</p>
            {row.place.tradition && <p class="is-minor place-tradition"><strong>Tradition:</strong> {row.place.tradition}</p>}
            <div class="pg-cites place-links">
              {row.place.pleiades && <a class="pg-cite" href={row.place.pleiades} target="_blank" rel="noopener">Pleiades</a>}
              {row.place.mentions.map((mention) => <a class="pg-cite" href={citationHref(mention)} aria-label={citationLabel(mention)}>{citationText(mention)}</a>)}
            </div>
            {(mapHref(row.place) || searchHref(row.place)) && (
              <p class="pg-onward">
                {mapHref(row.place) && <a href={mapHref(row.place)} aria-label={`${row.place.name} on the map`}>On the map</a>}
                {searchHref(row.place) && <a href={searchHref(row.place)} aria-label={`Search the Greek text for ${row.place.name}`}>Every mention in the Greek</a>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
    <p class="pg-empty" id="places-empty" hidden>No place matches.</p>
  </main>
  <script>
    import { wireIndexFilter } from '../../lib/index-filter';
    wireIndexFilter({ list: 'places-list', input: 'places-find', count: 'places-count', empty: 'places-empty', chips: '.places-legend [data-tier]', chipKey: 'tier' });
  </script>
</body>
</html>
