---
// The Start Here funnel (PROMPT.md Phase 5, lines 156-168): a dedicated,
// linkable/shareable landing page for the three doors the homepage hero also
// offers directly. The homepage's doors point straight at their destinations
// (no reason to make an in-site visitor click through an extra page); this
// page exists as the funnel's own stable URL for OUTSIDE links — SEO pages,
// social, outreach — per CLAUDE.md "the tie-in is structural (Start Here
// funnel + SEO pages)". Same simple-header + <main> pattern as
// genealogies/maps/attribution/support (this is a reference/wayfinding page,
// not a ReaderShell page).
import ThemeInit from '../../components/ThemeInit.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import DoorCards from '../../components/DoorCards.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import { workPath } from '@shared/lib/works';
import '@shared/styles/global.css';
import '../../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The three doors are the shared DoorCards component (labels + copy canonical
// there, unified with the homepage — punch-list #10). Only the destinations
// differ per surface.
const doorHrefs: [string, string, string] = [
  `${base}${workPath('odyssey', 9)}?mode=reading`,
  `${base}${workPath('iliad', 1)}?mode=scholar`,
  `${base}/maps/`,
];

const pageTitle = 'Start Here — The Homer Reader';
const metaDescription =
  'Three ways into the Homer Reader: begin in the middle of the action with the Odyssey, ' +
  'read along in the Greek with parse popups, or start with the maps — free, no account required.';
const canonical = Astro.site ? new URL(`${base}/start/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Homer Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit greek="caps" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    body { overflow-x: hidden; max-width: 100%; }
    /* The funnel's title panel: one dark band that carries both poems' grounds
       from the home page (Iliad ember low on the left, Odyssey sea high on the
       right), so an outside visitor lands on the same edition the home page
       shows. Colours are the home hero's, local until they are tokens. */
    .start-hero {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      color: var(--hero-ink);
      background:
        radial-gradient(70% 90% at 8% 130%, color-mix(in srgb, var(--hero-iliad-glow) 55%, transparent) 0%, color-mix(in srgb, var(--hero-iliad-ember) 22%, transparent) 40%, transparent 70%),
        radial-gradient(60% 90% at 96% -30%, color-mix(in srgb, var(--hero-odyssey-glow) 50%, transparent) 0%, color-mix(in srgb, var(--hero-odyssey-deep) 22%, transparent) 42%, transparent 72%),
        var(--hero-both-night);
    }
    .start-hero-inner {
      position: relative;
      max-width: 82rem;
      margin: 0 auto;
      padding: clamp(2.5rem, 10vh, 6.5rem) var(--space-5) clamp(2.5rem, 9vh, 6rem);
    }
    .start-eyebrow { font-family: var(--font-greek); font-size: 0.875rem; letter-spacing: 0.34em; color: var(--hero-iliad-accent); margin: 0 0 1rem; }
    .start-eyebrow span + span { color: var(--hero-odyssey-accent); margin-left: 1.25rem; }
    h1 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(3.25rem, 7.5vw, 6rem);
      line-height: 0.98;
      letter-spacing: -0.025em;
      margin: 0 0 0 -0.03em;
      color: var(--hero-ink);
    }
    .start-intro {
      max-width: 36rem;
      font-family: var(--font-english);
      font-size: clamp(1.25rem, 1.8vw, 1.5rem);
      line-height: 1.45;
      color: var(--hero-ink);
      margin: 1.5rem 0 0;
      text-wrap: pretty;
    }
    .start-art {
      position: absolute;
      right: var(--space-5);
      bottom: 0;
      width: min(42%, 34rem);
      height: 82%;
      background: var(--hero-odyssey-accent);
      opacity: 0.4;
      -webkit-mask: var(--art) right bottom / contain no-repeat;
      mask: var(--art) right bottom / contain no-repeat;
      z-index: -1;
    }
    /* The drawing at its display size (at most 544 CSS px wide): 560px, the
       720px cut on a high-density screen. */
    @media (-webkit-min-device-pixel-ratio: 1.5), (min-resolution: 1.5dppx) {
      .start-art { -webkit-mask-image: var(--art-2x); mask-image: var(--art-2x); }
    }
    /* Door-card styles live in the shared DoorCards.astro component (#10);
       this page only sets the column they sit in. */
    .start-body { padding-bottom: var(--space-7); }
    /* On this page the three doors are the whole body, so they run a size up
       from the home page's. */
    .start-body :global(.door-label) { font-size: var(--step-3); }
    .start-body :global(.door-body) { font-size: 1.25rem; max-width: 26rem; }
    .start-body :global(.door-go) { font-size: 1rem; }
    @media (max-width: 760px) { .start-body :global(.door-label) { font-size: var(--step-2); } .start-body :global(.door-body) { font-size: 1.125rem; } }
    @media (max-width: 900px) {
      .start-hero-inner { padding-left: var(--space-4); padding-right: var(--space-4); }
      .start-art { width: 56%; height: 48%; right: 0; opacity: 0.24; }
    }
    @media (max-width: 560px) { .start-art { display: none; } }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Start Here" />

  <main>
    <section class="start-hero">
      <div class="start-hero-inner">
        <p class="start-eyebrow" lang="grc" aria-hidden="true"><span>ΙΛΙΑΣ</span><span>ΟΔΥΣΣΕΙΑ</span></p>
        <h1>Start Here</h1>
        <p class="start-intro">
          Three ways into the Iliad and the Odyssey, depending on what you want
          first &mdash; the story, the Greek, or the geography. All three are
          free, with no account required.
        </p>
        <span class="start-art" aria-hidden="true" style={`--art:url('${base}/art/hero/odyssey-560.webp');--art-2x:url('${base}/art/hero/odyssey-sm.webp')`}></span>
      </div>
    </section>
    <div class="pg start-body">
      <DoorCards hrefs={doorHrefs} />
    </div>
  </main>
</body>
</html>
