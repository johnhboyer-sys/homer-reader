---
// The Start Here funnel (PROMPT.md Phase 5, lines 156-168): a dedicated,
// linkable/shareable landing page for the three doors the homepage hero also
// offers directly. The homepage's doors point straight at their destinations
// (no reason to make an in-site visitor click through an extra page); this
// page exists as the funnel's own stable URL for OUTSIDE links — SEO pages,
// social, outreach — per CLAUDE.md "the tie-in is structural (Start Here
// funnel + SEO pages)". Same simple-header + <main> pattern as
// genealogies/maps/attribution/support (this is a reference/wayfinding page,
// not a ReaderShell page).
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import { workPath } from '@shared/lib/works';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Door 1 destination copy reads straight off Od. 9's own scene apparatus
// (same posture as index.astro's hero band), so it can't drift from the
// corpus.
interface StartBook {
  apparatus?: { scenes?: { lines: [number, number]; summary: string; location?: string }[] };
}
const odyssey9: StartBook = JSON.parse(readFileSync('public/data/odyssey/book-09.json', 'utf-8'));
const scene1 = odyssey9.apparatus?.scenes?.[0];

// `tour=parse` arms the one-time 5-step parse-popup walkthrough
// (ParsePopupTour.svelte, mounted in ReaderShell) — gated to arrivals via
// this door, never shown on a plain visit to the reader.
const doors = [
  {
    label: 'New to Homer',
    href: `${base}${workPath('odyssey', 9)}?mode=reading`,
    body: scene1
      ? `Start in the middle of the action — Odysseus among the Cyclopes, ${scene1.location ?? 'Book 9'} — in Reading Mode: one translation, a clean page, marginal scene summaries.`
      : 'Start in the middle of the action — Odysseus among the Cyclopes, Book 9 — in Reading Mode: one translation, a clean page, marginal scene summaries.',
    cta: 'Begin at Od. 9 →',
  },
  {
    label: 'Reading along in Greek',
    href: `${base}${workPath('iliad', 1)}?mode=scholar&tour=parse`,
    body: 'The parallel Greek/English scholar view, from Iliad Book 1 — with a short, dismissible tour of the parse popup and citation tools on your first visit.',
    cta: 'Open scholar view →',
  },
  {
    label: 'Just the maps',
    href: `${base}/maps/`,
    body: 'Every place named in the poems, plotted, with each identification’s certainty honestly marked — no reading required to start.',
    cta: 'Browse the maps →',
  },
] as const;

const pageTitle = 'Start Here — The Homer Reader';
const metaDescription =
  'Three ways into the Homer Reader: begin in the middle of the action with the Odyssey, ' +
  'read along in the Greek with parse popups, or start with the maps — free, no account required.';
const canonical = Astro.site ? new URL(`${base}/start/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Homer Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    body { overflow-x: hidden; max-width: 100%; }
    .start-body {
      max-width: 880px;
      margin: 0 auto;
      padding: 2.5rem 1rem 4.5rem;
      font-family: var(--font-english);
      color: var(--text);
    }
    h1 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 2rem;
      margin: 0 0 0.6rem;
    }
    .start-intro {
      max-width: 42rem;
      font-size: 0.98rem;
      line-height: 1.65;
      color: var(--text-mid);
      margin-bottom: 2rem;
    }
    .doors-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    @media (max-width: 760px) {
      .doors-grid { grid-template-columns: 1fr; }
    }
    .door-card {
      display: block;
      text-decoration: none;
      color: var(--text);
      background: var(--col-bg);
      border: 1px solid var(--border);
      padding: 1.35rem 1.4rem 1.5rem;
      transition: border-color 0.15s ease;
    }
    .door-card:hover { border-color: var(--accent); }
    .door-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .door-card .door-label {
      font-family: var(--font-ui);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      display: block;
      margin-bottom: 0.65rem;
    }
    .door-card p {
      margin: 0;
      font-family: var(--font-english);
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--text-mid);
    }
    .door-card .door-go {
      display: block;
      margin-top: 0.9rem;
      font-family: var(--font-ui);
      font-size: 0.64rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-mid);
    }
    .door-card:hover .door-go { color: var(--accent); }
    @media (max-width: 480px) { h1 { font-size: 1.6rem; } }
  </style>
  <Pwa />
</head>
<body>
  <header class="simple-header">
    <div class="header-title">
      <a class="home-link" href={`${base}/`}>Homer</a>
      <span class="title-sep">&rsaquo;</span>
      <span class="header-static">Start Here</span>
    </div>
    <nav class="header-actions" aria-label="Navigation">
      <a href={`${base}/`} class="search-link">All works</a>
      <a href={`${base}/search`} class="search-link">Search</a>
      <a href={`${base}/about`} class="search-link">About</a>
      <ThemeToggle />
    </nav>
  </header>

  <main class="start-body">
    <h1>Start Here</h1>
    <p class="start-intro">
      Three ways into the Iliad and the Odyssey, depending on what you want
      first &mdash; the story, the Greek, or the geography. All three are
      free, with no account required.
    </p>

    <div class="doors-grid">
      {doors.map((d) => (
        <a class="door-card" href={d.href}>
          <span class="door-label">{d.label}</span>
          <p>{d.body}</p>
          <span class="door-go">{d.cta}</span>
        </a>
      ))}
    </div>
  </main>
</body>
</html>
