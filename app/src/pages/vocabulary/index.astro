---
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface VocabEntry { lemma: string; count: number; gloss?: string; }
interface VocabFile { status: 'draft' | 'reviewed'; books: Record<string, VocabEntry[]>; }

const iliad = JSON.parse(readFileSync('../build/dist/iliad/vocab.json', 'utf-8')) as VocabFile;
const odyssey = JSON.parse(readFileSync('../build/dist/odyssey/vocab.json', 'utf-8')) as VocabFile;
const entryCount = (vocabulary: VocabFile) => Object.values(vocabulary.books).reduce((total, entries) => total + entries.length, 0);
const isDraft = iliad.status === 'draft' || odyssey.status === 'draft';
const pageTitle = 'Vocabulary — The Homer Reader';
const metaDescription = 'Words to know before each book of the Iliad and Odyssey, computed from lemma frequency.';
const canonical = Astro.site ? new URL(`${base}/vocabulary/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    .vocab-body { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem 4.5rem; color: var(--text); }
    h1 { font-family: var(--font-display); font-size: 1.95rem; font-weight: 400; line-height: 1.15; margin-bottom: .55rem; }
    .vocab-intro { max-width: 45rem; color: var(--text-mid); font-size: .98rem; line-height: 1.62; }
    .vocab-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; margin-top: 2rem; max-width: 45rem; }
    .vocab-index-card { display: block; padding: 1.4rem 1.5rem; border: 1px solid var(--border); border-top: 2px solid var(--rule-strong); text-decoration: none; color: inherit; }
    .vocab-index-card:hover { border-color: var(--accent); }
    .vocab-index-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .vocab-index-card h2 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; margin-bottom: .35rem; }
    .vocab-index-card p { font-family: var(--font-ui); font-size: .78rem; color: var(--text-mid); }
    .computed-note { margin-top: 3rem; padding-top: .9rem; border-top: 1px solid var(--border); color: var(--text-mid); font-family: var(--font-ui); font-size: .73rem; }
    @media (max-width: 560px) { .vocab-index { grid-template-columns: 1fr; } }
    @media (max-width: 480px) { h1 { font-size: 1.6rem; } }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Vocabulary" />
  <main class="vocab-body">
    <h1>Words to know before each book {isDraft && <span class="draft-badge" title="AI-drafted English glosses, pending review">Draft</span>}</h1>
    <p class="vocab-intro">A compact vocabulary for each book of the Iliad and Odyssey, computed from lemma frequency. Common words and proper names are excluded; glosses from the Morpheus lexicon are draft apparatus.</p>
    <div class="vocab-index">
      <a class="vocab-index-card" href={`${base}/vocabulary/iliad/`}>
        <h2>Iliad</h2>
        <p>24 books &middot; {entryCount(iliad)} words</p>
      </a>
      <a class="vocab-index-card" href={`${base}/vocabulary/odyssey/`}>
        <h2>Odyssey</h2>
        <p>24 books &middot; {entryCount(odyssey)} words</p>
      </a>
    </div>
    <footer class="computed-note">Vocabulary is computed automatically from lemma frequency. Common words and proper names are excluded; Morpheus glosses are draft apparatus.{isDraft && ' English glosses are pending review.'}</footer>
  </main>
</body>
</html>
