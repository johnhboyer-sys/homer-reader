---
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Pwa from '../../components/Pwa.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import '@shared/styles/global.css';
import '../../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface VocabEntry { lemma: string; count: number; gloss?: string; }
interface VocabFile { status: 'draft' | 'reviewed'; books: Record<string, VocabEntry[]>; }

const iliad = JSON.parse(readFileSync('../build/dist/iliad/vocab.json', 'utf-8')) as VocabFile;
const odyssey = JSON.parse(readFileSync('../build/dist/odyssey/vocab.json', 'utf-8')) as VocabFile;
const entryCount = (vocabulary: VocabFile) => Object.values(vocabulary.books).reduce((total, entries) => total + entries.length, 0);
const isDraft = iliad.status === 'draft' || odyssey.status === 'draft';
const pageTitle = 'Vocabulary — The Homer Reader';
const metaDescription = 'Words to know before each book of the Iliad and Odyssey, computed from lemma frequency.';
const canonical = Astro.site ? new URL(`${base}/vocabulary/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    /* Layout is the shared reference-page pattern (styles/edition-pages.css):
       title block, then the two poems as a pair of doors. */
    @media (min-width: 761px) { .idx-poems .pg-poem { min-height: 17rem; } }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Vocabulary" />
  <main class="pg vocab-body">
    <header class="pg-head">
    <p class="pg-eyebrow">Language</p>
    <h1 class="pg-title">Words to know before each book {isDraft && <span class="draft-badge" title="AI-drafted English glosses, pending review">Draft</span>}</h1>
    <p class="pg-intro vocab-intro">A compact vocabulary for each book of the Iliad and Odyssey, computed from lemma frequency. Common words and proper names are excluded; glosses from the Morpheus lexicon are draft apparatus.</p>
    </header>
    <div class="pg-poems idx-poems">
      <a class="pg-poem is-iliad vocab-index-card" href={`${base}/vocabulary/iliad/`}>
        <span class="pg-poem-greek" lang="grc" aria-hidden="true">ΙΛΙΑΣ</span>
        <h2 class="pg-poem-title">Iliad</h2>
        <p class="pg-poem-meta">24 books &middot; {entryCount(iliad)} words</p>
        <span class="pg-poem-art" aria-hidden="true" style={`--art:url('${base}/art/hero/iliad-sm.webp')`}></span>
      </a>
      <a class="pg-poem is-odyssey vocab-index-card" href={`${base}/vocabulary/odyssey/`}>
        <span class="pg-poem-greek" lang="grc" aria-hidden="true">ΟΔΥΣΣΕΙΑ</span>
        <h2 class="pg-poem-title">Odyssey</h2>
        <p class="pg-poem-meta">24 books &middot; {entryCount(odyssey)} words</p>
        <span class="pg-poem-art" aria-hidden="true" style={`--art:url('${base}/art/hero/odyssey-sm.webp')`}></span>
      </a>
    </div>
    <footer class="pg-note computed-note">Vocabulary is computed automatically from lemma frequency. Common words and proper names are excluded; Morpheus glosses are draft apparatus.{isDraft && ' English glosses are pending review.'}</footer>
  </main>
</body>
</html>
