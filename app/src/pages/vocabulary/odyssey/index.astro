---
import { readFileSync } from 'node:fs';
import ThemeInit from '../../../components/ThemeInit.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Pwa from '../../../components/Pwa.astro';
import { jsonLdSafe } from '../../../lib/jsonld';
import { betaToGreek } from '@shared/lib/betacode';
import { buildLemmaKeyMap, resolveLemmaSlug } from '../../../lib/vocabLemmaLink';
import '@shared/styles/global.css';
import '../../../styles/edition-pages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface VocabEntry { lemma: string; count: number; gloss?: string; }
interface VocabFile { status: 'draft' | 'reviewed'; books: Record<string, VocabEntry[]>; }
interface LemmaIndexEntry { slug: string; key: string; }

const vocabulary = JSON.parse(readFileSync('../build/dist/odyssey/vocab.json', 'utf-8')) as VocabFile;
const lemmaIndex = JSON.parse(readFileSync('public/data/lemmata/_index.json', 'utf-8')) as LemmaIndexEntry[];
const lemmaSlugs = new Map(lemmaIndex.map(({ key, slug }) => [key, slug]));
// Join through the same bucket key build-lemmata.mjs uses (see
// vocabLemmaLink.ts) -- a raw vocab lemma often differs from the index key
// by LSJ-headword normalization (quantity marks, homograph digits).
const lemmaKeyMap = buildLemmaKeyMap(
  JSON.parse(readFileSync('public/data/odyssey/analyses.json', 'utf-8')),
);
const books = Array.from({ length: 24 }, (_, index) => index + 1);
const isDraft = vocabulary.status === 'draft';
const pageTitle = 'Odyssey vocabulary — The Homer Reader';
const metaDescription = 'Words to know before each book of the Odyssey, computed from lemma frequency.';
const canonical = Astro.site ? new URL(`${base}/vocabulary/odyssey/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: metaDescription, ...(canonical ? { url: canonical } : {}) };
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style is:global>
    body { overflow-x: hidden; max-width: 100%; }
    /* Title block, sticky book row and section rules are the shared
       reference-page pattern (styles/edition-pages.css). Each book sets its
       number in the left column and its words in columns on the right. */
    .vocab-book { display: grid; grid-template-columns: 11rem minmax(0, 1fr); column-gap: var(--space-6); padding: var(--space-5) 0 var(--space-6); border-top: 1px solid var(--border); scroll-margin-top: var(--pg-anchor); }
    .vocab-book:first-of-type { border-top: 0; }
    .vocab-book h2 { font-family: var(--font-display); font-weight: 400; font-size: var(--step-3); line-height: 1.1; letter-spacing: -0.015em; color: var(--text); }
    .vocab-list { margin: 0; padding: 0; list-style: none; columns: 3 17rem; column-gap: var(--space-6); counter-reset: vocab; }
    .vocab-entry { counter-increment: vocab; break-inside: avoid; display: grid; grid-template-columns: 1.75rem minmax(0, 1fr) auto; column-gap: 0.5rem; align-items: baseline; padding: 0.5rem 0; border-bottom: 1px solid var(--border); }
    .vocab-entry::before { content: counter(vocab); font: 500 var(--step--1)/1 var(--font-ui); font-variant-numeric: tabular-nums; color: var(--text-mid); }
    .vocab-lemma { grid-column: 2; font-family: var(--font-greek); font-size: 1.3125rem; line-height: 1.3; color: var(--text); }
    a.vocab-lemma { color: var(--accent); text-decoration: none; justify-self: start; }
    a.vocab-lemma:hover { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
    .vocab-gloss { grid-column: 2 / -1; grid-row: 2; font-size: 1.0625rem; line-height: 1.4; color: var(--text-mid); text-wrap: pretty; }
    .vocab-count { grid-column: 3; grid-row: 1; font: 500 var(--step--1)/1 var(--font-ui); font-variant-numeric: tabular-nums; color: var(--text-mid); white-space: nowrap; }
    @media (max-width: 760px) {
      .vocab-book { grid-template-columns: minmax(0, 1fr); padding: var(--space-5) 0; }
      .vocab-book h2 { font-size: 1.75rem; margin-bottom: var(--space-3); }
    }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section="Odyssey Vocabulary" />
  <main class="pg vocab-body">
    <header class="pg-head">
    <p class="pg-eyebrow"><span>Language</span><span class="sep" aria-hidden="true">/</span><a href={`${base}/vocabulary/`}>Vocabulary</a></p>
    <h1 class="pg-title">Odyssey vocabulary {isDraft && <span class="draft-badge" title="AI-drafted English glosses, pending review">Draft</span>}</h1>
    <p class="pg-intro vocab-intro">Words to know before each book of the Odyssey, computed from lemma frequency. Common words and proper names are excluded; glosses from the Morpheus lexicon are draft apparatus. See also <a href={`${base}/vocabulary/iliad/`}>Iliad vocabulary</a>.</p>
    </header>
    <nav class="pg-bar" aria-label="Jump to a book">
      <span class="pg-bar-label" aria-hidden="true">Book</span>
      <div class="pg-jump vocab-jump">
        {books.map((book) => <a href={`#book-${book}`}>{book}</a>)}
      </div>
    </nav>
    {books.map((book) => (
      <section class="vocab-book" id={`book-${book}`}>
        <h2>Book {book}</h2>
        <ol class="vocab-list">
          {(vocabulary.books[String(book)] ?? []).slice(0, 25).map((entry) => {
            const slug = resolveLemmaSlug(entry.lemma, lemmaKeyMap, lemmaSlugs);
            return <li class="vocab-entry">
              {slug ? <a class="vocab-lemma" lang="grc" href={`${base}/lemma/${slug}`}>{betaToGreek(entry.lemma)}</a> : <span class="vocab-lemma" lang="grc">{betaToGreek(entry.lemma)}</span>}
              {entry.gloss && <span class="vocab-gloss">{entry.gloss}</span>}
              <span class="vocab-count">&times;{entry.count}</span>
            </li>;
          })}
        </ol>
      </section>
    ))}
    <footer class="pg-note computed-note">Computed automatically from lemma frequency. Common words and proper names are excluded; Morpheus glosses are draft apparatus.{isDraft && ' English glosses are pending review.'}</footer>
  </main>
</body>
</html>
