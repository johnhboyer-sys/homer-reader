---
// The "three ways in" door cards — one component, one label set, shared by the
// homepage and the /start funnel page (Design punch-list #10, 2026-07-18).
// Before this the two surfaces hand-rolled the same grid with drifted labels
// ("Reading the Greek" vs "Reading along in Greek", "The Maps" vs "Just the
// maps") and differing copy. Labels + copy + CTA are canonical here; only the
// destination hrefs vary per surface, so they're the one prop.
interface Props {
  /** [new-to-Homer, reading-the-Greek, the-maps] destination hrefs, in order. */
  hrefs: [string, string, string];
  /** Optional small-caps section header above the grid (homepage: "Three ways in"). */
  eyebrow?: string;
}
const { hrefs, eyebrow } = Astro.props;
const doors = [
  {
    label: 'New to Homer',
    body: 'Start in the middle of the action — Odysseus among the Cyclopes, Book 9, in Reading Mode.',
    cta: 'Begin at Od. 9 →',
  },
  {
    label: 'Reading the Greek',
    body: 'Parallel text with parse popups on every word, LSJ and Cunliffe one click away.',
    cta: 'Open scholar view →',
  },
  {
    label: 'The Maps',
    body: 'Every place named in the poems, plotted, with its identification’s certainty marked.',
    cta: 'Browse the maps →',
  },
] as const;
---
<section class="doors-section" aria-label="Ways to begin">
  {eyebrow && <h2 class="doors-heading">{eyebrow}</h2>}
  <div class="doors-grid">
    {doors.map((d, i) => (
      <a class="door-card" href={hrefs[i]}>
        <span class="door-label">{d.label}</span>
        <span class="door-body">{d.body}</span>
        <span class="door-go">{d.cta}</span>
      </a>
    ))}
  </div>
</section>

<style>
  /* Three open columns under one rule each, not three boxes: the doors are
     a choice between ways of reading, and the page they sit on is a title
     page, so they stay typographic. */
  .doors-section { padding: var(--space-7) 0; }
  .doors-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 var(--space-5);
  }
  .doors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 var(--space-6);
  }
  .door-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5) 0 var(--space-4);
    border-top: 2px solid var(--text);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .door-label {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .door-body {
    margin: 0.625rem 0 var(--space-5);
    font-family: var(--font-english);
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--text-mid);
  }
  .door-go {
    margin-top: auto;
    font: 600 0.9375rem/1.2 var(--font-ui);
    color: var(--accent);
  }
  .door-card:hover { border-top-color: var(--accent); }
  .door-card:hover .door-label { color: var(--accent); }
  .door-card:hover .door-go { text-decoration: underline; text-underline-offset: 0.25em; }
  .door-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
  @media (max-width: 760px) {
    .doors-section { padding: var(--space-6) 0; }
    .doors-grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .door-card { padding: var(--space-4) 0 var(--space-3); }
    .door-body { margin-bottom: var(--space-4); }
  }
  @media (prefers-reduced-motion: reduce) { .door-card { transition: none; } }
</style>
