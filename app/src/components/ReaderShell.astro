      </div>
      <!-- P2 fix (Codex adversarial review, 2026-07-24): the head's pre-
           hydration view bridge above computes the actual view (saved/`?view=`/
           narrow-width default) and stamps it on <html data-rview> BEFORE
           paint, precisely so the reading text doesn't flash-then-reflow. But
           .nav-view-toggle here is server-rendered with "Both" hardcoded
           active/aria-pressed — Astro can't know the client's localStorage or
           query string at build time (this is a static build, no per-request
           SSR). Left alone, a `?view=english`/saved-English load paints
           English-only text next to a toggle that visibly AND audibly (aria-
           pressed) claims Both, until the island hydrates. This script runs
           synchronously right after the toggle exists (same "before paint of
           this element" guarantee the head script relies on for the text
           column), and just APPLIES the head script's already-computed
           decision — it doesn't recompute the view choice itself, so there's
           still exactly one place that decides. Absent data-rview means
           "both", matching the head script's own default. -->
      <script is:inline>
        (function () {
          try {
            var v = document.documentElement.getAttribute('data-rview') || 'both';
            var toggle = document.getElementById('nav-view-toggle');
            if (!toggle) return;
            Array.prototype.forEach.call(toggle.querySelectorAll('button'), function (btn) {
              var active = btn.dataset.view === v;
              btn.classList.toggle('active', active);
              btn.setAttribute('aria-pressed', String(active));
            });
          } catch (e) { /* no bridge: the island's own broadcast corrects it on hydration */ }
        })();
      </script>
      <!-- P2 fix (adversarial review, 2026-07-25): posture's own pre-
           hydration correction, same shape as the view-toggle script above
           and same reason — .nav-posture-seg/.nav-posture-action are server-
           rendered hardcoded to Scholar, and .nav-chart-room/.nav-view-
           toggle default to visible, because a static build can't know a
           saved `reading` posture or a `?mode=reading` link at build time.
           Left alone, a scene-bearing book loaded that way painted Scholar —
           Chart Room included — with aria-pressed/aria-expanded both
           audibly WRONG, until the island hydrated and flipped everything.
           This applies the head bridge's already-computed data-rposture
           (doesn't recompute it — one decision point, same discipline as
           the view fix) to both presentations of the posture control AND
           to Chart Room/view-toggle visibility. global.css also hides
           Chart Room/view-toggle straight off `:root[data-rposture]` (the
           `.nav-chart-room[hidden]` rule, extended) so the correct layout
           holds even if this script is delayed or blocked — this script's
           own `hidden`-attribute writes below are the SAME attribute the
           LATER island bridge already reads/maintains post-hydration (see
           applyReadingState in the nav-bar-bridge script further down), not
           a second mechanism. -->
      <script is:inline>
        (function () {
          try {
            var reading = document.documentElement.getAttribute('data-rposture') === 'reading';
            var seg = document.getElementById('nav-posture-seg');
            if (seg) {
              Array.prototype.forEach.call(seg.querySelectorAll('button'), function (btn) {
                var active = (btn.dataset.posture === 'reader') === reading;
                btn.classList.toggle('active', active);
                btn.setAttribute('aria-pressed', String(active));
              });
            }
            var action = document.getElementById('nav-posture-action');
            if (action) {
              action.textContent = reading ? 'Scholar ⇄' : 'Reader ⇄';
              var label = reading ? 'Switch to scholar view' : 'Switch to reader mode';
              action.setAttribute('aria-label', label);
              action.setAttribute('title', label + ' (r)');
            }
            var viewToggle = document.getElementById('nav-view-toggle');
            var chartRoom = document.getElementById('nav-chart-room');
            if (viewToggle) viewToggle.toggleAttribute('hidden', reading);
            if (chartRoom) chartRoom.toggleAttribute('hidden', reading);
          } catch (e) { /* no bridge: the island's own broadcast corrects it on hydration */ }
        })();
      </script>

      {stephanus && pages.length > 0 && (
        <nav class="chapter-nav pages-nav" aria-label={bookless ? 'Stephanus pages' : `Book ${label} pages`}>
          <details class="pages-details" id="pages-details">
            {/* Label is just "Pages" even in a multi-book work: the chip sits
