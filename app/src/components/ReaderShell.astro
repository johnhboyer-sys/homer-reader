  <script>
    // Contents sidebar (full-work outline) drawer. On mobile this is the single
    // navigation hub (the old Menu dropdown is gone); on desktop the nav panel is
    // always visible (CSS) and the sidebar holds just the outline.
    const header = document.querySelector('.page-header');
    const tocToggles = Array.from(header?.querySelectorAll<HTMLButtonElement>('.toc-toggle') ?? []);

    // The Go to button's ⌘K hint is rendered ⌘K (macOS) by default; the command
    // palette binds Ctrl+K on non-Mac platforms, so correct the visible label there.
    const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
    if (!isMac) header?.querySelector('.hs-kbd')?.replaceChildren('Ctrl K');
    header?.querySelector('.command-palette-trigger')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-command-palette'));
    });
    const sidebar = document.getElementById('toc-sidebar');
    const backdrop = document.getElementById('toc-backdrop');
    // The closed drawer is off-screen but its links/buttons stay in the DOM, so
    // `inert` (not just aria-hidden) is what keeps them out of the tab order and
    // the accessibility tree. Applied here at load; toggled with the drawer.
    sidebar?.setAttribute('inert', '');
    let tocReturnFocus: HTMLElement | null = null;
    const focusablesIn = (el: Element) =>
      Array.from(el.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )).filter((n) => n.offsetParent !== null || n === document.activeElement);
    const onTocTrap = (e: KeyboardEvent) => {
      if (e.key !== 'Tab' || !sidebar) return;
      const f = focusablesIn(sidebar);
      if (!f.length) { e.preventDefault(); sidebar.focus(); return; }
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    };
    const setToc = (open: boolean) => {
      const wasOpen = document.body.classList.contains('toc-open');
      document.body.classList.toggle('toc-open', open);
      sidebar?.setAttribute('aria-hidden', String(!open));
      tocToggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(open)));
      if (backdrop) backdrop.hidden = !open;
      if (open) {
        sidebar?.removeAttribute('inert');
        if (!wasOpen) tocReturnFocus = document.activeElement as HTMLElement | null;
        // Move focus into the drawer (its close button) and trap Tab inside.
        (sidebar?.querySelector('.toc-close') as HTMLElement | null)?.focus();
        document.addEventListener('keydown', onTocTrap, true);
      } else {
        document.removeEventListener('keydown', onTocTrap, true);
        // Restore focus to whatever opened it (the toggle) before inerting, so
        // focus never lands on an inert node.
        if (wasOpen) {
          (tocReturnFocus ?? tocToggles.find((toggle) => toggle.offsetParent !== null) ?? tocToggles[0])?.focus();
          tocReturnFocus = null;
        }
        sidebar?.setAttribute('inert', '');
      }
    };
    tocToggles.forEach((toggle) => toggle.addEventListener('click', () =>
      setToc(!document.body.classList.contains('toc-open'))));
    backdrop?.addEventListener('click', () => setToc(false));
    sidebar?.querySelector('.toc-close')?.addEventListener('click', () => setToc(false));

    // Settings sidebar toggle. Communicates with Reader.svelte (a Svelte island)
    // via CustomEvents on window; the island owns the open/closed state and the
    // panel markup so translation state can live in one place.
    const settingsToggle = header?.querySelector('.settings-toggle');
    settingsToggle?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('toggle-settings'));
    });
    // Keep aria-expanded in sync when Reader.svelte reports a state change.
    window.addEventListener('settings-state', (e) => {
      const open = (e as CustomEvent<{ open: boolean }>).detail.open;
      settingsToggle?.setAttribute('aria-expanded', String(open));
    });

    // Scene rail toggle — same island bridge as Settings. The button is only
    // present when the book carries scene apparatus (see sceneCount gate above).
    const scenesToggles = Array.from(header?.querySelectorAll<HTMLButtonElement>('.scenes-toggle') ?? []);
    scenesToggles.forEach((toggle) => toggle.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('toggle-scenes'));
    }));
    window.addEventListener('scenes-state', (e) => {
      const open = (e as CustomEvent<{ open: boolean }>).detail.open;
      scenesToggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(open)));
    });

    // Nav-bar bridge (John's nav-bar merge brief, 2026-07-24): the translation
    // select, view toggle, posture toggle and Chart Room button are server-
    // rendered here (see the .nav-controls markup above) but Reader.svelte
    // owns the actual state, so — same island-bridge pattern as Settings/
    // Scenes above — clicks dispatch a `set-*`/`toggle-*` CustomEvent and a
    // matching `*-state` listener syncs this markup's selected option/active
    // class/aria-pressed back afterward (including once right after
    // hydration, correcting any restored-preference mismatch with the SSR
    // default assumed above).
    //
    // P1 fix (Codex adversarial review, 2026-07-24): Reader.svelte is
    // `client:idle` — its onMount doesn't register the set-trans/set-view/
    // toggle-reading/toggle-chart-room listeners until hydration runs, which
    // can be a perceptible delay after these buttons are already interactive
    // and clickable. A click in that window used to just vanish (dispatched
    // to no listener), and worse, once hydration DID land it broadcast
    // whatever it restored from localStorage/URL and stomped the ignored
    // click — a visible snap-back. Chosen fix: write the SAME persisted key
    // Reader.svelte's onMount already restores from (reader-trans-<work>,
    // reader-view, reader-posture, reader-chart-room — see Reader.svelte's
    // TRANS_KEY/POSTURE_KEY/CHART_ROOM_KEY), and apply the visual change to
    // THIS markup immediately, rather than a separate event queue. That way:
    // (a) a pre-hydration click is never lost — it's durably persisted before
    // hydration even starts reading it; (b) onMount's restoration naturally
    // picks up the click's own write, so its *-state broadcast confirms the
    // same value instead of overriding it — no snap-back; (c) there is still
    // only ONE source of truth for the live app state (Reader.svelte's own
    // reactive vars) — localStorage was already that source's persistence
    // layer before this fix, this just also writes to it from here. The
    // CustomEvent dispatch stays (still the only way to update Reader.svelte
    // once it HAS mounted); the localStorage write only matters for the
    // narrow pre-mount window.
    const navControls = document.querySelector('.nav-controls');
    const navWork = navControls?.getAttribute('data-work') ?? '';
    const persist = (key: string, value: string) => { try { localStorage.setItem(key, value); } catch {} };

    // P1 fix, restructured (3rd Codex adversarial review, 2026-07-25 — the
    // first two rounds' scattered `!navPrehydrated.<field>` guards at every
    // URL-reading site in Reader.svelte's onMount each left a gap a later
    // round found: a cross-field side effect that ran AFTER a guarded
    // assignment, and a flag that only recorded "touched" rather than a
    // value, which a storage failure could then leave unrecoverable).
    // Reader.svelte's onMount restores localStorage, then applies `?view=`/
    // `?trans=`/`?mode=`/`loc`/`hlg` EXACTLY as it always has, side effects
    // included — that logic is untouched. This flag instead records the
    // ACTUAL VALUE a pre-hydration click chose (not a boolean), read ONCE at
    // a single choke point at the very end of onMount, after all of the URL
    // logic (including its side effects) has run — so the click always wins,
    // by construction, regardless of what ran in between. Recording the
    // value itself (not just persisting to storage) also means a disabled/
    // failing localStorage no longer matters for correctness: the value
    // lives in this in-memory object, which the same page load's onMount can
    // always read regardless of storage. Storage is still written below —
    // it remains the carrier of the PERSISTED (across-visits) preference,
    // it just stops being the carrier of pre-hydration INTENT. A plain
    // window flag (not a URL/history mutation) so `loc`/`hlg` — deep-link
    // targets, not preferences — are never at risk of being stripped.
    const navPrehydrated: { view?: 'greek' | 'both' | 'english'; trans?: string; reading?: boolean } = {};
    (window as unknown as { __navPrehydrated?: typeof navPrehydrated }).__navPrehydrated = navPrehydrated;

    const navTransSelect = document.getElementById('nav-trans-select') as HTMLSelectElement | null;
    navTransSelect?.addEventListener('change', () => {
      const id = navTransSelect.value;
      navTransSelect.title = navTransSelect.selectedOptions[0]?.textContent ?? '';
      // A <select> only fires `change` on an actual value change, so there is
      // no no-op/early-return case here to worry about (audited per John's
      // request — see the posture handler below for the one that had it).
      navPrehydrated.trans = id;
      if (navWork) persist(`reader-trans-${navWork}`, id);
      window.dispatchEvent(new CustomEvent('set-trans', { detail: { id } }));
    });
    window.addEventListener('trans-state', (e) => {
      const id = (e as CustomEvent<{ id: string }>).detail.id;
      if (!navTransSelect || navTransSelect.value === id) return;
      navTransSelect.value = id;
      navTransSelect.title = navTransSelect.selectedOptions[0]?.textContent ?? '';
    });

    // Declared early (used by applyReadingState's Reader-posture hide below).
    const navChartRoom = document.getElementById('nav-chart-room');

    const navViewToggle = document.getElementById('nav-view-toggle');
    const navViewButtons = Array.from(navViewToggle?.querySelectorAll<HTMLButtonElement>('button') ?? []);
    const applyViewState = (view: string | undefined) => {
      navViewButtons.forEach((btn) => {
        const active = btn.dataset.view === view;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    };
    // No early-return/no-op case here either (audited per John's request):
    // every click runs this whole handler, even a click on the already-
    // active button, so intent is always recorded.
    navViewButtons.forEach((btn) => btn.addEventListener('click', () => {
      applyViewState(btn.dataset.view);
      const view = btn.dataset.view;
      if (view === 'greek' || view === 'both' || view === 'english') navPrehydrated.view = view;
      if (view) persist('reader-view', view);
      window.dispatchEvent(new CustomEvent('set-view', { detail: { view } }));
    }));
    window.addEventListener('view-state', (e) => {
      applyViewState((e as CustomEvent<{ view: string }>).detail.view);
    });

    // Posture: two presentations, one boolean. `navReading` mirrors the last
    // known state so a segmented click on the ALREADY-active button is a
    // no-op (toggle-reading is a plain flip, not "set to X" — see
    // Reader.svelte's toggleReading), not an accidental switch — and so a
    // pre-hydration click can apply and persist the new state immediately
    // (see the P1 note above) instead of waiting for a reading-state
    // broadcast that hasn't happened yet.
    //
    // P2 fix (independent review, 2026-07-25): this used to be seeded
    // `false` unconditionally, "matching Reader.svelte's own default" — but
    // that default is exactly what the posture pre-paint script above (see
    // "reading = data-rposture === 'reading'") may have already overridden
    // before this script ever runs (this is a deferred module script; the
    // is:inline posture sync above it runs first, synchronously). A book
    // loaded at `?mode=reading` (or with a saved `reader-posture=reading`)
    // at 691-1039px paints "Scholar ⇄" correctly, but the stale `false` here
    // made the button's own `!navReading` request Reading again — the
    // toggle never switched. At >=1040px the mirror case: clicking the
    // visibly-inactive Scholar segment computed `wantReading = false`,
    // which now equalled the stale `navReading` (also false), so
    // requestPosture's no-op guard swallowed the click entirely. Seeding
    // from the SAME attribute the paint script read (not a second
    // computation of the same thing) keeps this the one place `navReading`
    // is initialised, honest from the first click.
    let navReading = document.documentElement.getAttribute('data-rposture') === 'reading';
    const navPostureSeg = document.getElementById('nav-posture-seg');
    const navPostureSegButtons = Array.from(navPostureSeg?.querySelectorAll<HTMLButtonElement>('button') ?? []);
    const navPostureAction = document.getElementById('nav-posture-action');
    const applyReadingState = (reading: boolean) => {
      navReading = reading;
      navPostureSegButtons.forEach((btn) => {
        const active = (btn.dataset.posture === 'reader') === navReading;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      if (navPostureAction) {
        navPostureAction.textContent = navReading ? 'Scholar ⇄' : 'Reader ⇄';
        const label = navReading ? 'Switch to scholar view' : 'Switch to reader mode';
        navPostureAction.setAttribute('aria-label', label);
        navPostureAction.setAttribute('title', `${label} (r)`);
      }
      // In Reader posture a single translation column has no parallel views to
      // switch between, and Chart Room's scene-context rail doesn't apply
      // (Reading Mode has its own scene-page map) — hide both nav-bar controls
      // rather than leave them inert (CLAUDE.md-adjacent: no dead controls).
      navViewToggle?.toggleAttribute('hidden', navReading);
      navChartRoom?.toggleAttribute('hidden', navReading);
    };
    // Bug found in the 3rd adversarial review: this used to check the no-op
    // case FIRST and return before recording anything, so a click that
    // merely confirmed the CURRENTLY DISPLAYED state (e.g. clicking Scholar
    // while the static, pre-hydration-default markup already shows it
    // active — which says nothing about Reader.svelte's actual restored
    // state once mounted) never made it into navPrehydrated at all. Intent
    // and persistence now happen UNCONDITIONALLY, first; the no-op check
    // below only gates the visual update + dispatch, which are genuinely
    // unnecessary when nothing on screen needs to change.
    const requestPosture = (wantReading: boolean) => {
      navPrehydrated.reading = wantReading;
      persist('reader-posture', wantReading ? 'reading' : 'scholar');
      if (wantReading === navReading) return;
      applyReadingState(wantReading);
      window.dispatchEvent(new CustomEvent('toggle-reading'));
    };
    navPostureSegButtons.forEach((btn) => btn.addEventListener('click', () => {
      requestPosture(btn.dataset.posture === 'reader');
    }));
    navPostureAction?.addEventListener('click', () => requestPosture(!navReading));
    window.addEventListener('reading-state', (e) => {
      applyReadingState((e as CustomEvent<{ reading: boolean }>).detail.reading);
    });

    // Chart Room: `navChartRoomOpen` mirrors the last known open/closed state
    // the same way `navReading` does above, for the same pre-hydration-click
    // reason (persist + apply immediately; the chart-room-state broadcast
    // just confirms it once Reader.svelte mounts).
    let navChartRoomOpen = false;
    const applyChartRoomState = (open: boolean) => {
      navChartRoomOpen = open;
      navChartRoom?.setAttribute('aria-expanded', String(open));
      // P3 fix (adversarial review, 2026-07-25): aria-controls only while
      // Reader.svelte's #scene-context-rail actually exists (it's rendered
      // solely while chartRoomOpen — see Reader.svelte's `{#if scenes.length
      // && !reading && chartRoomOpen}`), so assistive tech never resolves
      // the IDREF to nothing. The markup carries no static aria-controls at
      // all now — this is the only place that sets or clears it.
      //
      // P3 fix, extended (independent review, 2026-07-25): `open` alone
      // isn't enough to prove the target exists — a PRE-hydration click
      // reaches this same function (persist-and-apply-immediately, see the
      // click listener below) while Reader.svelte's island hasn't mounted
      // yet, so `#scene-context-rail` genuinely isn't in the DOM. Verified
      // empirically (devtools, a real click after full hydration): even in
      // the ORDINARY post-hydration case the rail doesn't exist at the
      // instant this function runs — Svelte runs the reactive statement that
      // re-dispatches `chart-room-state` BEFORE it patches the DOM within
      // the same component update, so a same-tick `getElementById` here
      // always misses a freshly-opened rail, not only the pre-hydration
      // case (a `requestAnimationFrame` retry was tried first and also
      // proved unreliable — rAF doesn't fire at all while the tab/pane is
      // backgrounded, which a real reader can trigger just by switching
      // tabs mid-click). A MutationObserver has neither problem: it reports
      // the exact moment the rail node lands, however the state got there
      // (this click's own synchronous dispatch, or a later mount finishing
      // a pre-hydration restore), and mutation delivery isn't paused by tab
      // visibility. Clearing on close stays immediate (the rail is
      // genuinely gone by then); `navChartRoomOpen` (not the closed-over
      // `open` param) is what the observer's callback re-checks, so a rapid
      // re-close before the rail appears can't resurrect a stale
      // aria-controls. The 2s safety timeout only guards against a leaked
      // observer if the rail never materializes (e.g. Reader.svelte fails
      // to mount at all).
      const link = (): boolean => {
        if (navChartRoomOpen && document.getElementById('scene-context-rail')) {
          navChartRoom?.setAttribute('aria-controls', 'scene-context-rail');
          return true;
        } else if (!navChartRoomOpen) {
          navChartRoom?.removeAttribute('aria-controls');
          return true;
        }
        return false;
      };
      if (!link() && open) {
        const obs = new MutationObserver(() => { if (link()) obs.disconnect(); });
        obs.observe(document.body, { childList: true, subtree: true });
        setTimeout(() => obs.disconnect(), 2000);
      }
    };
    // Not part of navPrehydrated: no URL parameter ever overrides Chart Room,
    // so there is nothing for a choke point to protect it from. Also audited
    // for the early-return pattern (John's request) — this is a single
    // toggle with no "already active" case to short-circuit on, so it has
    // none either.
    navChartRoom?.addEventListener('click', () => {
      const next = !navChartRoomOpen;
      applyChartRoomState(next);
      persist('reader-chart-room', String(next));
      window.dispatchEvent(new CustomEvent('toggle-chart-room'));
    });
    window.addEventListener('chart-room-state', (e) => {
      applyChartRoomState((e as CustomEvent<{ open: boolean }>).detail.open);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (document.body.classList.contains('toc-open')) { setToc(false); return; }
      window.dispatchEvent(new CustomEvent('close-scenes'));
      window.dispatchEvent(new CustomEvent('close-settings'));
    });
    // Clicking a chapter that's on this page (a #hash link) just scrolls — close
    // the drawer so the reader is visible. Cross-book links navigate away anyway.
    sidebar?.querySelectorAll<HTMLAnchorElement>('.toc-outline a').forEach((a) => {
      if (a.getAttribute('href')?.startsWith('#')) a.addEventListener('click', () => setToc(false));
    });
    // The sidebar "Help" entry opens the shared Help modal (HelpButton listens for
    // this event) and closes the drawer so the modal isn't hidden behind it.
    sidebar?.querySelector('.toc-help')?.addEventListener('click', () => {
      setToc(false);
      window.dispatchEvent(new CustomEvent('open-help'));
    });

    // Publish the header's height as --header-h so the reader's sticky controls
    // strip can pin directly beneath it. The header is two rows on desktop and
    // its height shifts with viewport width and work switches, so re-measure.
    const setHeaderH = () => {
      if (header) document.documentElement.style.setProperty(
        '--header-h', `${Math.round(header.getBoundingClientRect().height)}px`);
    };
    setHeaderH();
    if (header && 'ResizeObserver' in window) new ResizeObserver(setHeaderH).observe(header);
    window.addEventListener('resize', setHeaderH);
    window.addEventListener('load', setHeaderH);
    // Web fonts swap in after first paint and reflow the header height.
    if (document.fonts?.ready) document.fonts.ready.then(setHeaderH);

    // Pages nav (collapsible <details>): restore the open/closed state from a
    // previous visit, and persist future toggles. Collapsed by default (no
    // `open` attribute server-side, so SSG output is deterministic); the
    // --header-h ResizeObserver above already watches .page-header, so a
    // toggle's height change re-publishes --header-h with no extra wiring.
    const pagesDetails = document.getElementById('pages-details') as HTMLDetailsElement | null;
    if (pagesDetails) {
      try {
        if (localStorage.getItem('nav-pages-open') === '1') pagesDetails.open = true;
      } catch {}
      pagesDetails.addEventListener('toggle', () => {
        try {
          localStorage.setItem('nav-pages-open', pagesDetails.open ? '1' : '0');
        } catch {}
      });
    }
  </script>

  {verseLine && !bookless && (
    <section class="book-plate" aria-label={`${work.title}, Book ${label} — book plate`}>
      {artPlate && (
        <span
          class="plate-art"
          aria-hidden="true"
          style={`--art:url('${base}/art/flaxman/${artPlate.file}')`}
          title={artPlate.caption}
        ></span>
      )}
      <div class="book-plate-titles">
        {cartoucheGreek && <div class="book-plate-greek" lang="grc">{cartoucheGreek}</div>}
        <div class="book-plate-en">{work.title} · Book {label}</div>
        {apparatus?.draft && (apparatus.argument || apparatus.where || apparatus.who?.length || apparatus.day) && (
          <span class="draft-badge" title="AI-drafted apparatus, pending review">Draft</span>
        )}
      </div>
      {apparatus?.argument && <p class="book-plate-argument">{apparatus.argument}</p>}
      {apparatus && (apparatus.where || apparatus.who?.length || apparatus.day) && (
        <div class="book-plate-meta">
          {apparatus.where && <span>{apparatus.where}</span>}
          {apparatus.who?.map((w) => (
            <>
              <span class="sep">·</span>
              <span>{w}</span>
            </>
          ))}
          {apparatus.day && (
            <>
              <span class="sep">·</span>
              <span title={dayIsTelling ? 'The day of the telling; the events narrated here lie years earlier.' : undefined}>
                Day {apparatus.day}{dayIsTelling && ' · telling'}
              </span>
            </>
          )}
        </div>
      )}
    </section>
  )}
  <!-- The reading surface is fully server-rendered above (text is in the static
       HTML), so the island only needs to hydrate the INTERACTIVITY (token
       lookup, posture / translation toggles, jump-to-line). Deferred to idle so
       the hydration work no longer competes with first paint / LCP of the
       already-visible text; the data-rview CSS bridge holds the layout stable
       until the island takes over (no CLS), and the mount-time deep-link scroll
       still runs (idle fires after initial layout, so there's LESS churn to
       cancel the scroll, not more). The big hydration-cost win is the token
       event-delegation in Reader.svelte, which removed the ~1.2s scripting task. -->
  <Reader work={workId} bookNum={n} bookData={clientBookData} chapterTitles={chapterTitles[String(n)] ?? {}} speakerRoster={roster} client:idle />
  <CommandPalette work={workId} bookNum={n} scenes={clientBookData.scenes ?? []} client:idle />
  <ParsePopupTour client:load />

  <footer class="site-footer">
    <span>Greek text: {work.greekSource.short} ({work.greekSource.licence})</span>
    <span class="footer-sep" aria-hidden="true">·</span>
    <span>Translations: public domain (Murray, Butler, Pope)</span>
    <span class="footer-sep" aria-hidden="true">·</span>
    <a href={`${base}/attribution`}>Texts &amp; Licences</a>
    <span class="footer-sep" aria-hidden="true">·</span>
    <a href={`${base}/about`}>About</a>
  </footer>
</body>
</html>

<style>
  /* Keep the phone's existing header composition (<=690px) untouched. From
     691px up, Contents has exactly ONE home: the control row's left group
     (.nav-group-left's .nav-toc-toggle, global.css) — John, 2026-07-25,
     replacing an earlier "beside the wordmark" placement (.header-contents-
     toggle, since removed) that went through a 681-899/900+ split before
     being scrapped the same day in favour of this simpler single rule.
     Lower bound moved 681->690/691 the same day (coordinator's measured-
     table fix): 681-690px wrapped the control row to two lines, so that
     band now gets full phone treatment too. */
  .header-mobile-toggles { display: contents; }

  @media (min-width: 691px) {
    .header-mobile-toggles { display: none; }
  }

  /* Short-landscape carries its OWN Contents + Scenes (John's Job 4,
     2026-07-25): the control row (global.css's .nav-panel) is fully
     stripped in this orientation/height combination regardless of width
     (see global.css's `orientation: landscape) and (max-height: 500px)`
     block), and Contents no longer has any other >=691px home now that its
     beside-the-wordmark copy is gone — a short, WIDE window (e.g. a tablet
     or a shrunk laptop window in landscape) would otherwise have NO way to
     open Contents or Scenes at all. Below 691px this is moot: the base rule
     above already leaves .header-mobile-toggles showing there (real phones
     in landscape, e.g. an iPhone SE at 667x375, already have it via that
     default — untouched). This width-gated re-show intersects with (so
     loses to nothing, and only ever ADDS to) the plain `@media (min-width:
     691px)` rule above; same specificity, later in source, so it wins —
     same tie-break idiom as global.css's `.book-plate.book-plate` note.
     Threshold moved 681->691 in lockstep with the base rule above (John,
     coordinator's fix) — this rule only matters where the base rule would
     otherwise have hidden the pair, so it has to track that exactly. */
  @media (orientation: landscape) and (max-height: 500px) and (min-width: 691px) {
    .header-mobile-toggles { display: contents; }
    /* Reposition immediately right of the work switcher (John's wording;
       corrected same day — the coordinator's capture pass caught the FIRST
       version of this rule rendering the pair at the far right instead,
       grouped with search/lexicon/settings/theme/support). Root cause: this
       same short-landscape context's generic `.page-header .header-title {
       flex: 1 1 auto; margin-right: auto; }` (global.css) gives header-title
       flex-GROW — its box expands to swallow ALL the free space itself, so
       toc-toggle/scenes-toggle at order 1 sat immediately after that huge
       INVISIBLE box, which put them visually adjacent to .bar-actions at
       the far right, not adjacent to the visible wordmark text the box
       merely starts with. `order` alone can't fix a flex-grow problem — the
       growing item still eats the space before the next one regardless of
       order. Fix: stop header-title from growing here (flex-grow: 0), and
       move the "push the rest of the cluster right" job from its own
       margin-right:auto onto .bar-actions' margin-left:auto instead, so the
       free space lands AFTER toc-toggle/scenes-toggle rather than before
       them. Doubled classes beat global.css's generic (0,2,0) rules
       regardless of file load order (same idiom as the order rules below,
       which are otherwise unchanged from the first version). */
    .page-header .header-title.header-title { flex: 0 1 auto; margin-right: 0; }
    .header-mobile-toggles.header-mobile-toggles .toc-toggle,
    .header-mobile-toggles.header-mobile-toggles .scenes-toggle { order: 1; }
    .page-header .bar-actions.bar-actions { order: 2; margin-left: auto; }
  }

  /* The identity lockup and global controls stay one row even past the
     compact squeeze's own 1039px ceiling (global.css — boundary corrected
     900->960->1024->1040 on 2026-07-25, see the .nav-toc-label note there)
     — general invariant, not itself tier-specific. */
  @media (min-width: 1040px) {
    .header-bar { flex-wrap: nowrap; }
  }
</style>

<style is:global>
  /* Verse-work contents rows keep their single anchor target while adding the
     optional book argument as a compact secondary line. */
  .toc-book-link.has-argument { display: flex; flex-direction: column; gap: 0.14rem; }
  .toc-book-argument {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--text-mid);
    font-size: 0.76rem;
    font-weight: 400;
    line-height: 1.3;
  }
  .toc-draft-note {
    padding: 0.35rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 680px) {
    /* The contents drawer is the phone navigation hub; one line preserves a
       compact sheet at 375px while retaining the summary in the link text. */
    .toc-book-argument { -webkit-line-clamp: 1; }
  }

  /* Cartouche gap (John, 2026-07-19): on desktop, dead space stacked between
     the book plate's own bottom margin (global.css .book-plate:
     margin-bottom 1.75rem / 28px) and .reader-body's top padding (global.css
     .reader-body: padding-top 1.5rem / 24px) — the two don't margin-collapse
     (.reader-controls, the visible edge, is a PADDED descendant of
     .reader-body, not book-plate's sibling), so they simply add up to ~52px
     of dead space above the translation-picker strip. Neither rule lives in
     a file this brief is scoped to touch (both are in shared/styles/
     global.css) — this override, scoped to the SAME breakpoint the rest of
     this file's non-phone overrides use (681px — briefly raised to 1100px
     during the nav-bar-merge phase, 2026-07-24, restored to 681px with the
     rest of the control-row boundaries, 2026-07-25), drops the book-plate's
     own trailing margin to 0, leaving reader-body's 24px as the sole (and
     now single, legible) gap — roughly half the original ~52px. Below
     681px is untouched. Doubled class (`.book-plate.book-plate`,
     specificity 0-2-0) rather than plain `.book-plate` (0-1-0): global.css's
     own `.book-plate { margin: 1.25rem 0 1.75rem }` shorthand rule is
     emitted AFTER this component's styles in the page's CSS (verified
     empirically), so an equal-specificity override here would lose the
     cascade tie-break to source order and silently not apply. */
  @media (min-width: 681px) {
    .book-plate.book-plate { margin-bottom: 0; }
  }
</style>
