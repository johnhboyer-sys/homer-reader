---
// The reader page body, shared by the two routes:
//   /<work>/book/<n>  (multi-book works)   — src/pages/[work]/book/[n].astro
//   /<work>           (single-book works)   — src/pages/[work]/index.astro
// `bookless` works (Categories, Poetics) are a single treatise of chapters with
// no book level, so all book-level chrome (the "· Book N" title, the book nav
// row, the per-book TOC grouping) is dropped.
import { readFileSync } from 'node:fs';
import Reader from '@shared/components/Reader.svelte';
import BekkerJump from '@shared/components/BekkerJump.svelte';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import Pwa from './Pwa.astro';
import HelpButton from './HelpButton.svelte';
import ParsePopupTour from './ParsePopupTour.svelte';
import WorkSwitcher from './WorkSwitcher.svelte';
import ThemeInit from './ThemeInit.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getWork, bookLabel, isBookless, workPath, workLanding, visibleTranslations, HOUSE_AUTHOR, GREEK_BOOK_LETTERS } from '@shared/lib/works';
import { normalizeBookData, stripBookForClient } from '@shared/lib/data';
import { setSsrBook } from '@shared/lib/ssr-book';
import { bookArguments, type BookArgument } from '../lib/book-apparatus';
import { speakerRoster } from '../lib/speaker-roster';
import { SUPPORT_URL } from '../lib/support';
import { jsonLdSafe } from '../lib/jsonld';

interface Props { workId: string; n: number; }
const { workId, n } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const work = getWork(workId)!;
const bookless = isBookless(work);
// Non-Bekker works (e.g. the Isagoge) have no Bekker lines, so the "Go to
// Bekker line" jump doesn't apply.
const busse = work.citation?.scheme === 'busse';
// Stephanus works (Plato) are cited by page+letter; their outline nav lists
// Stephanus pages (from sections.json) instead of chapters (chapters.json is
// empty for them).
const stephanus = work.citation?.scheme === 'stephanus';
const verseLine = work.citation?.scheme === 'verse-line';
const label = bookLabel(work, n);

// Cartouche book-plate title: the traditional Greek-letter book citation
// (Ἰλιάδος Α, Ὀδυσσείας α — Iliad books Α–Ω capital, Odyssey books α–ω
// lowercase, the inherited Alexandrian convention; both epics run exactly
// 24 books, so no digamma/stigma numeral extension is needed). Genitive
// title stems are the standard dictionary genitives of Ἰλιάς/Ὀδύσσεια.
const GREEK_TITLE_GENITIVE: Record<string, string> = { iliad: 'ΙΛΙΑΔΟΣ', odyssey: 'ΟΔΥΣΣΕΙΑΣ' };
const bookGreekLetter = (): string => {
  const letter = GREEK_BOOK_LETTERS[n - 1] ?? String(n);
  return workId === 'odyssey' ? letter.toLowerCase() : letter;
};
const cartoucheGreek = GREEK_TITLE_GENITIVE[workId]
  ? `${GREEK_TITLE_GENITIVE[workId]} ${bookGreekLetter()}`
  : undefined;

interface ChapterRef { chapter: string; column: string; line: string; bekker: string; }
const allChapters: Record<string, ChapterRef[]> = JSON.parse(
  readFileSync(`public/data/${workId}/chapters.json`, 'utf-8'),
);
const chapters = allChapters[String(n)] ?? [];

// Stephanus section outline (sections.json): { book -> ordered [{column, page,
// letter, id}] }. Read only for a stephanus work; the file may be absent on a
// partial build, so degrade to an empty outline. Grouped into pages below.
interface SectionRef { column: string; page: number; letter: string; id: string; }
let allSections: Record<string, SectionRef[]> = {};
if (stephanus) {
  try {
    allSections = JSON.parse(readFileSync(`public/data/${workId}/sections.json`, 'utf-8'));
  } catch { /* no sections yet */ }
}
// The Stephanus pages of a book: the first section column on each page, in
// reading order — the anchor (`col-{column}`) the page's nav entry links to.
const pagesOf = (b: number): { page: number; column: string }[] => {
  const secs = allSections[String(b)] ?? [];
  const out: { page: number; column: string }[] = [];
  let last: number | null = null;
  for (const s of secs) {
    if (s.page !== last) { out.push({ page: s.page, column: s.column }); last = s.page; }
  }
  return out;
};
const pages = pagesOf(n);
// A page links to its first section's segment anchor (the Reader emits
// `id="col-{column}"`), same-book as a hash or cross-book as a full path.
const pageHref = (b: number, column: string) =>
  b === n ? `#col-${column}` : `${base}${workPath(workId, b)}#col-${column}`;

// The book's reading data, read at build time and handed to the Reader island so
// the Greek + English text is server-rendered into the static HTML (crawlable +
// instant paint) instead of fetched client-side. Run it through the SAME
// normalization fetchBook uses so `scenes` (drafted from apparatus.scenes) is
// present on the static page — otherwise the raw JSON.parse leaves scenes
// undefined and Reading Mode can't page by scene (it silently degrades to the
// old whole-book flow instead).
const rawBookData = JSON.parse(
  readFileSync(`public/data/${workId}/book-${String(n).padStart(2, '0')}.json`, 'utf-8'),
);
const bookData = normalizeBookData(rawBookData);
// The island's server render reads the FULL book (with Greek tokens) from the
// SSR channel so the static markup carries every token span; its SERIALIZED
// props instead get a token-stripped copy — ~half the payload, since the token
// arrays and the non-default translations duplicate/aren't-in the default SSR
// view. The client rebuilds tokens from the DOM and fetches the other
// translations on demand (see Reader.svelte, stripBookForClient, ssr-book.ts).
setSsrBook(bookData);
const clientBookData = stripBookForClient(bookData);
// The in-book scene rail toggle only ships when this book carries scene
// apparatus (drafted apparatus.scenes → normalized bookData.scenes); books
// without it get no empty flyout.
const sceneCount = bookData.scenes?.length ?? 0;

// Nav-bar controls (John's nav-bar merge brief, 2026-07-24): the translation
// picker, view toggle, posture toggle and Chart Room button move from
// Reader.svelte's reader-controls strip into THIS server-rendered nav bar on
// wide desktop (>=1100px — see global.css), so they exist in the static HTML
// instead of waiting on client:idle hydration. Reader.svelte still owns the
// actual interactive state; these controls dispatch/listen for window
// CustomEvents (set-trans, set-view, toggle-reading, toggle-chart-room /
// trans-state, view-state, reading-state, chart-room-state — see the plain
// <script> below and Reader.svelte's matching bridge) to stay in sync after
// hydration. Below 1100px this block is hidden (CSS) and the pre-existing
// compact controls (Reader.svelte's own posture-btn strip copy + the
// ⚙ Settings sidebar) carry these features unchanged.
const navTranslations = visibleTranslations(work);
// Same default-selection logic as Reader.svelte's own `trans` initializer
// (works.defaultTranslation, else the primary 'english'-slot translation),
// so the SSR-rendered <select>'s preselected option matches what Reader.
// svelte will show before any restored (localStorage/`?trans=`) override
// corrects it via the trans-state bridge event above.
const navDefaultTransId =
  navTranslations.find((t) => t.id === work.defaultTranslation)?.id
  ?? navTranslations.find((t) => t.slot === 'english')?.id
  ?? navTranslations[0]?.id;

// Cartouche apparatus slots (argument line + where/who/day strip): optional
// Phase-4 fields on a book's data. The cartouche renders only populated fields;
// no lorem or placeholder text ships when a partial build lacks apparatus
// (CLAUDE.md "Apparatus honesty").
interface BookApparatus { argument?: string; where?: string; who?: string[]; day?: string; draft?: boolean; }
const apparatus: BookApparatus | undefined = bookData.apparatus;
// The verse-work contents rail needs every book's compact argument, not just
// this page's cartouche apparatus. Read the same emitted book JSON files as
// the current-book SSR loader above; the helper caches that projection per work
// while Astro renders the 24 static book pages.
const tocArguments: BookArgument[] = verseLine ? bookArguments(workId, work.books) : [];
// Per-book Flaxman plate for the header band (John, 2026-07-18: committed
// feature — the plate joins the contour band, shrunk to the band's own
// dimensions; desktop only, plateless books simply show the band as before).
// Build-time read of the repo's art apparatus, same posture as the loaders
// above; the asset itself is a static alpha mask under /art/flaxman/.
interface ArtPlate { work: string; book: number; file: string; caption?: string; }
let artPlate: ArtPlate | undefined;
try {
  const art = JSON.parse(readFileSync('../apparatus/art.json', 'utf-8')) as { plates?: ArtPlate[] };
  artPlate = art.plates?.find((p) => p.work === workId && p.book === n);
} catch { /* no art apparatus in this build — band renders as always */ }
const tocHasDraftArgument = tocArguments.some(({ argument, draft }) => Boolean(argument) && draft === true);
// Apologoi day-honesty cue (John, phone session 2026-07-18): "where" carries
// the pipeline's "(telling)" marker on a frame scene (Odysseus narrating at
// Alcinous's palace) when this book is told in flashback — every scene's day
// number is the day of the TELLING, not of the events narrated. Reuses the
// same data signal as Reader.svelte's scene-rail cue (see its comment there
// for the known Od. 10/12 gap: those books share the flashback frame but
// carry no "(telling)"-marked scene of their own, so this can't reach them).
const dayIsTelling = apparatus?.where?.includes('(telling)') ?? false;

// Whole-work speaker-display roster (memoized), so speaker-name colours are
// stable across books and match the landing cast list (see speaker-roster.ts).
const roster = speakerRoster(workId, work.books);

// Optional one-line chapter titles/descriptions for the outline sidebar, keyed
// {book: {chapter: "…"}}. The file is written by hand/curation per work and may
// not exist yet — the outline degrades to chapter number + Bekker range.
let chapterTitles: Record<string, Record<string, string>> = {};
try {
  chapterTitles = JSON.parse(
    readFileSync(`public/data/${workId}/chapter-titles.json`, 'utf-8'),
  );
} catch { /* no titles yet */ }

// The full-work outline for the sidebar: every book, its chapters in order.
const outline = Array.from({ length: work.books }, (_, i) => {
  const b = i + 1;
  return {
    book: b,
    label: bookLabel(work, b),
    chapters: allChapters[String(b)] ?? [],
    argument: tocArguments[b - 1]?.argument,
  };
});
const chapterHref = (b: number, chapter: string) =>
  b === n ? `#ch-${b}-${chapter}` : `${base}${workPath(workId, b)}#ch-${b}-${chapter}`;
// The visible tab title + og:title. Front-loads the work name (what people
// search) and appends the parallel-text long-tail phrasing ("greek english
// translation") that these deep book pages can realistically rank for, since
// they can't win the bare head term against Wikipedia/SEP on a github.io path.
const pageTitle = bookless
  ? `${work.title} — Greek Text & English Translation`
  : `${work.title}, Book ${label} — Greek Text & English Translation`;

// ── SEO: server-rendered signals ───────────────────────────────────────────
// The reading text is now server-rendered (bookData is read at build above and
// handed to the Reader island, so the Greek/English lines are in the static
// HTML, not a "Loading…" placeholder). These tags supply the rest of what
// crawlers want: a canonical URL, a real description, a Schema.org Book record,
// a semantic <h1>, and a topical intro paragraph.
const bookSuffix = bookless ? '' : `, Book ${label}`;
const primaryTrans =
  work.translations.find((t) => t.slot === 'english') ?? work.translations[0];
// Translator entries read "Name (Publisher, Year)"; keep just the person name.
const translatorName = primaryTrans?.name.split(' (')[0] ?? '';
const canonical = Astro.site
  ? new URL(`${base}${workPath(workId, n)}/`, Astro.site).href
  : undefined;
// Social share card: a branded render of a bilingual page (public/og-default.png).
// Crawlers require an absolute URL, so it's built off Astro.site + base.
const ogImage = Astro.site
  ? new URL(`${base}/og-default.png`, Astro.site).href
  : undefined;
const metaDescription =
  `Read ${work.author}'s ${work.title}${bookSuffix} — the original Greek` +
  ` (${work.greekSource.short}) side by side with` +
  (translatorName ? ` ${translatorName}'s` : ' an') +
  ` English translation, with click-to-parse morphology, dictionary entries,` +
  ` and Stephanus citation.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: `${work.title}${bookSuffix}`,
  ...(work.greekTitle ? { alternateName: work.greekTitle } : {}),
  author: { '@type': 'Person', name: work.author },
  ...(translatorName
    ? { translator: { '@type': 'Person', name: translatorName } }
    : {}),
  inLanguage: ['grc', 'en'],
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'CreativeWorkSeries', name: `The Works of ${HOUSE_AUTHOR}` },
  description: metaDescription,
};
// Breadcrumb trail (Home › Work › Book N) — gives Google the page's place in the
// hierarchy and can render as a breadcrumb rich result in the SERP. Absolute
// URLs required, so emitted only when Astro.site is set.
const breadcrumbLd = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: HOUSE_AUTHOR,
          item: new URL(`${base}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: work.title,
          item: new URL(`${base}${workLanding(workId)}/`, Astro.site).href },
        ...(bookless
          ? []
          : [{ '@type': 'ListItem', position: 3, name: `Book ${label}`,
              item: new URL(`${base}${workPath(workId, n)}/`, Astro.site).href }]),
      ],
    }
  : null;
const h1Text =
  `${work.author}, ${work.title}${bookSuffix} — Greek text with English translation`;
// A short topical paragraph (the curated one-line blurb, framed with the Greek
// source and translator) so the page carries real descriptive prose for search
// snippets and screen readers, distinct from the dense parallel-text body.
const intro =
  `${work.title}${bookSuffix} by ${work.author}, in the original Greek` +
  ` (${work.greekSource.short})` +
  (translatorName ? `, with the English translation of ${translatorName}` : '') +
  `. ${work.blurb}`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- TODO: register this property in Google Search Console and add its
       verification token here (a sibling reader's token was intentionally
       removed from this file — it belongs to a different GSC property). -->
  <ThemeInit />
  <!-- Pre-hydration view + posture bridge. The Reader island is server-
       rendered as the bilingual `view-both` layout with Scholar posture
       active, but on load the client may restore a single language and/or
       Reading posture (saved choice, `?view=`/`?mode=` override). Doing
       either after first paint reflows the page — a ~0.16 CLS on the giant
       .ross-prose block for view, and a visibly-wrong Scholar/Chart-Room
       flash-then-correct for posture (P2, Codex adversarial review,
       2026-07-25: the view half of this bridge already existed; posture had
       none, so a scene-bearing book loaded at `?mode=reading` or with a
       stored `reader-posture=reading` painted Scholar — Chart Room included
       — until hydration flipped it). This inline script (runs before paint,
       like ThemeInit) computes the SAME choices the island's onMount will
       make and stamps them on <html data-rview>/data-rposture, which CSS
       (and the small sync script right after the posture markup, below)
       use to paint the correct layout immediately — same mechanism, same
       validation/try-catch shape, extended rather than duplicated. Reader
       clears both attributes in onMount once Svelte's own reactive state is
       authoritative. -->
  <script is:inline>
    (function () {
      try {
        var p = new URLSearchParams(location.search);
        var qv = p.get('view'), v;
        if (qv === 'greek' || qv === 'english' || qv === 'both') v = qv;
        else if (p.get('loc') || (p.get('hlg') || '').trim()) v = 'both';
        else {
          var s = localStorage.getItem('reader-view');
          if (s === 'greek' || s === 'english' || s === 'both') v = s;
          else if (window.matchMedia('(max-width: 680px)').matches) v = 'english';
          else v = 'both';
        }
        if (v !== 'both') document.documentElement.setAttribute('data-rview', v);
      } catch (e) { /* no bridge: falls back to the (pre-fix) reflow */ }
      try {
        // Same precedence as Reader.svelte's own restore-then-`?mode=`-
        // override order (see its onMount: localStorage first, `?mode=`
        // last) — a `?mode=` overrides a stored posture, matching `?view=`.
        var p2 = new URLSearchParams(location.search);
        var qm = p2.get('mode'), reading;
        if (qm === 'reading' || qm === 'scholar') reading = qm === 'reading';
        else reading = localStorage.getItem('reader-posture') === 'reading';
        if (reading) document.documentElement.setAttribute('data-rposture', 'reading');
      } catch (e) { /* no bridge: static Scholar markup stands until hydration */ }
    })();
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Homer Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumbLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Pwa />
</head>
<body>
  <header class="page-header">
    <!-- Semantic page heading + topical intro for search engines and screen
         readers. Visually hidden because the visible title is the work-switcher
         control; this gives the document a real, descriptive <h1> and a prose
         summary without altering the design. Nested inside the one banner
         landmark (not a second top-level <header>) so it stays contained by a
         landmark (axe: region) without duplicating the banner role (axe:
         landmark-no-duplicate-banner / landmark-unique). -->
    <div class="sr-only">
      <h1>{h1Text}</h1>
      <p>{intro}</p>
    </div>
    <div class="header-bar">
      <!-- The phone header (<=680px) keeps its compact, established control
           order — UNCHANGED. Contents no longer has a beside-the-wordmark
           copy (John, 2026-07-25, revising the note this replaced): from
           681px up its ONLY home is the control row's left group (see
           .nav-panel below and global.css's .nav-toc-toggle) — one rule, no
           680/900/1024 tier split to track for Contents' own placement.
           This same .header-mobile-toggles pair ALSO doubles as the short-
           landscape header's Contents+Scenes (John's Job 4, same day): see
           the intersection media query in this file's own <style> block
           below, which re-shows and reorders it (title attrs added here so
           both reuses carry aria-label + title on an icon-only control). -->
      <div class="header-mobile-toggles">
        <button type="button" class="toc-toggle" aria-expanded="false" aria-controls="toc-sidebar" aria-label="Contents" title="Contents">
          <span class="toc-toggle-icon" aria-hidden="true">☰</span><span class="toc-toggle-text" aria-hidden="true">Contents</span>
        </button>
        {sceneCount > 0 && (
          <button type="button" class="scenes-toggle" aria-expanded="false" aria-controls="scene-rail" aria-label="Scenes" title="Scenes">
            <span class="scenes-toggle-icon" aria-hidden="true">❦</span><span class="scenes-toggle-text" aria-hidden="true">Scenes</span>
          </button>
        )}
      </div>
      <div class="header-title">
        <a class="home-link home-wordmark" href={`${base}/`} aria-label="The Homer Reader — all works">
          <span class="wordmark-name">The Homer Reader</span>
          <span class="wordmark-eyebrow">The Iliad &amp; Odyssey · Greek and English</span>
        </a>
        <span class="title-sep">›</span>
        <WorkSwitcher work={workId} client:load />
      </div>
      <!-- #14 (2026-07-18): the bar reads as two groups, not a flat row of equal
           buttons — reading tools (Go to · Lexicon), then a hairline, then the
           app/meta cluster (Settings · Help · Theme). Support is demoted from a
           loud filled CTA to a quiet ghost and pinned last, so it no longer
           out-weighs the reading tools. -->
      <div class="bar-actions">
        <button type="button" class="header-search command-palette-trigger" aria-label="Go to book, scene, or citation">
          <svg class="hs-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="6.8" cy="6.8" r="4.6"/><line x1="10.4" y1="10.4" x2="14" y2="14"/></svg>
          <span class="hs-text">Go to</span>
          <kbd class="hs-kbd" aria-hidden="true">⌘K</kbd>
        </button>
        <a class="header-search header-lexicon" href={`${base}/lemma/`} aria-label="Greek Lexicon">
          <svg class="hs-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M8 3.6C6.6 2.6 4.2 2.6 2.6 3.1v9C4.2 11.6 6.6 11.6 8 12.6M8 3.6C9.4 2.6 11.8 2.6 13.4 3.1v9C11.8 11.6 9.4 11.6 8 12.6M8 3.6v9"/></svg>
          <span class="hs-text">Lexicon</span>
        </a>
        <span class="bar-divider" aria-hidden="true"></span>
        <button type="button" class="settings-toggle" aria-label="Reader settings" aria-expanded="false">
          <svg class="settings-icon" width="18" height="14" viewBox="0 0 18 14" aria-hidden="true" fill="currentColor" stroke="none">
            <rect x="1" y="0" width="16" height="1.5" rx="0.75"/>
            <circle cx="5.5" cy="0.75" r="2.5"/>
            <rect x="1" y="6.25" width="16" height="1.5" rx="0.75"/>
            <circle cx="12.5" cy="7" r="2.5"/>
            <rect x="1" y="12.5" width="16" height="1.5" rx="0.75"/>
            <circle cx="7.5" cy="13.25" r="2.5"/>
          </svg>
          <span class="settings-text">Settings</span>
        </button>
        <HelpButton client:load />
        <ThemeToggle />
        <a class="header-support" href={SUPPORT_URL} target="_blank" rel="noopener" title="Support the site" aria-label="Support the site">
          <span class="hsup-heart" aria-hidden="true">♥</span>
          <span class="hsup-text">Support</span>
        </a>
      </div>
    </div>
    <!-- Control row (John's layout, 2026-07-25): two groups — navigation
         (left: Contents, Scenes, Jump to…, book stepper) and reading
         controls (right: translation, view, posture, Chart Room) — split by
         `justify-content: space-between`, wrapping BETWEEN groups rather
         than mid-group if the row can't fit both (see global.css: the
         container wraps, each group itself doesn't). Visible >=681px;
         phones (<=680px) are unchanged (Contents drawer is the sole nav hub,
         translation/view live in the ⚙ Settings sidebar, the reader-controls
         strip carries only the posture toggle). -->
    <div class="nav-panel" id="nav-panel">
      <!-- Content measure (John, coordinator's fix, 2026-07-25): at wide
           viewports the two groups used to span the full header width,
           reading as a band stretched for a narrower screen. This wrapper
           caps the row's CONTENT (not the tinted band itself, which stays
           full-width on .nav-panel above) to the same measure the reading
           column uses — global.css's `.reader-body { max-width: calc(1080px
           * var(--colw-scale, 1)); }` — so the two groups align with the
           text's own edges and stop drifting apart as the window grows.
           See global.css's `.nav-panel-inner` for the matching padding that
           makes the alignment exact, not just the same max-width. -->
      <div class="nav-panel-inner">
      <div class="nav-group-left">
        <!-- Contents, control-row copy (John, 2026-07-25, final form:
             "Contents lives in the control row at every width" — an
             earlier 681-899/900+ split with a THIRD, beside-the-wordmark
             markup copy was scrapped the same day). This is a SECOND
             .toc-toggle instance — the phone drawer's own copy in
             .header-mobile-toggles is the other one, and it also doubles as
             the short-landscape header's own Contents (Job 4, same day) —
