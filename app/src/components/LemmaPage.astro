---
// A single lemma's reference page (the "lemma pages" spike), served at
// /lemma/<slug>. Fuses three layers over one Greek word:
//   ① LSJ definition (English)            — what it means
//   ② corpus-wide frequency + per-work    — how much Homer uses it
//   ③ a concordance sample                — every use links back into the reader
// Data is precomputed by scripts/build-lemmata.mjs into
// public/data/lemmata/<slug>.json; this page just renders it at build time.
import { readFileSync } from 'node:fs';
import ThemeInit from './ThemeInit.astro';
import SiteHeader from './SiteHeader.astro';
import Crumbs from './Crumbs.astro';
import Pwa from './Pwa.astro';
import { getWork, workPath, workLanding, bookLabel, isBookless } from '@shared/lib/works';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '../styles/edition-pages.css';

interface Props { slug: string; }
const { slug } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Instance = [col: string, line: number, surface: string];
interface ChapterInstances { chapter: string; bekker: string; instances: Instance[]; }
interface BookInstances { book: number; chapters: ChapterInstances[]; }
interface WorkInstances { work: string; title: string; count: number; shown: number; books: BookInstances[]; }
interface LemmaData {
  slug: string; key: string; head: string; lemmaBeta: string;
  count: number; glosses: string[];
  byWork: { work: string; title: string; count: number }[];
  instancesByWork: WorkInstances[];
  truncated: boolean;
}
const data: LemmaData = JSON.parse(
  readFileSync(`public/data/lemmata/${slug}.json`, 'utf-8'),
);

// The LSJ entry is served by grammata's T8 lookup at runtime — the same
// widget the reader's popup mounts — ported from aristotle-reader PR #109
// (John, 2026-09-03). Until then this page rendered the local shards through
// shared/lib/html.ts at build time. The LSJ key is the same beta-code key the
// concordance attributed the lemma to.

// Deep-link an instance back into the reader: scroll to the Bekker line and
// highlight the Greek word (the same ?hlg=&loc= mechanism search uses).
const instHref = (work: string, book: number, [col, line, surface]: Instance) =>
  `${base}${workPath(work, book)}?hlg=${encodeURIComponent(surface)}&loc=${col}:${line}`;

// For the frequency bars: scale each work's count against the most-frequent work
// (byWork is sorted desc) so the bars are directly comparable at a glance.
const maxWork = data.byWork[0]?.count ?? 1;

// Precompute the per-work view (book labels, per-book counts, flat-vs-drilldown)
// in the frontmatter — comparison operators like `<=` inside inline template
// expressions confuse Astro's JSX parser, so no logic lives in the markup.
const worksView = data.instancesByWork.map((w) => {
  const ww = getWork(w.work);
  const bookless = ww ? isBookless(ww) : false;
  return {
    ...w,
    bookless,
    // A poem is cited book.line and has no chapters: its occurrences read
    // "1.75", under the book alone.
    verse: ww?.citation?.scheme === 'verse-line',
    flat: w.shown <= 30,             // small entries render fully expanded
    capped: w.shown < w.count,       // per-lemma INSTANCE_CAP truncated this work
    barPct: Math.max(2, (w.count / maxWork) * 100),
    books: w.books.map((bk) => ({
      book: bk.book,
      label: ww ? bookLabel(ww, bk.book) : String(bk.book),
      bookCount: bk.chapters.reduce((n, c) => n + c.instances.length, 0),
      chapters: bk.chapters,
    })),
  };
});

// ── SEO ─────────────────────────────────────────────────────────────────────
const gloss = data.glosses[0] ?? '';
const pageTitle = `${data.head} (${data.slug}) — Homer's Greek Lexicon: ${gloss || 'definition & occurrences'}`;
const metaDescription =
  `${data.head} in Homer${gloss ? ` — "${gloss}"` : ''}. Appears ${data.count}` +
  ` times across the corpus (${data.byWork.slice(0, 3).map((b) => b.title).join(', ')}…),` +
  ` with the LSJ definition, frequency by work, and every occurrence linked to the` +
  ` parallel Greek–English text with vulgate line citation.`;
const canonical = Astro.site
  ? new URL(`${base}/lemma/${data.slug}/`, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const definedTerm = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: data.head,
  ...(gloss ? { description: gloss } : {}),
  inLanguage: 'grc',
  ...(canonical ? { url: canonical } : {}),
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: "Lexicon of Homer's Greek",
    url: Astro.site ? new URL(`${base}/lemma/`, Astro.site).href : undefined,
  },
};
const breadcrumb = Astro.site ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Homer', item: new URL(`${base}/`, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Greek Lexicon', item: new URL(`${base}/lemma/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.head, item: canonical },
  ],
} : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Homer Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(definedTerm)} />
  {breadcrumb && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumb)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    /* Page frame and section heads are the shared reference-page pattern
       (styles/edition-pages.css). Nothing here reaches inside the grammata
       dictionary container, which styles itself. */
    .lx-top { padding-bottom: var(--space-5); }
    .lx-head-gk { font-family: var(--font-greek); font-weight: 400; font-size: clamp(3.25rem, 8vw, 5.5rem); line-height: 1.05; color: var(--text); margin: 0 0 0 -0.03em; }
    .lx-translit { margin-top: 0.75rem; font: 500 var(--step--1)/1.3 var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mid); }
    .lx-gloss { max-width: 44rem; margin-top: var(--space-4); font-size: clamp(1.25rem, 1.8vw, 1.5rem); line-height: 1.4; color: var(--text); text-wrap: pretty; }
    .lx-freq { margin-top: var(--space-4); font: 500 0.9375rem/1.4 var(--font-ui); color: var(--text-mid); }
    .lx-freq b { font-family: var(--font-display); font-weight: 400; font-size: 1.75rem; line-height: 1; letter-spacing: -0.01em; color: var(--accent); font-variant-numeric: lining-nums; margin: 0 0.125rem; }
    .lx-cols { max-width: 58rem; }
    h2.lx-h { font-family: var(--font-display); font-weight: 400; font-size: var(--step-3); line-height: 1.1; letter-spacing: -0.015em; color: var(--text); margin: var(--space-6) 0 var(--space-3); padding-top: var(--space-5); border-top: 1px solid var(--border); }
    /* Frequency-by-work: a ranked list with proportional bars so relative
       counts are readable at a glance (pills hid the comparison). */
    .lx-freqbars { list-style: none; padding: 0; margin: var(--space-4) 0 0; }
    .lx-freqbars > li { margin: 0; border-bottom: 1px solid var(--border); }
    .fb-item > summary {
      display: grid; grid-template-columns: minmax(6rem, 11rem) 1fr 4rem 1.25rem;
      align-items: center; gap: var(--space-4); cursor: pointer; list-style: none;
      min-height: 3.25rem; padding: 0.5rem 0;
    }
    .fb-item > summary::-webkit-details-marker { display: none; }
    .fb-name { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fb-item > summary:hover .fb-name { color: var(--accent); }
    .fb-track { height: 0.625rem; background: var(--surface-sunk); border-radius: var(--radius-pill); overflow: hidden; }
    .fb-fill { display: block; height: 100%; background: var(--accent); border-radius: var(--radius-pill); }
    .fb-item[data-work="iliad"] .fb-fill { background: var(--iliad); }
    .fb-item[data-work="odyssey"] .fb-fill { background: var(--odyssey); }
    .fb-n { font: 600 0.9375rem/1 var(--font-ui); font-variant-numeric: tabular-nums; color: var(--text); text-align: right; }
    .fb-caret { font-size: 0.8125rem; color: var(--text-mid); transition: transform .12s ease; justify-self: center; }
    .fb-item[open] > summary .fb-caret { transform: rotate(90deg); }
    .fb-cites { padding: 0.25rem 0 var(--space-4); }
    .fb-open { display: inline-block; font: 600 0.9375rem/1.2 var(--font-ui); color: var(--accent); text-decoration: none; margin: 0 0 var(--space-3); }
    .fb-open:hover { text-decoration: underline; text-underline-offset: 0.25em; }
    .fb-citelist { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.375rem; }
    .fb-citelist a {
      display: inline-flex; align-items: center; min-height: 1.75rem; padding: 0 0.625rem;
      border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--col-bg);
      font: 600 var(--step--1)/1 var(--font-ui); font-variant-numeric: tabular-nums;
      color: var(--accent); text-decoration: none;
    }
    .fb-citelist a:hover { border-color: var(--accent); }
    /* Grouped citation list inside an expanded work: book + chapter headings. */
    .fb-book-group { margin: 0 0 0.9rem; }
    /* Collapsible book (multi-book works): a compact summary row you drill into. */
    .fb-book-d { border-top: 1px solid var(--border); }
    .fb-book-d > summary {
      display: flex; align-items: center; gap: 0.5rem; cursor: pointer; list-style: none;
      min-height: 2.5rem; padding: 0.25rem 0;
    }
    .fb-book-d > summary::-webkit-details-marker { display: none; }
    .fb-book-d > summary:hover .fb-book { color: var(--accent); }
    .fb-book { font: 600 0.9375rem/1.2 var(--font-ui); color: var(--text); }
    .fb-book-n { font: 500 var(--step--1)/1 var(--font-ui); font-variant-numeric: tabular-nums; color: var(--text-mid); margin-left: auto; }
    .fb-book-caret { font-size: 0.75rem; }
    .fb-book-d[open] > summary .fb-book-caret { transform: rotate(90deg); }
    .fb-book-body { padding: 0.125rem 0 0.75rem; }
    .fb-chapter { margin: 0 0 0.75rem; }
    .fb-ch-head { display: flex; align-items: baseline; gap: 0.5rem; margin: 0 0 0.375rem; }
    .fb-ch-label { font: 600 var(--step--1)/1.2 var(--font-ui); color: var(--text-mid); }
    .fb-ch-bekker { font: 500 var(--step--1)/1.2 var(--font-ui); color: var(--text-mid); font-variant-numeric: tabular-nums; }
    .lsj { font-size: 0.95rem; line-height: 1.6; color: var(--text); }
    .lsj :global(.lsj-head) { font-family: var(--font-greek); }
    .lx-note { font: 400 0.9375rem/1.5 var(--font-ui); color: var(--text-mid); margin: 0.375rem 0 0; }
    .lx-back { display: inline-block; margin: var(--space-7) 0 0; font: 600 0.9375rem/1.2 var(--font-ui); color: var(--accent); text-decoration: none; }
    .lx-back:hover { text-decoration: underline; text-underline-offset: 0.25em; }
    @media (max-width: 760px) {
      .fb-item > summary { grid-template-columns: minmax(0, 6.5rem) 1fr 3.25rem 1rem; gap: var(--space-3); }
      h2.lx-h { font-size: 1.75rem; }
    }
    @media (prefers-reduced-motion: reduce) { .fb-caret { transition: none; } }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader section={data.head} />

  <main class="pg lx-body">
    <header class="pg-head lx-top">
    <Crumbs />
    <h1 class="lx-head-gk" lang="grc">{data.head}</h1>
    <p class="lx-translit">{data.slug}</p>
    {gloss && <p class="lx-gloss">{data.glosses.join('; ')}</p>}
    <p class="lx-freq">Appears <b>{data.count.toLocaleString()}</b> times across Homer's epics.</p>
    <p class="lx-onward">
      <a href="#lx-uses">Every occurrence, by book and line</a>
      <a href={`${base}/search?g=${encodeURIComponent(data.head)}`}>Read them in context <span aria-hidden="true">→</span></a>
    </p>
    </header>

    <div class="lx-cols">

    <h2 class="lx-h" id="lx-uses">Frequency by work</h2>
    <p class="lx-note">Click a work to list every occurrence by book &amp; line — each links into the reader.</p>
    <ul class="lx-freqbars">
      {worksView.map((w) => (
        <li>
          <details class="fb-item" data-work={w.work} open={w.flat}>
            <summary>
              <span class="fb-name">{w.title}</span>
              <span class="fb-track"><span class="fb-fill" style={`width:${w.barPct}%`}></span></span>
              <span class="fb-n">{w.count.toLocaleString()}</span>
              <span class="fb-caret" aria-hidden="true">▸</span>
            </summary>
            <div class="fb-cites">
              <a class="fb-open" href={`${base}${workLanding(w.work)}`}>Open {w.title} ›</a>
              {w.books.map((bk) => (
                w.bookless ? (
                  <div class="fb-book-group">
                    {bk.chapters.map((ch) => (
                      <div class="fb-chapter">
                        <div class="fb-ch-head">
                          <span class="fb-ch-label">Chapter {ch.chapter}</span>
                          {ch.bekker && <span class="fb-ch-bekker">{ch.bekker}</span>}
                        </div>
                        <ul class="fb-citelist">
                          {ch.instances.map((inst) => (
                            <li><a href={instHref(w.work, bk.book, inst)}>{inst[0]}{inst[1]}</a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ) : (
                  <details class="fb-book-d" open={w.flat}>
                    <summary class="fb-book-sum">
                      <span class="fb-book">Book {bk.label}</span>
                      <span class="fb-book-n">{bk.bookCount}</span>
                      <span class="fb-caret fb-book-caret" aria-hidden="true">▸</span>
                    </summary>
                    <div class="fb-book-body">
                      {bk.chapters.map((ch) => (
                        <div class="fb-chapter">
                          {!w.verse && (
                            <div class="fb-ch-head">
                              <span class="fb-ch-label">Chapter {ch.chapter}</span>
                              {ch.bekker && <span class="fb-ch-bekker">{ch.bekker}</span>}
                            </div>
                          )}
                          <ul class="fb-citelist">
                            {ch.instances.map((inst) => (
                              <li><a href={instHref(w.work, bk.book, inst)}>{w.verse ? `${inst[0]}.${inst[1]}` : `${inst[0]}${inst[1]}`}</a></li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                )
              ))}
              {w.capped && (
                <p class="lx-note">Showing {w.shown.toLocaleString()} of {w.count.toLocaleString()} (list capped).</p>
              )}
            </div>
          </details>
        </li>
      ))}
    </ul>

    {data.key && (
      <>
        <h2 class="lx-h">Dictionary (LSJ)</h2>
        <div class="grammata-mount" data-key={data.key} lang="grc">Loading the dictionary entry…</div>
      </>
    )}

    </div>

    <a class="lx-back" href={`${base}/lemma/`}>‹ All lexicon entries</a>
  </main>
</body>
</html>

<script>
  // Served by grammata (grammar-site's deploy), not rendered here — the same
  // contract as the reader's popup: do not vendor, proxy, pin or cache-bust
  // this URL (its deploys ARE the update mechanism) and do not style anything
  // inside the container. With a key the word argument is ignored; lang:'grc'
  // skips the Latin fetch.
  // PUBLIC_GRAMMATA_LOOKUP names another address at BUILD time, as there.
  const GRAMMATA_LOOKUP: string =
    import.meta.env.PUBLIC_GRAMMATA_LOOKUP || 'https://grammata.pages.dev/t8/lookup.js';
  const mount = document.querySelector<HTMLElement>('.grammata-mount');
  const key = mount?.dataset.key;
  if (mount && key) {
    // @vite-ignore keeps the remote specifier out of the bundle graph.
    import(/* @vite-ignore */ GRAMMATA_LOOKUP)
      .then((m) => m.lookup('', mount, { lang: 'grc', key }))
      .catch((e) => {
        // A failed module load is the one case the widget cannot report itself.
        mount.textContent = 'The dictionary entry is not available here.';
        console.error('[grammata] lookup failed', e);
      });
  }
</script>
