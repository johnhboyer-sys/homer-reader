---
// The one site header. Every page that is not the reader itself carries this
// bar (home, the two poem indexes, the apparatus and utility pages); the
// reader's own bar (ReaderShell.astro) is the same height, wordmark and
// control grammar with the reading tools in the middle.
//
// Navigation is grouped, not a flat row: the two poems are direct links, the
// rest sit in three short menus (Atlas, People, Language), then Search and the
// theme switch. From 900px down the groups fold into one menu sheet with
// 44px rows. Without script the menus are plain CSS (:hover / :focus-within,
// and a <details> for the phone sheet); with it, lib/site-menu.ts makes the
// three triggers real disclosures (aria-expanded, Enter/Space, Escape).
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Kept while callers migrate; page labels belong to their own h1s. */
  section?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = base && Astro.url.pathname.startsWith(`${base}/`)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;

interface Item { label: string; href: string; prefix: string; }
const item = (label: string, path: string, prefix = path.replace(/\/$/, '')): Item =>
  ({ label, href: `${base}${path}`, prefix });

const poems: Item[] = [item('Iliad', '/iliad'), item('Odyssey', '/odyssey')];
const groups: { label: string; items: Item[] }[] = [
  { label: 'Atlas', items: [item('Maps', '/maps/'), item('Places', '/places/'), item('Timeline', '/timeline/')] },
  { label: 'People', items: [item('Characters', '/characters/'), item('Genealogies', '/genealogies/')] },
  {
    label: 'Language',
    items: [
      item('Vocabulary', '/vocabulary/'),
      item('Formulas', '/formulas/'),
      item('Repetitions', '/repetitions/'),
      item('Phrases', '/phrases/'),
      item('Lexicon', '/lemma/'),
      item('Advanced search', '/advanced'),
    ],
  },
];
const about = item('About', '/about');
const search = item('Search', '/search');

const isCurrent = (i: Item) => pathname === i.prefix || pathname.startsWith(`${i.prefix}/`);
const groupCurrent = (g: { items: Item[] }) => g.items.some(isCurrent);
---
<header class="sh">
  <div class="sh-inner">
    <a class="sh-wordmark" href={`${base}/`} aria-label="The Homer Reader — home">The Homer Reader</a>

    <nav class="sh-nav" aria-label="Site">
      {poems.map((p) => (
        <a class:list={['sh-link', { 'is-current': isCurrent(p) }]} href={p.href} aria-current={isCurrent(p) ? 'page' : undefined}>{p.label}</a>
      ))}
      <span class="sh-rule" aria-hidden="true"></span>
      {groups.map((g) => (
        <div class="sh-group">
          <button type="button" class:list={['sh-link', 'sh-group-btn', { 'is-current': groupCurrent(g) }]} aria-controls={`sh-menu-${g.label.toLowerCase()}`}>
            {g.label}
            <svg width="9" height="6" viewBox="0 0 9 6" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="sh-menu" id={`sh-menu-${g.label.toLowerCase()}`}>
            {g.items.map((i) => (
              <a class:list={['sh-menu-link', { 'is-current': isCurrent(i) }]} href={i.href} aria-current={isCurrent(i) ? 'page' : undefined}>{i.label}</a>
            ))}
          </div>
        </div>
      ))}
      <a class:list={['sh-link', { 'is-current': isCurrent(about) }]} href={about.href} aria-current={isCurrent(about) ? 'page' : undefined}>{about.label}</a>
    </nav>

    <div class="sh-tools">
      <a class:list={['sh-search', { 'is-current': isCurrent(search) }]} href={search.href} aria-label="Search" aria-current={isCurrent(search) ? 'page' : undefined}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="6.8" cy="6.8" r="4.6"/><line x1="10.4" y1="10.4" x2="14" y2="14"/></svg>
        <span>Search</span>
      </a>
      <ThemeToggle />
      <details class="sh-mobile">
        <summary aria-label="Menu">
          <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M1 1h16M1 7h16M1 13h16"/></svg>
          <span>Menu</span>
        </summary>
        <nav class="sh-sheet" aria-label="Site menu">
          <div class="sh-sheet-group">
            <p class="sh-sheet-label">Read</p>
            {poems.map((p) => (
              <a class:list={['sh-sheet-link', { 'is-current': isCurrent(p) }]} href={p.href} aria-current={isCurrent(p) ? 'page' : undefined}>{p.label}</a>
            ))}
          </div>
          {groups.map((g) => (
            <div class="sh-sheet-group">
              <p class="sh-sheet-label">{g.label}</p>
              {g.items.map((i) => (
                <a class:list={['sh-sheet-link', { 'is-current': isCurrent(i) }]} href={i.href} aria-current={isCurrent(i) ? 'page' : undefined}>{i.label}</a>
              ))}
            </div>
          ))}
          <div class="sh-sheet-group">
            <p class="sh-sheet-label">The edition</p>
            <a class:list={['sh-sheet-link', { 'is-current': isCurrent(search) }]} href={search.href} aria-current={isCurrent(search) ? 'page' : undefined}>Search</a>
            <a class:list={['sh-sheet-link', { 'is-current': isCurrent(about) }]} href={about.href} aria-current={isCurrent(about) ? 'page' : undefined}>About</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import { initSiteMenus } from '../lib/site-menu';
  document.querySelectorAll<HTMLElement>('header.sh').forEach((h) => initSiteMenus(h));
</script>

<style>
  .sh {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--col-bg) 92%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-ui);
  }
  .sh-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--bar-h);
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }
  .sh-wordmark {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.5rem 0;
  }
  .sh-wordmark:hover { color: var(--accent); }

  .sh-nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-left: auto;
  }
  .sh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--radius-1);
    background: none;
    font: 500 0.875rem/1 var(--font-ui);
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .sh-link:hover,
  .sh:not(.sh-js) .sh-group:hover > .sh-link,
  .sh:not(.sh-js) .sh-group:focus-within > .sh-link,
  .sh-group.is-open > .sh-link { color: var(--text); background: color-mix(in srgb, var(--text) 6%, transparent); }
  .sh-group.is-open > .sh-group-btn svg { transform: rotate(180deg); }
  .sh-link.is-current { color: var(--accent); }
  .sh-rule { width: 1px; height: 1.125rem; background: var(--border); margin: 0 0.5rem; }

  .sh-group { position: relative; }
  .sh-group-btn svg { opacity: 0.8; }
  .sh-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 12.5rem;
    padding: 0.375rem;
    background: var(--popup-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-2);
    display: grid;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.12s ease, transform 0.12s ease, visibility 0s linear 0.12s;
  }
  /* A bridge across the gap between the button and its menu, so the pointer
     can travel down without the menu closing under it. */
  .sh-menu::before { content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 0.75rem; }
  /* Without script: hover or focus opens. With it (.sh-js, set by
     lib/site-menu.ts): the is-open class is the one source of truth, so
     Escape can close a menu while focus is still on its trigger. */
  .sh:not(.sh-js) .sh-group:hover > .sh-menu,
  .sh:not(.sh-js) .sh-group:focus-within > .sh-menu,
  .sh-group.is-open > .sh-menu {
    visibility: visible;
    opacity: 1;
    transform: translateY(6px);
    transition-delay: 0s;
  }
  .sh-menu-link {
    display: block;
    padding: 0.5625rem 0.75rem;
    border-radius: var(--radius-1);
    font: 500 0.875rem/1.2 var(--font-ui);
    color: var(--text);
    text-decoration: none;
  }
  .sh-menu-link:hover { background: color-mix(in srgb, var(--accent) 9%, transparent); color: var(--accent); }
  .sh-menu-link.is-current { color: var(--accent); }

  .sh-tools { display: flex; align-items: center; gap: 0.5rem; }
  .sh-search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 0.875rem 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--col-bg);
    font: 500 0.875rem/1 var(--font-ui);
    color: var(--text);
    text-decoration: none;
  }
  .sh-search:hover, .sh-search.is-current { border-color: var(--accent); color: var(--accent); }

  .sh :global(.theme-toggle) {
    width: 2.25rem;
    height: 2.25rem;
    min-height: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--text);
  }
  .sh :global(.theme-toggle:hover) { color: var(--accent); background: color-mix(in srgb, var(--text) 6%, transparent); border-color: transparent; }

  .sh-link:focus-visible,
  .sh-menu-link:focus-visible,
  .sh-search:focus-visible,
  .sh-wordmark:focus-visible,
  .sh-sheet-link:focus-visible,
  .sh-mobile summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Phone / narrow: one Menu button, one sheet. */
  .sh-mobile { display: none; }
  .sh-mobile summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--col-bg);
    font: 600 0.875rem/1 var(--font-ui);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }
  .sh-mobile summary::-webkit-details-marker { display: none; }
  .sh-mobile[open] summary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .sh-sheet {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - var(--bar-h));
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
    padding: var(--space-5) var(--space-5) var(--space-6);
    background: var(--popup-bg);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-2);
  }
  .sh-sheet-label {
    font: 600 0.6875rem/1 var(--font-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light);
    margin: 0 0 0.25rem;
    padding: 0 0.5rem;
  }
  .sh-sheet-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-1);
    font: 500 1.0625rem/1.2 var(--font-ui);
    color: var(--text);
    text-decoration: none;
  }
  .sh-sheet-link:hover { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .sh-sheet-link.is-current { color: var(--accent); }

  @media (max-width: 900px) {
    .sh-nav { display: none; }
    .sh-tools { margin-left: auto; }
    .sh-mobile { display: block; }
    .sh-inner { padding: 0 var(--space-4); gap: var(--space-3); }
    .sh-search { width: 2.75rem; height: 2.75rem; padding: 0; justify-content: center; }
    .sh-search span { display: none; }
    /* Three round buttons of one kind: search, theme, menu. */
    .sh :global(.theme-toggle) { width: 2.75rem; height: 2.75rem; border-color: var(--border); background: var(--col-bg); }
  }
  @media (max-width: 430px) {
    .sh-wordmark { font-size: 1.25rem; }
    .sh-inner { gap: var(--space-2); }
    .sh-tools { gap: 0.375rem; }
    .sh-mobile summary span { display: none; }
    .sh-mobile summary { width: 2.75rem; padding: 0; justify-content: center; }
  }
  @media (max-width: 350px) {
    .sh-tools { gap: 0.125rem; }
    .sh-wordmark { font-size: 1.125rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sh-menu { transition: none; }
  }
</style>
