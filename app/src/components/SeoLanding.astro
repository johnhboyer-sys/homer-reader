---
// Shared shell for the Phase-5 SEO landing pages (/read-the-odyssey-online/,
// /read-the-iliad-online/, /the-odyssey-in-greek-and-english/,
// /the-iliad-in-greek-and-english/, /catalogue-of-ships-map/). These five
// pages are near-identical in structure (simple-header + prose + FAQ), so —
// unlike the apparatus/reference pages (genealogies, maps, attribution,
// support), which each duplicate their own <head> boilerplate — they share
// one component to avoid five copies of the same ~90 lines. Each page still
// owns 100% of its own words: this component only supplies chrome, canonical/
// OG/FAQPage meta, and layout; content is the default slot.
import ThemeInit from './ThemeInit.astro';
import SiteHeader from './SiteHeader.astro';
import Pwa from './Pwa.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '../styles/edition-pages.css';

interface Faq { q: string; a: string; }
interface Props {
  path: string;           // e.g. '/read-the-odyssey-online/' (leading+trailing slash)
  pageTitle: string;
  metaDescription: string;
  eyebrow: string;
  h1: string;
  faqs: Faq[];
}
const { path, pageTitle, metaDescription, eyebrow, h1, faqs } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Which poem's ground the title panel takes: the Odyssey pages the sea, the
// Iliad pages (and the Catalogue of Ships, which is Iliad 2) the ember.
const poem = path.includes('odyssey') ? 'odyssey' : 'iliad';
const canonical = Astro.site ? new URL(`${base}${path}`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Homer Reader' },
};
const faqLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit greek={false} italic />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Homer Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(webPageLd)} />
  {faqLd && <script type="application/ld+json" set:html={jsonLdSafe(faqLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    body { overflow-x: hidden; max-width: 100%; }
    /* Title panel in the poem's own night colours (the home hero's values,
       local until they are tokens); below it the shared prose pattern from
       styles/edition-pages.css. Slotted content belongs to the page that
       supplies it, so its rules are written :global under .seo-prose. */
    .seo-hero {
      --hero-accent: var(--hero-iliad-accent);
      position: relative;
      overflow: hidden;
      isolation: isolate;
      color: var(--hero-ink);
      background:
        radial-gradient(90% 80% at 22% 125%, color-mix(in srgb, var(--hero-iliad-glow) 62%, transparent) 0%, color-mix(in srgb, var(--hero-iliad-ember) 28%, transparent) 38%, transparent 68%),
        var(--hero-iliad-night);
    }
    .seo-hero[data-poem="odyssey"] {
      --hero-accent: var(--hero-odyssey-accent);
      background:
        radial-gradient(80% 90% at 82% -25%, color-mix(in srgb, var(--hero-odyssey-glow) 55%, transparent) 0%, color-mix(in srgb, var(--hero-odyssey-deep) 25%, transparent) 40%, transparent 70%),
        var(--hero-odyssey-night);
    }
    .seo-hero-inner { position: relative; max-width: 82rem; margin: 0 auto; padding: clamp(2.5rem, 5.5vw, 4.5rem) var(--space-5) clamp(2.5rem, 5vw, 4rem); }
    .seo-eyebrow { font: 600 var(--step--1)/1.3 var(--font-ui); color: var(--hero-accent); margin: 0 0 1rem; }
    h1 {
      max-width: 14em;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(2.75rem, 6vw, 4.75rem);
      line-height: 1;
      letter-spacing: -0.022em;
      margin: 0 0 0 -0.03em;
      color: var(--hero-ink);
      text-wrap: balance;
    }
    .seo-hero-art {
      position: absolute;
      right: var(--space-5);
      bottom: 0;
      width: min(40%, 32rem);
      height: 86%;
      background: var(--hero-accent);
      opacity: 0.42;
      -webkit-mask: var(--art) right bottom / contain no-repeat;
      mask: var(--art) right bottom / contain no-repeat;
      z-index: -1;
    }
    /* 480px art (the drawing stands at most ~400 CSS px wide here); the
       720px cut for a high-density screen. */
    @media (-webkit-min-device-pixel-ratio: 1.5), (min-resolution: 1.5dppx) {
      .seo-hero-art { -webkit-mask-image: var(--art-2x); mask-image: var(--art-2x); }
    }
    .seo-body { padding-top: var(--space-6); }
    .seo-prose :global(p:first-child) { grid-column: 1 / -1; max-width: 50rem; margin-bottom: var(--space-6); font-size: clamp(1.25rem, 1.7vw, 1.4375rem); line-height: 1.5; color: var(--text); }
    .seo-prose :global(em) { font-style: italic; }
    .seo-prose :global(.seo-cta-row) { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-top: var(--space-3); }
    .seo-prose :global(.seo-cta) {
      display: inline-flex;
      align-items: center;
      min-height: 2.875rem;
      padding: 0 1.375rem;
      border: 1px solid var(--accent);
      border-radius: var(--radius-pill);
      background: var(--accent);
      color: var(--on-accent);
      font: 600 0.9375rem/1 var(--font-ui);
      text-decoration: none;
    }
    .seo-prose :global(.seo-cta:hover) { filter: brightness(1.1); }
    .seo-prose :global(.seo-cta.secondary) { background: transparent; border-color: var(--rule-strong); color: var(--text); }
    .seo-prose :global(.seo-cta.secondary:hover) { filter: none; border-color: var(--accent); color: var(--accent); }
    .seo-faq { margin-top: var(--space-6); }
    .seo-faq-item { margin-bottom: var(--space-5); }
    .seo-faq-item .q { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.25; color: var(--text); margin: 0 0 0.375rem; }
    .seo-faq-item .a { font-size: 1.125rem; line-height: 1.6; color: var(--text-mid); margin: 0; }
    @media (max-width: 900px) {
      .seo-hero-inner { padding-left: var(--space-4); padding-right: var(--space-4); }
      .seo-hero-art { width: 54%; height: 50%; right: 0; opacity: 0.24; }
    }
    @media (max-width: 560px) { .seo-hero-art { display: none; } }
  </style>
  <Pwa />
</head>
<body>
  <SiteHeader />

  <main>
    <section class="seo-hero" data-poem={poem}>
      <div class="seo-hero-inner">
        <p class="seo-eyebrow">{eyebrow}</p>
        <h1>{h1}</h1>
        <span class="seo-hero-art" aria-hidden="true" style={`--art:url('${base}/art/hero/${poem}-480.webp');--art-2x:url('${base}/art/hero/${poem}-sm.webp')`}></span>
      </div>
    </section>
    <div class="pg seo-body">
      <div class="pg-prose seo-prose">
        <slot />
      </div>
      {faqs.length > 0 && (
        <section class="pg-prose seo-faq" aria-labelledby="seo-faq-h">
          <h2 id="seo-faq-h">Questions</h2>
          {faqs.map((f) => (
            <div class="seo-faq-item">
              <p class="q">{f.q}</p>
              <p class="a">{f.a}</p>
            </div>
          ))}
        </section>
      )}
    </div>
  </main>
</body>
</html>
