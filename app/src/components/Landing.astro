---
// A work's landing page, served at the bare /<work> slug. An overview that
// describes the work, credits the Greek source + translations, lists the
// table of contents (linking into the reader), surfaces the "start reading"
// editions, and points to in-print modern translations/commentaries we can't
// host. The reader itself lives at /<work>/book/<n> for every work.
import { readFileSync } from 'node:fs';
import ThemeInit from './ThemeInit.astro';
import SiteHeader from './SiteHeader.astro';
import Pwa from './Pwa.astro';
import {
  AUTHENTICITY_LABEL, getWork, bookLabel, isBookless, workPath, visibleTranslations,
  furtherReading, inPrintHref, workLanding, resourcesFor,
} from '@shared/lib/works';
import { assignSpeakerSlots, collectDisplayOrder } from '@shared/lib/speaker-colors';
import { SUPPORT_URL } from '../lib/support';
import { sanitizeHtml } from '../lib/html';
import { jsonLdSafe } from '../lib/jsonld';
import { bookArguments } from '../lib/book-apparatus';
import '@shared/styles/global.css';
import '../styles/edition-pages.css';

interface Props { workId: string; }
const { workId } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const work = getWork(workId)!;
const bookless = isBookless(work);
const verseLine = work.citation?.scheme === 'verse-line';
// Project the same emitted book data used by the reader's contents rail. The
// helper is memoized per work, so this remains a small build-time read.
const bookApparatus = verseLine ? bookArguments(workId, work.books) : [];
const hasDraftArgument = bookApparatus.some(({ argument, draft }) => Boolean(argument) && draft === true);
// Stephanus works (Plato) have no chapters.json — stage7 emits sections.json
// (a per-page outline) instead (see manifests/Euthyphro.yaml). Mirrors
// ReaderShell.astro's `stephanus`/`pagesOf` handling.
const stephanus = work.citation?.scheme === 'stephanus';
const citeWord = stephanus ? 'Stephanus' : (work.citation?.scheme === 'busse' ? 'page' : 'Bekker');

interface ChapterRef { chapter: string; column: string; line: string; bekker: string; }
interface SectionRef { column: string; page: number; letter: string; id: string; }
let allChapters: Record<string, ChapterRef[]> = {};
let allSections: Record<string, SectionRef[]> = {};
if (stephanus) {
  try {
    allSections = JSON.parse(readFileSync(`public/data/${workId}/sections.json`, 'utf-8'));
  } catch { /* no sections yet */ }
} else {
  allChapters = JSON.parse(readFileSync(`public/data/${workId}/chapters.json`, 'utf-8'));
}
// Dramatis personae — the speakers in this dialogue, read from each book's
// turnFlow. Coloured with the reader's own palette (shared/lib/speaker-colors,
// keyed by the printed display like the reader) so a speaker's hue matches
// between this cast list and the text. Collected in first-appearance order,
// across every book; shown only when the work has two or more named speakers.
interface CastMember { name: string; abbr: string; slot: number; }
let cast: CastMember[] = [];
{
  // Top-level turn owners in first-appearance order — the cast we display.
  const owners: { s: string; d: string }[] = [];
  const ownerSeen = new Set<string>();
  // Each book's turn flow, kept so the colour roster is built with the SAME
  // collectDisplayOrder(whole work) call ReaderShell.astro uses — guaranteeing a
  // speaker's cast colour matches its colour in every book of the reader.
  type Flow = Parameters<typeof collectDisplayOrder>[0] extends Iterable<infer F> ? F : never;
  const flows: Flow[] = [];
  let total = 0, subTurns = 0, para = false;
  for (let b = 1; b <= work.books; b++) {
    let bd: { turnFlow?: { kind?: string; turns?: Array<{ s: string | null; d: string | null;
      et?: Array<{ d: string | null }> | null;
      sub?: Array<{ d: string | null }> | null }> } };
    try {
      bd = JSON.parse(readFileSync(`public/data/${workId}/book-${String(b).padStart(2, '0')}.json`, 'utf-8'));
    } catch { continue; }
    flows.push(bd.turnFlow as Flow);
    if (bd.turnFlow?.kind === 'para') para = true;
    for (const t of bd.turnFlow?.turns ?? []) {
      total++;
      if (t.sub && t.sub.length) subTurns++;
      if (t.s && t.d && !ownerSeen.has(t.s)) { ownerSeen.add(t.s); owners.push({ s: t.s, d: t.d }); }
    }
  }
  // Only DIRECT dialogues get a cast: the top-level turns must be the actual
  // speakers. Framed narrations (Symposium, Phaedo) and paragraph-narrated works
  // (Republic) recount their dialogue in folded `sub`/embedded prose, so their
  // top-level turns are only the frame — suppress rather than show a misleading
  // cast. (Surfacing the inner speakers of narrated works is deferred editorial
  // work.) Threshold: a majority-`sub` or `kind:"para"` work is a narration.
  const subShare = total ? subTurns / total : 0;
  if (owners.length >= 2 && subShare <= 0.5 && !para) {
    const slots = assignSpeakerSlots(collectDisplayOrder(flows));
    cast = owners.map((o) => ({ name: o.s, abbr: o.d, slot: slots.get(o.d) ?? 0 }));
  }
}

// The Stephanus pages of a book: the first section column on each page, in
// reading order (mirrors ReaderShell.astro's `pagesOf`).
const pagesOf = (b: number): { page: number; column: string }[] => {
  const secs = allSections[String(b)] ?? [];
  const out: { page: number; column: string }[] = [];
  let last: number | null = null;
  for (const s of secs) {
    if (s.page !== last) { out.push({ page: s.page, column: s.column }); last = s.page; }
  }
  return out;
};
interface BookOutline {
  book: number; label: string; chapters: ChapterRef[]; pages: { page: number; column: string }[];
}
const outline: BookOutline[] = Array.from({ length: work.books }, (_, i) => {
  const b = i + 1;
  return {
    book: b, label: bookLabel(work, b),
    chapters: allChapters[String(b)] ?? [],
    pages: stephanus ? pagesOf(b) : [],
  };
});
const totalChapters = stephanus
  ? outline.reduce((n, b) => n + b.pages.length, 0)
  : outline.reduce((n, b) => n + b.chapters.length, 0);
// "N chapters · <Bekker start>–<Bekker end>" (or "N pages · <Stephanus span>"
// for a stephanus work) for a book's row on the landing.
const bookSpan = (b: BookOutline) => {
  if (verseLine) {
    const lines = bookApparatus[b.book - 1]?.lines;
    return lines === undefined ? '' : `${lines} line${lines === 1 ? '' : 's'}`;
  }
  if (stephanus) {
    const n = b.pages.length;
    const first = b.pages[0]?.column ?? '';
    const last = b.pages.at(-1)?.column ?? '';
    const range = first && last ? ` · ${first}–${last}` : '';
    return `${n} page${n === 1 ? '' : 's'}${range}`;
  }
  const n = b.chapters.length;
  const first = b.chapters[0]?.bekker.split('–')[0] ?? '';
  const last = b.chapters.at(-1)?.bekker.split('–').at(-1) ?? '';
  const range = first && last ? ` · ${first}–${last}` : '';
  return `${n} chapter${n === 1 ? '' : 's'}${range}`;
};

const editions = visibleTranslations(work);
const primary = editions.find((t) => t.id === work.defaultTranslation)
  ?? editions.find((t) => t.slot === 'english') ?? editions[0];
const translatorNames = editions.map((t) => t.name.split(' (')[0]);
const commentaries = (work.commentaries ?? [])
  .map((id) => getWork(id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));
const resources = resourcesFor(workId);
const reading = furtherReading(workId);
const readingTrans = reading.filter((r) => r.kind === 'translation');
const readingComm = reading.filter((r) => r.kind === 'commentary');
const readingColl = reading.filter((r) => r.kind === 'collection');

const readHref = (q = '') => `${base}${workPath(workId, 1)}${q}`;

// Flaxman's plate for each book, beside its entry in the contents (the same
// art apparatus and thumbnails the reader's book head uses). A book with no
// plate simply shows none.
interface ArtPlate { work: string; book: number; file: string; caption?: string; }
let artPlates: ArtPlate[] = [];
try {
  artPlates = (JSON.parse(readFileSync('../apparatus/art.json', 'utf-8')) as { plates?: ArtPlate[] }).plates ?? [];
} catch { /* no art apparatus in this build */ }
const plateFor = (book: number) => artPlates.find((pl) => pl.work === workId && pl.book === book);
// public/art/flaxman-xs: 272px thumbs of the flaxman-sm plates, for the book
// list only (cwebp -resize 272 0 -q 40 -alpha_q 40; about 6.5 KB each).
const plateSrc = (pl: ArtPlate) => `${base}/art/flaxman-xs/${pl.file.replace(/\.png$/, '.webp')}`;
const heroArt = workId === 'iliad' || workId === 'odyssey' ? `${base}/art/hero/${workId}-sm.webp` : null;
// The site header's Greek capitals for the two poems, as on the home page.
const heroGreek = work.greekTitle ? work.greekTitle.normalize('NFD').replace(/\p{Mn}/gu, '').replace(/[ʼ'᾽’]/g, '').toUpperCase() : null;

// ── SEO ─────────────────────────────────────────────────────────────────────
const pageTitle = `${work.title} — ${work.author}, in Greek & English`;
const metaDescription =
  `${work.title} by ${work.author}: the original Greek (${work.greekSource.short})` +
  ` with English translation` +
  (translatorNames.length ? ` (${translatorNames.join(', ')})` : '') +
  `, table of contents, morphology, and ${citeWord} citation. ${work.blurb}`;
const canonical = Astro.site
  ? new URL(`${base}${workPath(workId, 1).replace(/\/book\/1$/, '')}/`, Astro.site).href
  : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: work.title,
  ...(work.greekTitle ? { alternateName: work.greekTitle } : {}),
  author: { '@type': 'Person', name: work.author },
  ...(translatorNames.length
    ? { translator: translatorNames.map((name) => ({ '@type': 'Person', name })) }
    : {}),
  inLanguage: ['grc', 'en'],
  ...(canonical ? { url: canonical } : {}),
  numberOfPages: totalChapters,
  isPartOf: { '@type': 'CreativeWorkSeries', name: `The Works of ${work.author}` },
  description: work.blurb,
};
// Breadcrumb (Home › Work) for a SERP breadcrumb rich result. Absolute URLs
// required, so emitted only when Astro.site is set.
const breadcrumbLd = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'The Homer Reader',
          item: new URL(`${base}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: work.title,
          item: new URL(`${base}${workLanding(workId)}/`, Astro.site).href },
      ],
    }
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="book" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Homer Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumbLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <style>
    /* The poem's own title panel: the home page's panel for this poem, at the
       head of its contents page. Dark in both themes, like the home hero; the
       gradient values are the home hero's (local until they are tokens). */
    .lp-hero {
      --hero-accent: var(--hero-iliad-accent);
      position: relative;
      color: var(--hero-ink);
      background:
        radial-gradient(90% 80% at 22% 125%, color-mix(in srgb, var(--hero-iliad-glow) 62%, transparent) 0%, color-mix(in srgb, var(--hero-iliad-ember) 28%, transparent) 38%, transparent 68%),
        var(--hero-iliad-night);
      overflow: hidden;
      isolation: isolate;
    }
    body[data-work="odyssey"] .lp-hero {
      --hero-accent: var(--hero-odyssey-accent);
      background:
        radial-gradient(80% 90% at 82% -25%, color-mix(in srgb, var(--hero-odyssey-glow) 55%, transparent) 0%, color-mix(in srgb, var(--hero-odyssey-deep) 25%, transparent) 40%, transparent 70%),
        var(--hero-odyssey-night);
    }
    .lp-hero-inner {
      position: relative;
      max-width: 82rem;
      margin: 0 auto;
      padding: clamp(2.25rem, 4.5vw, 4rem) var(--space-5) clamp(2.25rem, 4vw, 3.5rem);
    }
    .lp-hero-text { max-width: 40rem; }
    .lp-eyebrow { font: 600 var(--step--1)/1.3 var(--font-ui); color: var(--hero-accent); margin: 0 0 1rem; }
    .lp-eyebrow .lp-eyebrow-gk { margin-left: 0.75rem; font-family: var(--font-greek); font-weight: 400; font-size: 0.875rem; letter-spacing: 0.34em; }
    .lp-title { font-family: var(--font-display); font-size: clamp(3.5rem, 8vw, 6.5rem); font-weight: 400; letter-spacing: -0.025em; margin: 0 0 0 -0.04em; line-height: 0.95; color: var(--hero-ink); }
    .lp-greek { font-family: var(--font-greek); font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.2; color: var(--hero-ink-soft); margin: 0.75rem 0 0; }
    .lp-status, .lp-period { font: 500 var(--step--1)/1.4 var(--font-ui); color: var(--hero-ink-soft); margin: 0.75rem 0 0; }
    .lp-lede { max-width: 34rem; font-size: clamp(1.25rem, 1.8vw, 1.5rem); line-height: 1.4; color: var(--hero-ink); margin: 1.5rem 0 0; text-wrap: balance; }
    .lp-cta-row { display: flex; flex-wrap: wrap; gap: 0.625rem; margin: 2rem 0 0; }
    .lp-btn[hidden] { display: none; }
    .lp-btn { display: inline-flex; align-items: center; gap: 0.5rem; font: 600 0.9375rem/1 var(--font-ui); min-height: 2.875rem; padding: 0 1.375rem; border-radius: var(--radius-pill); text-decoration: none; border: 1px solid color-mix(in srgb, var(--hero-ink) 42%, transparent); color: var(--hero-ink); transition: transform .08s ease, background .15s ease; }
    .lp-btn:hover { background: color-mix(in srgb, var(--hero-ink) 12%, transparent); }
    .lp-btn:active { transform: scale(0.97); }
    .lp-btn.primary { background: var(--hero-ink); color: var(--hero-on-ink); border-color: var(--hero-ink); }
    .lp-btn.primary:hover { background: var(--hero-ink-hover); }
    .lp-btn:focus-visible, .lp-related a:focus-visible { outline: 2px solid var(--hero-accent); outline-offset: 3px; }
    /* Every book, one click from the top of the page. */
    .lp-books { display: flex; align-items: baseline; gap: 0.75rem; margin: 1.75rem 0 0; font-family: var(--font-ui); }
    .lp-books-label { flex: none; font-size: var(--step--1); font-weight: 600; color: var(--hero-ink-soft); }
    .lp-books ol { display: grid; grid-template-columns: repeat(12, 2.125rem); gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
    .lp-books a {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 2.125rem; height: 2.125rem; padding: 0 0.25rem; border-radius: var(--radius-1);
      border: 1px solid color-mix(in srgb, var(--hero-ink) 24%, transparent);
      font-size: 0.875rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--hero-ink); text-decoration: none;
    }
    .lp-books a:hover { background: var(--hero-ink); border-color: var(--hero-ink); color: var(--hero-on-ink); }
    .lp-books a:focus-visible { outline: 2px solid var(--hero-accent); outline-offset: 2px; }
    @media (max-width: 680px) {
      .lp-books { display: block; }
      .lp-books-label { display: block; margin-bottom: 0.5rem; }
      .lp-books ol { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 0.3125rem; }
      .lp-books a { width: 100%; min-width: 0; height: 2.5rem; font-size: 0.9375rem; }
    }
    .lp-related { margin: 1.5rem 0 0; font: 500 0.9375rem/1.4 var(--font-ui); color: var(--hero-ink-soft); }
    .lp-related a { color: var(--hero-ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--hero-accent); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
    .lp-related a:hover { color: var(--hero-accent); }
    .lp-hero-art {
      position: absolute;
      right: var(--space-5);
      bottom: 0;
      width: min(44%, 36rem);
      height: 78%;
      background: var(--hero-accent);
      opacity: 0.5;
      -webkit-mask: var(--art) right bottom / contain no-repeat;
      mask: var(--art) right bottom / contain no-repeat;
      z-index: -1;
    }
    @media (prefers-reduced-motion: reduce) { .lp-btn { transition: none; } }

    .lp-body { padding-top: var(--space-6); }
    .lp-desc { max-width: 46rem; font-size: var(--step-1); line-height: 1.55; color: var(--text-mid); text-wrap: pretty; }
    h2.lp-h { font-family: var(--font-display); font-size: var(--step-3); font-weight: 400; line-height: 1.1; letter-spacing: -0.015em; color: var(--text); margin: var(--space-7) 0 var(--space-5); padding-top: var(--space-6); border-top: 1px solid var(--border); }
    h2.lp-h .draft-badge { font-size: var(--step--2); letter-spacing: 0.12em; padding: 0.15em 0.5em; margin-left: 0.5rem; vertical-align: 0.3em; }
    h2.lp-h.is-first { margin-top: var(--space-6); }
    /* Dramatis personae — each speaker in the hue the reader gives their name.
       data-spk resolves to one of the shared --spk-* palette vars (global.css). */
    .cast-list { list-style: none; margin: 0.2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.55rem 1.1rem; }
    .cast-item { display: inline-flex; align-items: baseline; gap: 0.5rem; font-size: 1rem; }
    .cast-swatch { width: 0.62rem; height: 0.62rem; border-radius: 50%; flex-shrink: 0; align-self: center; background: var(--c, var(--text-mid)); }
    .cast-name { font-weight: 600; color: var(--c, var(--text)); }
    .cast-abbr { font-family: var(--font-ui); font-size: 0.78rem; color: var(--text-light); letter-spacing: 0.02em; }
    .cast-item[data-spk="0"] { --c: var(--spk-0); }
    .cast-item[data-spk="1"] { --c: var(--spk-1); }
    .cast-item[data-spk="2"] { --c: var(--spk-2); }
    .cast-item[data-spk="3"] { --c: var(--spk-3); }
    .cast-item[data-spk="4"] { --c: var(--spk-4); }
    .cast-item[data-spk="5"] { --c: var(--spk-5); }
    .cast-item[data-spk="6"] { --c: var(--spk-6); }
    .cast-item[data-spk="7"] { --c: var(--spk-7); }

    .ed-list, .book-list, .read-list { list-style: none; padding: 0; margin: 0; }
    /* The translations as doors, like the home page's three ways in: a rule,
       a name, a line of credit set flush left so nothing strands on a wrap. */
    .ed-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--space-5) var(--space-6); }
    .ed-list a { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--text); padding: var(--space-4) 0 var(--space-3); border-top: 2px solid var(--text); transition: border-color .15s ease; }
    .ed-list a:hover { border-top-color: var(--accent); }
    .ed-list a:hover .ed-name { color: var(--accent); }
    .ed-name { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.01em; }
    .ed-kind { margin-top: 0.5rem; font-size: 1.0625rem; line-height: 1.45; color: var(--text-mid); text-wrap: pretty; }
    .ed-go { margin-top: auto; padding-top: var(--space-4); font: 600 0.9375rem/1.2 var(--font-ui); color: var(--accent); }
    /* Commentary card: same full width / border as an edition row, but a richer
       column layout (title, blurb, call-to-action). */
    .comm-card { gap: 0.45rem; }
    .comm-title { font-family: var(--font-ui); font-weight: 700; font-size: 1rem; color: var(--text); }
    .comm-greek { font-weight: 500; color: var(--text-mid); }
    .comm-blurb { font-size: 1rem; line-height: 1.5; color: var(--text-mid); }
    .comm-cta { display: inline-flex; align-items: center; align-self: flex-start; gap: 0.4rem; margin-top: 0.2rem; font-family: var(--font-ui); font-weight: 600; font-size: 0.875rem; color: var(--on-accent); background: var(--accent); border: 1px solid var(--accent); border-radius: var(--radius-pill); padding: 0.5rem 1rem; }

    /* Contents: two columns of books, each with its line count, its argument
       in full and Flaxman's plate. */
    .book-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-7); }
    .book-list a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem var(--space-5); align-content: start; height: 100%; text-decoration: none; color: var(--text); padding: var(--space-4) 0 var(--space-5); border-top: 1px solid var(--border); }
    .book-list a:hover { border-top-color: var(--accent); }
    .book-list a:hover .bl-label { color: var(--accent); }
    .bl-head { grid-column: 1; display: flex; align-items: baseline; gap: 0.75rem; }
    .bl-label { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.01em; }
    .bl-meta { font: 500 var(--step--1)/1 var(--font-ui); color: var(--text-mid); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .bl-argument { grid-column: 1; color: var(--text-mid); font-size: 1.0625rem; line-height: 1.5; text-wrap: pretty; }
    .bl-art { grid-column: 2; grid-row: 1 / span 2; align-self: start; width: 9.5rem; height: 5.75rem; object-fit: contain; object-position: right top; opacity: 0.78; }
    /* Some plates carry a white ground; blending drops it into the page in
       both themes. */
    .bl-art { mix-blend-mode: multiply; }
    :global(html[data-theme="dark"]) .bl-art { filter: invert(1); opacity: 0.7; mix-blend-mode: screen; }
    .credits { max-width: 52rem; font-size: 1.0625rem; line-height: 1.65; color: var(--text-mid); }
    .credits strong { color: var(--text); }
    .credits a { color: var(--accent); }
    .read-list li { margin: 0 0 0.7rem; font-size: 1rem; line-height: 1.55; color: var(--text-mid); }
    .read-list .rk { font-family: var(--font-ui); font-size: 0.6875rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-mid); background: var(--border); border-radius: 3px; padding: 0.08em 0.45em; margin-right: 0.45em; vertical-align: 0.08em; }
    .read-list a.buy { color: var(--accent); white-space: nowrap; }
    .read-list a.res-link { font-family: var(--font-ui); font-size: 0.98rem; font-weight: 700; color: var(--accent); }
    .lp-note { font-size: 0.875rem; color: var(--text-mid); margin-top: 0.8rem; }
    /* The shared support card, set a size up to sit with this page's type. */
    .lp-support { margin-top: var(--space-7); max-width: 46rem; padding: var(--space-5); border-radius: var(--radius-2); }
    .lp-support.support-card .eyebrow { font-size: 0.75rem; color: var(--text-mid); }
    .lp-support.support-card .eyebrow .gk { font-size: 1.0625rem; }
    .lp-support.support-card h2 { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); letter-spacing: -0.01em; margin: 0.5rem 0; }
    .lp-support.support-card p { font-size: 1.0625rem; line-height: 1.55; margin: 0 0 var(--space-4); }
    .lp-support .btn-donate { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.25rem; border-radius: var(--radius-pill); font-size: 0.9375rem; letter-spacing: 0; }
    @media (max-width: 900px) {
      .lp-hero-inner { padding-left: var(--space-4); padding-right: var(--space-4); }
      .lp-hero-art { width: 52%; height: 46%; opacity: 0.28; right: 0; }
      .book-list { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 560px) {
      .lp-hero-art { display: none; }
      .lp-title { font-size: clamp(3.25rem, 17vw, 4.25rem); }
      .lp-cta-row { gap: 0.5rem; }
      .lp-btn { padding: 0 1.125rem; }
      .bl-art { width: 6.25rem; height: 4rem; }
      .book-list a { gap: 0.25rem var(--space-4); }
      h2.lp-h { font-size: 1.75rem; margin-top: var(--space-6); padding-top: var(--space-5); margin-bottom: var(--space-4); }
    }
  </style>
  <Pwa />
</head>
<body data-work={workId}>
  <SiteHeader work={workId} />

  <main>
    <section class="lp-hero">
      <div class="lp-hero-inner">
        <div class="lp-hero-text">
          <p class="lp-eyebrow">{work.author} · {work.abbr}{heroGreek && <span class="lp-eyebrow-gk" lang="grc" aria-hidden="true">{heroGreek}</span>}</p>
          <h1 class="lp-title">{work.title}</h1>
          {work.authenticity && work.authenticity !== 'genuine' && (
            <p class="lp-status">
              <span class="status-tag">{AUTHENTICITY_LABEL[work.authenticity]}</span>
              <span class="lp-status-note">Authorship traditionally doubted — transmitted with {work.author}’s works but widely judged not to be by {work.author}.</span>
            </p>
          )}
          {work.greekTitle && <p class="lp-greek" lang="grc">{work.greekTitle}</p>}
          {work.period && (
            <p class="lp-period">Traditionally dated to {work.author}’s {work.period} period.</p>
          )}
          <p class="lp-lede">{work.blurb}</p>

          <div class="lp-cta-row">
            <a class="lp-btn primary" href={primary ? readHref(`?trans=${primary.id}`) : readHref()}>
              Start reading →
            </a>
            <a class="lp-btn resume-btn" id="lp-resume" href="#" hidden
               data-work={workId} data-books={work.books}>Resume</a>
            <a class="lp-btn" href={readHref('?view=greek')}>Greek only</a>
            {editions.length > 1 && <a class="lp-btn" href={readHref('?trans=compare')}>Compare translations</a>}
          </div>

          {!bookless && work.books > 1 && (
            <nav class="lp-books" aria-label={`Books of the ${work.title}`}>
              <span class="lp-books-label" aria-hidden="true">Book</span>
              <ol>
                {outline.map((b) => (
                  <li><a href={`${base}${workPath(workId, b.book)}`} aria-label={`Book ${b.label}`}>{b.label}</a></li>
                ))}
              </ol>
            </nav>
          )}

          {work.related && work.related.length > 0 && (
            <p class="lp-related">
              See also: {work.related.map((r, i) => {
                const rw = getWork(r.id);
                return rw ? (
                  <>
                    {i > 0 && <span> · </span>}
                    <a href={`${base}${workLanding(r.id)}`}>{r.label}</a>
                  </>
                ) : null;
              })}
            </p>
          )}
        </div>
        {heroArt && <span class="lp-hero-art" aria-hidden="true" style={`--art:url('${heroArt}')`}></span>}
      </div>
    </section>

    <div class="pg lp-body">
    <p class="lp-desc">
      This edition presents the original Greek ({work.greekSource.short}) side by
      side with {translatorNames.length > 1 ? 'English translations' : 'an English translation'}
      {translatorNames.length ? ` (${translatorNames.join(', ')})` : ''} —
      with click-to-parse morphology, dictionary entries, and exact
      {' ' + citeWord} citation.
      {/* A verse work has no chapters: the count clause is dropped, not shown as "0 chapters". */}
      {bookless
        ? ` ${totalChapters} ${stephanus ? 'page' : 'chapter'}${totalChapters === 1 ? '' : 's'}.`
        : totalChapters > 0
          ? ` ${work.books} books, ${totalChapters} ${stephanus ? 'page' : 'chapter'}${totalChapters === 1 ? '' : 's'}.`
          : ` ${work.books} books.`}
    </p>

    {cast.length > 1 && (
      <section class="lp-cast" aria-label="Speakers in this dialogue">
        <h2 class="lp-h">Speakers</h2>
        <ul class="cast-list">
          {cast.map((m) => (
            <li class="cast-item" data-spk={m.slot}>
              <span class="cast-swatch" aria-hidden="true"></span>
              <span class="cast-name">{m.name}</span>
              {m.abbr !== m.name && <span class="cast-abbr">{m.abbr}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <h2 class="lp-h is-first">Read this work</h2>
    <ul class="ed-list">
      {editions.map((t) => (
        <li>
          <a href={readHref(`?trans=${t.id}`)}>
            <span class="ed-name">{t.short}</span>
            <span class="ed-kind">Greek &amp; English · {t.name}</span>
          </a>
        </li>
      ))}
    </ul>

    {!bookless && (
      <>
        <h2 class="lp-h">Books {hasDraftArgument && <span class="draft-badge" title="Book summaries are AI-drafted apparatus, pending review">Draft</span>}</h2>
        <ul class="book-list">
          {outline.map((b) => {
            const plate = verseLine ? plateFor(b.book) : undefined;
            return (
            <li>
              <a
                href={`${base}${workPath(workId, b.book)}`}
                class={verseLine && bookApparatus[b.book - 1]?.argument ? 'has-argument' : undefined}
              >
                <span class="bl-head">
                  <span class="bl-label">Book {b.label}</span>
                  <span class="bl-meta">{bookSpan(b)}</span>
                </span>
                {verseLine && bookApparatus[b.book - 1]?.argument && (
                  <span class="bl-argument">{bookApparatus[b.book - 1].argument}</span>
                )}
                {plate && <img class="bl-art" src={plateSrc(plate)} alt="" title={plate.caption} loading="lazy" decoding="async" />}
              </a>
            </li>
            );
          })}
        </ul>
      </>
    )}

    {commentaries.length > 0 && (
      <>
        <h2 class="lp-h">Commentary</h2>
        <ul class="ed-list">
          {commentaries.map((c) => (
            <li>
              <a class="comm-card" href={`${base}${workLanding(c.id)}`}>
                <span class="comm-title">{c.author} — {c.title}{c.greekTitle && <span class="comm-greek"> · {c.greekTitle}</span>}</span>
                <span class="comm-blurb">{c.blurb}</span>
                <span class="comm-cta">Read the {c.title} →</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    <h2 class="lp-h">Greek text &amp; translations</h2>
    <p class="credits">
      <strong>Greek:</strong> {work.greekSource.full}<br />
      <strong>{translatorNames.length > 1 ? 'Translations' : 'Translation'}:</strong>
      {' '}{editions.map((t) => t.name).join('; ')}.<br />
      Full source and licence details are on the
      <a href={`${base}/attribution`}>Texts &amp; Licences</a> page.
    </p>

    {reading.length > 0 && (
      <>
        <h2 class="lp-h">In print</h2>
        {(readingTrans.length > 0 || readingComm.length > 0) && (
          <>
            <p class="credits" style="margin-bottom:0.8rem;">
              Modern, copyright-protected translations and commentaries we can’t
              host here, for readers who want to go further:
            </p>
            <ul class="read-list">
              {readingTrans.map((r) => (
                <li>
                  <span class="rk">Translation</span><span set:html={sanitizeHtml(r.cite)} />{' '}
                  <a class="buy" href={inPrintHref(r)} target="_blank" rel="noopener nofollow">Find in print →</a>
                </li>
              ))}
              {readingComm.map((r) => (
                <li>
                  <span class="rk">Commentary</span><span set:html={sanitizeHtml(r.cite)} />{' '}
                  <a class="buy" href={inPrintHref(r)} target="_blank" rel="noopener nofollow">Find in print →</a>
                </li>
              ))}
            </ul>
          </>
        )}
        {readingColl.length > 0 && (
          <>
            <p class="credits" style="margin:1rem 0 0.8rem;">
              Prefer a paper copy? These in-print editions carry the translation
              read here (or a revision of it):
            </p>
            <ul class="read-list">
              {readingColl.map((r) => (
                <li>
                  <span class="rk">In print</span><span set:html={sanitizeHtml(r.cite)} />{' '}
                  <a class="buy" href={inPrintHref(r)} target="_blank" rel="noopener nofollow">Find in print →</a>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="lp-note">“Find in print” opens a Google Books search for the edition.</p>
      </>
    )}

    {resources.length > 0 && (
      <>
        <h2 class="lp-h">Resources</h2>
        <ul class="read-list">
          {resources.map((r) => (
            <li>
              <a class="res-link" href={r.url} target="_blank" rel="noopener">{r.label}</a>
              {' — '}{r.blurb}
              {r.exercises && <> See {r.exercises}, relevant to this work.</>}
              {' '}Developed by{' '}
              <a class="buy" href={r.authorUrl} target="_blank" rel="noopener">{r.authorName}</a>.
            </li>
          ))}
        </ul>
      </>
    )}

    <section class="support-card lp-support">
      <div class="eyebrow">Support <span class="gk">χάρις</span></div>
      <h2>Support the Homer Reader</h2>
      <p>The reader is free and open. A contribution helps defray development costs and keeps it that way.</p>
      <a class="btn-donate" href={SUPPORT_URL} target="_blank" rel="noopener">Make a gift</a>
    </section>
    </div>
  </main>

  <footer class="site-footer">
    <span>Greek text: {work.greekSource.short} ({work.greekSource.licence})</span>
    <span class="footer-sep" aria-hidden="true">·</span>
    <span>Translations: public domain (Murray, Butler, Pope)</span>
    <span class="footer-sep" aria-hidden="true">·</span>
    <a href={`${base}/attribution`}>Texts &amp; Licences</a>
  </footer>
<script>
  // "Resume" CTA: appears when the reader has a saved position for this work
  // (localStorage — see shared/lib/resume.ts), linking to the remembered
  // book + Bekker citation.
  import { resumeFor } from '@shared/lib/resume';

  const btn = document.getElementById('lp-resume') as HTMLAnchorElement | null;
  if (btn) {
    const pos = resumeFor(btn.dataset.work!);
    if (pos) {
      const books = Number(btn.dataset.books) || 1;
      const book = Math.min(Math.max(1, pos.book), books);
      const base = (import.meta.env.BASE_URL as string).replace(/\/$/, '');
      btn.href = `${base}/${btn.dataset.work}/book/${book}${pos.cite ? `#${pos.cite}` : ''}`;
      btn.textContent = pos.cite ? `Resume at ${pos.cite}` : (books > 1 ? `Resume Book ${book}` : 'Resume');
      btn.hidden = false;
    }
  }
</script>
</body>
</html>
