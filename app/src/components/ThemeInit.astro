---
// No-flash theme setup. Runs in <head> before paint so the page renders in the
// correct theme immediately. Honours a saved choice, else defaults to light
// (the parchment reader) regardless of the OS appearance setting.
//
// Also the one place every page's <head> shares, so the self-hosted type lives
// here too: the @font-face rules (built off BASE_URL, never a hardcoded path)
// and a preload for the files a page's first screen paints with. All faces
// are SIL OFL 1.1, subset from the upstream files (licences beside them in
// public/fonts): Gentium Book Plus carries the Greek and the English reading
// text, Newsreader (72pt optical cut) the display lines. The controls use the
// system UI face (--font-ui in global.css), so they download nothing.
//
// Each Latin face is cut in two by unicode-range (round 4): a core file
// (ASCII, the punctuation running text uses, and the elision mark U+02BC that
// the Greek line takes from this face) and an ext file (accented letters,
// Latin Extended-A, combining marks), cut from the same shipped files, so the
// glyphs are the ones the site always drew. Most pages never touch ext, so
// they skip a third of every face; a page that sets an accented name fetches
// it then.
// Props: greek={false} on a page with no Greek, so the Greek face is not
// preloaded for nothing (it still loads, by unicode-range, if a Greek word
// ever renders); greek="caps" on a page whose only Greek is a poem's name in
// capitals (ΙΛΙΑΣ), which then fetches a 3 KB capitals file, the full Greek
// file still declared for any other Greek letter. italic on a page whose first
// screen sets italic, so that face is in hand before the first paint rather
// than swapped in (a reflow, CLS).
interface Props { greek?: boolean | 'caps'; italic?: boolean }
const { greek = true, italic = false } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const f = (name: string) => `${base}/fonts/${name}.woff2`;
const LATIN_CORE = 'U+0020-007E,U+00A0,U+00A7,U+00A9,U+00AB,U+00B0,U+00B7,U+00BB,U+00D7,U+02BB-02BC,U+2002-200A,U+2010-2015,U+2018-201A,U+201C-201E,U+2020-2022,U+2026,U+2030,U+2032-2033,U+2039-203A,U+2044,U+2122,U+2212';
const LATIN_EXT = 'U+00A1-00A6,U+00A8,U+00AA,U+00AC-00AF,U+00B1-00B6,U+00B8-00BA,U+00BC-00D6,U+00D8-017F,U+02C6,U+02DA,U+02DC,U+0300-0304,U+0306,U+0308,U+20AC';
// Newsreader carries only its file's own characters: the ranges are that
// file's cmap, split the same way.
const NEWS_CORE = 'U+0020-007E,U+00A0,U+00A7,U+00A9,U+00AB,U+00B0,U+00B7,U+00BB,U+00D7,U+2013-2014,U+2018-201A,U+201C-201E,U+2026,U+2032-2033,U+2039-203A,U+2212';
const NEWS_EXT = 'U+00A1-00A6,U+00A8,U+00AA,U+00AC-00AF,U+00B1-00B6,U+00B8-00BA,U+00BC-00D6,U+00D8-00FF,U+0131,U+0152-0153,U+02C6,U+02DC';
const GREEK = 'U+0370-03FF,U+1F00-1FFF';
const GREEK_CAPS = 'U+0391-03A1,U+03A3-03A9';
const GREEK_NOT_CAPS = 'U+0370-0390,U+03A2,U+03AA-03FF,U+1F00-1FFF';
const face = (family: string, file: string, weight: string, style: string, range: string) =>
  `@font-face{font-family:"${family}";src:url("${f(file)}") format("woff2");font-weight:${weight};font-style:${style};font-display:swap;unicode-range:${range};}`;
const gentium = (file: string, weight: string, style: string) => [
  face('Gentium Book Plus', `${file}-latin-core`, weight, style, LATIN_CORE),
  face('Gentium Book Plus', `${file}-latin-ext`, weight, style, LATIN_EXT),
];
const fontCss = [
  ...gentium('gentium-book-plus-400', '400', 'normal'),
  ...(greek === 'caps'
    ? [face('Gentium Book Plus', 'gentium-book-plus-400-greek-caps', '400', 'normal', GREEK_CAPS),
       face('Gentium Book Plus', 'gentium-book-plus-400-greek', '400', 'normal', GREEK_NOT_CAPS)]
    : [face('Gentium Book Plus', 'gentium-book-plus-400-greek', '400', 'normal', GREEK)]),
  ...gentium('gentium-book-plus-400i', '400', 'italic'),
  face('Gentium Book Plus', 'gentium-book-plus-400i-greek', '400', 'italic', GREEK),
  ...gentium('gentium-book-plus-700', '700', 'normal'),
  face('Gentium Book Plus', 'gentium-book-plus-700-greek', '700', 'normal', GREEK),
  face('Newsreader Display', 'newsreader-display-core', '300 700', 'normal', NEWS_CORE),
  face('Newsreader Display', 'newsreader-display-ext', '300 700', 'normal', NEWS_EXT),
].join('');
const preload = [
  'gentium-book-plus-400-latin-core',
  ...(greek === 'caps' ? ['gentium-book-plus-400-greek-caps'] : greek ? ['gentium-book-plus-400-greek'] : []),
  ...(italic ? ['gentium-book-plus-400i-latin-core'] : []),
  'newsreader-display-core',
];
---
{preload.map((name) => (
  <link rel="preload" as="font" type="font/woff2" href={f(name)} crossorigin />
))}
<style is:inline set:html={fontCss}></style>
<script is:inline>
  (function () {
    var theme = 'light';
    try {
      if (localStorage.getItem('ne-theme') === 'dark') theme = 'dark';
    } catch (e) {
      /* localStorage blocked: keep the light default, and still stamp it so a
         dark OS never lands in the no-data-theme state. */
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>
