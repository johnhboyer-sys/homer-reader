---
// No-flash theme setup. Runs in <head> before paint so the page renders in the
// correct theme immediately. Honours a saved choice, else defaults to light
// (the parchment reader) regardless of the OS appearance setting.
---
<script is:inline>
  (function () {
    var theme = 'light';
    try {
      if (localStorage.getItem('ne-theme') === 'dark') theme = 'dark';
    } catch (e) {
      /* localStorage blocked: keep the light default, and still stamp it so a
         dark OS never lands in the no-data-theme state. */
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>
