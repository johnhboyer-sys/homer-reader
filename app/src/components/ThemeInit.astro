---
// No-flash theme setup. Runs in <head> before paint so the page renders in the
// correct theme immediately. Honours a saved choice, else defaults to light
// (the parchment reader) regardless of the OS appearance setting.
//
// Also the one place every page's <head> shares, so the self-hosted type lives
// here too: the @font-face rules (built off BASE_URL, never a hardcoded path)
// and a preload for the four files every page paints with. All faces are SIL
// OFL 1.1, subset from the upstream files (licences beside them in
// public/fonts): Gentium Book Plus carries the Greek and the English reading
// text, Newsreader (72pt optical cut) the display lines, Inter the controls.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const f = (name: string) => `${base}/fonts/${name}.woff2`;
const LATIN = 'U+0020-007E,U+00A0-017F,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0300-0304,U+0306,U+0308,U+2002-200A,U+2010-2015,U+2018-201A,U+201C-201E,U+2020-2022,U+2026,U+2030,U+2032-2033,U+2039-203A,U+2044,U+20AC,U+2122,U+2212';
const GREEK = 'U+0370-03FF,U+1F00-1FFF';
const face = (family: string, file: string, weight: string, style: string, range?: string) =>
  `@font-face{font-family:"${family}";src:url("${f(file)}") format("woff2");font-weight:${weight};font-style:${style};font-display:swap;${range ? `unicode-range:${range};` : ''}}`;
const fontCss = [
  face('Gentium Book Plus', 'gentium-book-plus-400-latin', '400', 'normal', LATIN),
  face('Gentium Book Plus', 'gentium-book-plus-400-greek', '400', 'normal', GREEK),
  face('Gentium Book Plus', 'gentium-book-plus-400i-latin', '400', 'italic', LATIN),
  face('Gentium Book Plus', 'gentium-book-plus-400i-greek', '400', 'italic', GREEK),
  face('Gentium Book Plus', 'gentium-book-plus-700-latin', '700', 'normal', LATIN),
  face('Gentium Book Plus', 'gentium-book-plus-700-greek', '700', 'normal', GREEK),
  face('Newsreader Display', 'newsreader-display', '300 700', 'normal'),
  face('Inter', 'inter-ui', '400 700', 'normal'),
].join('');
const preload = ['gentium-book-plus-400-latin', 'gentium-book-plus-400-greek', 'newsreader-display', 'inter-ui'];
---
{preload.map((name) => (
  <link rel="preload" as="font" type="font/woff2" href={f(name)} crossorigin />
))}
<style is:inline set:html={fontCss}></style>
<script is:inline>
  (function () {
    var theme = 'light';
    try {
      if (localStorage.getItem('ne-theme') === 'dark') theme = 'dark';
    } catch (e) {
      /* localStorage blocked: keep the light default, and still stamp it so a
         dark OS never lands in the no-data-theme state. */
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>
